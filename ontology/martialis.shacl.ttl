martialis:HistoricityAssertionShape
        rdf:type              sh:NodeShape;
        rdfs:comment          "A sourced claim about whether the subject existed as one historical individual: historical, legendary, composite, or a title. Recorded only when a source questions it. It does not cap the confidence of other claims about the subject.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#HistoricityAssertionShape/ignoredProperties>;
