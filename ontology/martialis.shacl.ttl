        sh:description  "Archival repository holding this item (e.g. 'National Diet Library'). CSL 'archive'.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        25;
        sh:path         martialis:archive .

<https://w3id.org/martialis/ontology#SourceShape/alternateName>
        sh:datatype  xsd:string;
        sh:maxCount  1;
        sh:nodeKind  sh:Literal;
        sh:order     3;
        sh:path      sdo:alternateName .

<https://w3id.org/martialis/ontology#SourceShape/accessed>
        sh:datatype     xsd:string;
        sh:description  "When the curator consulted this source (CSL 'accessed').";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        11;
        sh:path         martialis:accessed;
        sh:pattern      "^(?:(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?|(?:(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?|\\.\\.|unknown)/(?:(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?|\\.\\.|unknown)|\\[(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?(?:,(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?)+\\])$" .

martialis:SourceAssertionRelationShape
        rdf:type              sh:NodeShape;
        rdfs:comment          "One evidence record: a Source plus the curator's reading of it, which says whether the Source supports the claim and how.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#SourceAssertionRelationShape/ignoredProperties>;
        sh:property           <https://w3id.org/martialis/ontology#SourceAssertionRelationShape/url> , <https://w3id.org/martialis/ontology#SourceAssertionRelationShape/supports> , <https://w3id.org/martialis/ontology#SourceAssertionRelationShape/sourceLocatorLabel> , <https://w3id.org/martialis/ontology#SourceAssertionRelationShape/sourceLocation> , <https://w3id.org/martialis/ontology#SourceAssertionRelationShape/quotation> , <https://w3id.org/martialis/ontology#SourceAssertionRelationShape/informationType> , <https://w3id.org/martialis/ontology#SourceAssertionRelationShape/evidenceType> , <https://w3id.org/martialis/ontology#SourceAssertionRelationShape/citation> , <https://w3id.org/martialis/ontology#SourceAssertionRelationShape/basedOnSource> , <https://w3id.org/martialis/ontology#SourceAssertionRelationShape/archivedAt>;
        sh:targetClass        martialis:SourceAssertionRelation .

<https://w3id.org/martialis/ontology#SourceAssertionRelationShape/url>
        sh:maxCount  1;
        sh:nodeKind  sh:IRI;
        sh:order     1;
        sh:path      sdo:url .

<https://w3id.org/martialis/ontology#SourceAssertionRelationShape/supports>
        sh:datatype     xsd:boolean;
        sh:description  "Whether the source supports or contradicts the assertion (true/false).";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        8;
        sh:path         martialis:supports .

