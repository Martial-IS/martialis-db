<https://w3id.org/martialis/ontology#SourceShape/sourceClassification>
        sh:description  "The Source's form relative to the record it carries (Mills): original, derivative or authored. Set once on the Source.";
        sh:in           <https://w3id.org/martialis/ontology#SourceShape/sourceClassification/in>;
        sh:maxCount     1;
        sh:order        14;
        sh:path         martialis:sourceClassification .

<https://w3id.org/martialis/ontology#SourceShape/sourceClassification/in>
        rdf:first  srcclass:authored;
        rdf:rest   <https://w3id.org/martialis/ontology#SourceShape/sourceClassification/in/1> .

