        sh:order        0;
        sh:path         martialis:transmissionDocument .

<https://w3id.org/martialis/ontology#DocumentTransmissionAssertionShape/researchNote>
        sh:datatype     xsd:string;
        sh:description  "A curatorial note recording what is known, suspected, or still to be investigated about a record. Addressed to a maintainer, not a reader (YAML: notes).";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        5;
        sh:path         martialis:researchNote .

<https://w3id.org/martialis/ontology#DocumentTransmissionAssertionShape/ignoredProperties>
