<https://w3id.org/martialis/ontology#SourceShape/archiveDate>
        sh:datatype     xsd:string;
        sh:description  "Snapshot date of archiveUrl. Distinct from schema:archivedAt, which carries the archiveUrl IRI itself, not a date.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        12;
        sh:path         martialis:archiveDate;
        sh:pattern      "^(?:(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?|(?:(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?|\\.\\.|unknown)/(?:(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?|\\.\\.|unknown)|\\[(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?(?:,(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?)+\\])$" .

<https://w3id.org/martialis/ontology#SourceShape/archiveCollection>
        sh:datatype     xsd:string;
        sh:description  "Collection within the archive that holds this item. CSL 'archive_collection'.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        26;
        sh:path         martialis:archiveCollection .

<https://w3id.org/martialis/ontology#SourceShape/archive>
