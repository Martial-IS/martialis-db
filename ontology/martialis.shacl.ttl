        rdf:first  srcclass:original;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#SourceShape/sourceClassification/in/1>
        rdf:first  srcclass:derivative;
        rdf:rest   <https://w3id.org/martialis/ontology#SourceShape/sourceClassification/in/2> .

<https://w3id.org/martialis/ontology#SourceShape/selfPublished>
        sh:datatype     xsd:boolean;
        sh:description  "Whether the publisher and the contributor(s) are the same party. Preferably derived from the linked entities rather than asserted.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        17;
        sh:path         martialis:selfPublished .

<https://w3id.org/martialis/ontology#SourceShape/section>
        sh:datatype     xsd:string;
        sh:description  "Section of the container in which this item appears (e.g. a newspaper section). CSL 'section'.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        24;
        sh:path         martialis:section .

<https://w3id.org/martialis/ontology#SourceShape/sameAs>
        sh:description  "The Wikidata item that IS this source, place reference or nationality, as a wd: CURIE. A source has one only when it is a work with its own item (a book, a periodical); a Wikipedia article has none, and the item of its subject is not its identity. An entity record lists its identity links, Wikidata among them, in sameAs.";
        sh:maxCount     1;
        sh:nodeKind     sh:IRI;
        sh:order        38;
        sh:path         sdo:sameAs .

<https://w3id.org/martialis/ontology#SourceShape/researchNote>
        sh:datatype     xsd:string;
        sh:description  "A curatorial note recording what is known, suspected, or still to be investigated about a record. Addressed to a maintainer, not a reader (YAML: notes).";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        45;
        sh:path         martialis:researchNote .

<https://w3id.org/martialis/ontology#SourceShape/publisher>
        sh:class     martialis:Publisher;
        sh:maxCount  1;
        sh:nodeKind  sh:BlankNodeOrIRI;
        sh:order     7;
        sh:path      sdo:publisher .

<https://w3id.org/martialis/ontology#SourceShape/primaryImage>
        sh:class        martialis:Photo;
        sh:description  "The single primary depiction of an entity. The multivalued photos gallery uses schema:image; a single-valued slot cannot share that IRI without its maxCount 1 shape firing on the gallery.";
        sh:maxCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        31;
        sh:path         martialis:primaryImage .

<https://w3id.org/martialis/ontology#SourceShape/pmid>
        sh:datatype     xsd:string;
        sh:description  "PubMed identifier (CSL 'PMID').";
        sh:maxCount     1;
