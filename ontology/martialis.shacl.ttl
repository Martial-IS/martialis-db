martialis:DissolutionEventShape
        rdf:type              sh:NodeShape;
        rdfs:comment          "The end of a place, organization, style or ranking system: its date, place, manner, reason and evidence.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#DissolutionEventShape/ignoredProperties>;
        sh:property           <https://w3id.org/martialis/ontology#DissolutionEventShape/location> , <https://w3id.org/martialis/ontology#DissolutionEventShape/hasEvidence> , <https://w3id.org/martialis/ontology#DissolutionEventShape/eventPlace> , <https://w3id.org/martialis/ontology#DissolutionEventShape/endDate> , <https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionReason> , <https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionManner> , <https://w3id.org/martialis/ontology#DissolutionEventShape/dateOriginal> , <https://w3id.org/martialis/ontology#DissolutionEventShape/dateCalendar> , <https://w3id.org/martialis/ontology#DissolutionEventShape/atEvent>;
        sh:targetClass        martialis:DissolutionEvent .

<https://w3id.org/martialis/ontology#DissolutionEventShape/location>
        sh:class        martialis:GeoRef;
        sh:description  "An embedded place reference (free-text label, country code, optional authority IRI and point), not a Place entity. Carried by Site (where a Place or Organization is) and by Event and the life events (where something happened); a Place or Organization has no location of its own. The specific Place an event happened at is martialis:eventPlace; keeping the two on separate predicates keeps a Place entity and a GeoRef apart.";
        sh:maxCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        4;
        sh:path         sdo:location .

<https://w3id.org/martialis/ontology#DissolutionEventShape/ignoredProperties>
        rdf:first  rdf:type;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#DissolutionEventShape/hasEvidence>
        sh:class        martialis:SourceAssertionRelation;
        sh:description  "Links an entity (assertion, interaction, life event, or top-level entity) to its evidence records.";
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        8;
        sh:path         martialis:hasEvidence .

<https://w3id.org/martialis/ontology#DissolutionEventShape/eventPlace>
        sh:class        martialis:Place;
        sh:description  "The Place an Event, FoundingEvent or DissolutionEvent happened at. Narrower than schema:location, but mapped to it rather than a sub-property of it: on these classes schema:location holds only the GeoRef of the location slot.";
        sh:maxCount     1;
        sh:nodeKind     sh:IRI;
        sh:order        3;
        sh:path         martialis:eventPlace .

<https://w3id.org/martialis/ontology#DissolutionEventShape/endDate>
        sh:datatype  xsd:string;
        sh:maxCount  1;
        sh:nodeKind  sh:Literal;
        sh:order     0;
        sh:path      sdo:endDate;
        sh:pattern   "^(?:(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?|(?:(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?|\\.\\.|unknown)/(?:(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?|\\.\\.|unknown)|\\[(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?(?:,(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?)+\\])$" .

<https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionReason>
        sh:datatype     xsd:string;
        sh:description  "Free-text detail of how and why the entity ended that no closed vocabulary carries: a decree number, an occupation order, the terms of a unification.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        7;
        sh:path         martialis:dissolutionReason .

<https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionManner>
        sh:description  "Organization-only. How the organization ended: merged, split, superseded, suppressed, renamed, defunct, or unknown.";
        sh:in           <https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionManner/in>;
        sh:maxCount     1;
        sh:order        6;
        sh:path         martialis:dissolutionManner .

<https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionManner/in>
        rdf:first  dissmanner:defunct;
        rdf:rest   <https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionManner/in/1> .

<https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionManner/in/6>
        rdf:first  dissmanner:unknown;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionManner/in/5>
        rdf:first  dissmanner:suppressed;
        rdf:rest   <https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionManner/in/6> .

<https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionManner/in/4>
        rdf:first  dissmanner:superseded;
        rdf:rest   <https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionManner/in/5> .

<https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionManner/in/3>
        rdf:first  dissmanner:split;
        rdf:rest   <https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionManner/in/4> .

<https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionManner/in/2>
        rdf:first  dissmanner:renamed;
        rdf:rest   <https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionManner/in/3> .

<https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionManner/in/1>
        rdf:first  dissmanner:merged;
        rdf:rest   <https://w3id.org/martialis/ontology#DissolutionEventShape/dissolutionManner/in/2> .

<https://w3id.org/martialis/ontology#DissolutionEventShape/dateOriginal>
        sh:datatype     xsd:string;
        sh:description  "Free-text date as given by the source, when it differs from the Gregorian-equivalent EDTF value in the paired date property. Paired with martialis:dateCalendar.";
