<https://w3id.org/martialis/ontology#SourceShape/archiveLocation>
        sh:datatype     xsd:string;
        sh:description  "Location of this item within the archive (e.g. box and folder). CSL 'archive_location'.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        27;
