        sh:order     20;
        sh:path      bibo:pages .

<https://w3id.org/martialis/ontology#SourceShape/oclc>
        sh:datatype     xsd:string;
        sh:description  "WorldCat/OCLC control number.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        39;
        sh:path         martialis:oclc .

<https://w3id.org/martialis/ontology#SourceShape/ndl>
        sh:datatype     xsd:string;
        sh:description  "National Diet Library (Japan) identifier.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        41;
        sh:path         martialis:ndl .

<https://w3id.org/martialis/ontology#SourceShape/name>
        sh:datatype     xsd:string;
        sh:description  "A plain, unlocalised title (a Source). Required on every Source except a dated state, which inherits it (enforced in SHACL).";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        2;
        sh:path         sdo:name .

<https://w3id.org/martialis/ontology#SourceShape/lineageTradition>
        sh:datatype     xsd:boolean;
        sh:description  "True when the Source is a lineage or organisation recounting its own past (a school or federation history, a founding story, a genealogy chart, a densho), so it shares one origin with every other account from inside that lineage and cannot corroborate them. Not set on everything a body publishes: its record of its own act (a grade register, a same-day announcement, a current member list) is not tradition. Extends the Mills independence test; orthogonal to martialis:sourceClassification: an original densho is still lineage-internal.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        15;
        sh:path         martialis:lineageTradition .

<https://w3id.org/martialis/ontology#SourceShape/keywords>
        sh:datatype  xsd:string;
        sh:nodeKind  sh:Literal;
        sh:order     46;
        sh:path      sdo:keywords .

<https://w3id.org/martialis/ontology#SourceShape/issue>
        sh:datatype  xsd:string;
        sh:maxCount  1;
        sh:nodeKind  sh:Literal;
        sh:order     19;
