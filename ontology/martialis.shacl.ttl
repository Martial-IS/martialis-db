        rdf:first  affrel:recognised_by;
        rdf:rest   <https://w3id.org/martialis/ontology#AffiliationAssertionShape/affiliationRelation/in/5> .

<https://w3id.org/martialis/ontology#AffiliationAssertionShape/affiliationRelation/in/3>
        rdf:first  affrel:merged_from;
        rdf:rest   <https://w3id.org/martialis/ontology#AffiliationAssertionShape/affiliationRelation/in/4> .

