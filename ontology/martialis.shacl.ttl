        sh:nodeKind     sh:Literal;
        sh:order        37;
        sh:path         martialis:pmcid .

<https://w3id.org/martialis/ontology#SourceShape/peerReview>
        sh:description  "Whether this Source was peer-reviewed before publication. Inherited from its container through partOf (materialized at export time) unless stated on the item. Absent when not established.";
        sh:in           <https://w3id.org/martialis/ontology#SourceShape/peerReview/in>;
        sh:maxCount     1;
        sh:order        16;
        sh:path         martialis:peerReview .

<https://w3id.org/martialis/ontology#SourceShape/peerReview/in>
        rdf:first  peerreview:not_peer_reviewed;
        rdf:rest   <https://w3id.org/martialis/ontology#SourceShape/peerReview/in/1> .

<https://w3id.org/martialis/ontology#SourceShape/peerReview/in/1>
        rdf:first  peerreview:peer_reviewed;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#SourceShape/partOf>
