martialis:TeacherAssertionShape
        rdf:type              sh:NodeShape;
        rdfs:comment          "A claim that a person taught the subject a style. The teacher is martialis:teacher. With no teacher, the claim states that a teacher existed whom no source names: every interaction then needs a Place or Event anchor and a dated period, and no wasTaughtBy/teaches edge is materialized. A claim assessed doubtful or refuted stays a TeacherAssertion and gives no edge either. Evidence attaches to the interactions.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#TeacherAssertionShape/ignoredProperties>;
        sh:property           <https://w3id.org/martialis/ontology#TeacherAssertionShape/teacher> , <https://w3id.org/martialis/ontology#TeacherAssertionShape/role> , <https://w3id.org/martialis/ontology#TeacherAssertionShape/researchNote> , <https://w3id.org/martialis/ontology#TeacherAssertionShape/hasInteraction> , <https://w3id.org/martialis/ontology#TeacherAssertionShape/hasEvidence> , <https://w3id.org/martialis/ontology#TeacherAssertionShape/hasConfidence> , <https://w3id.org/martialis/ontology#TeacherAssertionShape/assertedStyle>;
        sh:targetClass        martialis:TeacherAssertion .

