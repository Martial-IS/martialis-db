<https://w3id.org/martialis/ontology#PhotoShape/mediaRights>
        sh:description  "Copyright or licence status of the media file itself, as one value on a single axis: a Creative Commons licence where one was granted, otherwise a rightsstatements.org statement. Absence means the status has not been evaluated. Distinct from imageAttribution, which credits the item to a source and makes no legal claim, and from informationType and evidenceType, which are epistemic.";
        sh:in           <https://w3id.org/martialis/ontology#PhotoShape/mediaRights/in>;
        sh:maxCount     1;
        sh:order        2;
        sh:path         martialis:mediaRights .

