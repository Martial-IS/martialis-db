        rdf:rest   <https://w3id.org/martialis/ontology#DissolutionEventShape/dateCalendar/in/3> .

<https://w3id.org/martialis/ontology#DissolutionEventShape/dateCalendar/in/1>
        rdf:first  datecal:japanese_nengo;
        rdf:rest   <https://w3id.org/martialis/ontology#DissolutionEventShape/dateCalendar/in/2> .

