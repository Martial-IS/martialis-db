martialis:PlaceShape  rdf:type  sh:NodeShape;
        rdfs:comment          "A training establishment, where training happens: a dojo, club, academy or school programme. It always occupies at least one site, but its identity is the establishment's continuity, not its address, so a move is a new dated site, not a new record. Distinct from any Organization that governs it; its teaching staff are hasInstructorRole and its offices hasOfficerRole.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#PlaceShape/ignoredProperties>;
        sh:property           <https://w3id.org/martialis/ontology#PlaceShape/video> , <https://w3id.org/martialis/ontology#PlaceShape/url> , <https://w3id.org/martialis/ontology#PlaceShape/sameAs> , <https://w3id.org/martialis/ontology#PlaceShape/researchNote> , <https://w3id.org/martialis/ontology#PlaceShape/placeType> , <https://w3id.org/martialis/ontology#PlaceShape/name> , <https://w3id.org/martialis/ontology#PlaceShape/alternateName> , <https://w3id.org/martialis/ontology#PlaceShape/description> , <https://w3id.org/martialis/ontology#PlaceShape/dissolvedEvent> , <https://w3id.org/martialis/ontology#PlaceShape/foundedEvent> , <https://w3id.org/martialis/ontology#PlaceShape/hasAffiliationAssertion> , <https://w3id.org/martialis/ontology#PlaceShape/hasEvidence> , <https://w3id.org/martialis/ontology#PlaceShape/hasInstructorRole> , <https://w3id.org/martialis/ontology#PlaceShape/hasOfficerRole> , <https://w3id.org/martialis/ontology#PlaceShape/hasSite> , <https://w3id.org/martialis/ontology#PlaceShape/image> , <https://w3id.org/martialis/ontology#PlaceShape/keywords> , <https://w3id.org/martialis/ontology#PlaceShape/logo>;
        sh:targetClass        martialis:Place .

<https://w3id.org/martialis/ontology#PlaceShape/video>
        sh:class     martialis:Video;
        sh:nodeKind  sh:BlankNodeOrIRI;
        sh:order     14;
        sh:path      sdo:video .

<https://w3id.org/martialis/ontology#PlaceShape/url>
        sh:maxCount  1;
        sh:nodeKind  sh:IRI;
        sh:order     11;
        sh:path      sdo:url .

<https://w3id.org/martialis/ontology#PlaceShape/sameAs>
        sh:description  "The same entity in an external authority, as a CURIE naming the entity itself (not a web page about it): wd: (Wikidata), dbr: (DBpedia), viaf:, isni:, lcnaf: (Library of Congress names), ndlna: (National Diet Library), orcid:. Nothing else belongs here: a web page, a Wikipedia article or an official site is not an identity.";
        sh:nodeKind     sh:IRI;
        sh:order        19;
        sh:path         sdo:sameAs;
        sh:pattern      "^(http://www\\.wikidata\\.org/entity/Q[1-9][0-9]*|http://dbpedia\\.org/resource/[^\\s]+|http://viaf\\.org/viaf/[1-9][0-9]*|https://isni\\.org/isni/[0-9]{15}[0-9X]|http://id\\.loc\\.gov/authorities/names/n[a-z]?[0-9]+|http://id\\.ndl\\.go\\.jp/auth/ndlna/[0-9]+|https://orcid\\.org/[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X])$" .

