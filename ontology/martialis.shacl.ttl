<https://w3id.org/martialis/ontology#SourceAssertionRelationShape/sourceLocation>
        sh:datatype     xsd:string;
        sh:description  "Where the cited claim sits within the work (YAML: locator) - page number, timestamp, section, etc. Paired with martialis:sourceLocatorLabel.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        4;
        sh:path         martialis:sourceLocation .

<https://w3id.org/martialis/ontology#SourceAssertionRelationShape/quotation>
        sh:datatype     xsd:string;
        sh:description  "The passage of the source that states the claim, transcribed verbatim: the source's words, order, case and punctuation. Editorial interventions are square-bracketed, as in standard transcription: [...] for an omission inside the passage, [sic] after an error in the source, and a short clarifying insertion where the excerpt would be unclear without it; never a fact the source does not state.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        6;
        sh:path         martialis:quotation .

<https://w3id.org/martialis/ontology#SourceAssertionRelationShape/informationType>
        sh:description  "The informant's proximity to the specific fact cited (Mills): primary (first-hand), secondary (learned from others) or undetermined (the informant cannot be identified). Set per citation. Absent when not yet assessed.";
        sh:in           <https://w3id.org/martialis/ontology#SourceAssertionRelationShape/informationType/in>;
        sh:maxCount     1;
        sh:order        7;
        sh:path         martialis:informationType .

<https://w3id.org/martialis/ontology#SourceAssertionRelationShape/informationType/in>
        rdf:first  infotype:primary;
        rdf:rest   <https://w3id.org/martialis/ontology#SourceAssertionRelationShape/informationType/in/1> .

<https://w3id.org/martialis/ontology#SourceAssertionRelationShape/informationType/in/2>
        rdf:first  infotype:undetermined;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#SourceAssertionRelationShape/informationType/in/1>
        rdf:first  infotype:secondary;
        rdf:rest   <https://w3id.org/martialis/ontology#SourceAssertionRelationShape/informationType/in/2> .

<https://w3id.org/martialis/ontology#SourceAssertionRelationShape/ignoredProperties>
        rdf:first  rdf:type;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#SourceAssertionRelationShape/evidenceType>
        sh:description  "How the cited information bears on the claim (Mills): direct, indirect or negative. Independent of martialis:supports, which gives the direction. Absent when not yet assessed.";
        sh:in           <https://w3id.org/martialis/ontology#SourceAssertionRelationShape/evidenceType/in>;
        sh:maxCount     1;
        sh:order        9;
        sh:path         martialis:evidenceType .

<https://w3id.org/martialis/ontology#SourceAssertionRelationShape/evidenceType/in>
        rdf:first  evidencetype:direct;
        rdf:rest   <https://w3id.org/martialis/ontology#SourceAssertionRelationShape/evidenceType/in/1> .

<https://w3id.org/martialis/ontology#SourceAssertionRelationShape/evidenceType/in/2>
        rdf:first  evidencetype:negative;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#SourceAssertionRelationShape/evidenceType/in/1>
        rdf:first  evidencetype:indirect;
        rdf:rest   <https://w3id.org/martialis/ontology#SourceAssertionRelationShape/evidenceType/in/2> .

<https://w3id.org/martialis/ontology#SourceAssertionRelationShape/citation>
        sh:datatype  xsd:string;
        sh:maxCount  1;
        sh:nodeKind  sh:Literal;
        sh:order     3;
        sh:path      sdo:citation .

<https://w3id.org/martialis/ontology#SourceAssertionRelationShape/basedOnSource>
        sh:class        martialis:Source;
        sh:description  "The Source backing this evidence record.";
        sh:maxCount     1;
        sh:nodeKind     sh:IRI;
        sh:order        0;
        sh:path         martialis:basedOnSource .

<https://w3id.org/martialis/ontology#SourceAssertionRelationShape/archivedAt>
        sh:maxCount  1;
        sh:nodeKind  sh:IRI;
        sh:order     2;
        sh:path      sdo:archivedAt .

martialis:SiteShape  rdf:type  sh:NodeShape;
        rdfs:comment          "A site a Place or Organization occupied: its locality (required), an optional street address and map point, an optional Place it sat within, and the period when the sources date it. The only home for where a Place or Organization is; the current locality is the site or sites with no end year. No period means the period is unsourced, not that the site covers the record's whole life.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#SiteShape/ignoredProperties>;
        sh:property           <https://w3id.org/martialis/ontology#SiteShape/withinPlace> , <https://w3id.org/martialis/ontology#SiteShape/sitePeriod> , <https://w3id.org/martialis/ontology#SiteShape/researchNote> , <https://w3id.org/martialis/ontology#SiteShape/location> , <https://w3id.org/martialis/ontology#SiteShape/hasEvidence> , <https://w3id.org/martialis/ontology#SiteShape/address>;
        sh:targetClass        martialis:Site .

<https://w3id.org/martialis/ontology#SiteShape/withinPlace>
        sh:class        martialis:Place;
        sh:description  "The Place this site sat within (a dojo inside a hall, an HQ housed at a dojo), dated by the site's own period.";
        sh:maxCount     1;
        sh:nodeKind     sh:IRI;
        sh:order        2;
        sh:path         martialis:withinPlace .

<https://w3id.org/martialis/ontology#SiteShape/sitePeriod>
        sh:class        martialis:TimeInterval;
        sh:description  "The period during which a site was occupied. Absent means the period is unsourced.";
        sh:maxCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        3;
        sh:path         martialis:sitePeriod .

<https://w3id.org/martialis/ontology#SiteShape/researchNote>
        sh:datatype     xsd:string;
        sh:description  "A curatorial note recording what is known, suspected, or still to be investigated about a record. Addressed to a maintainer, not a reader (YAML: notes).";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        4;
        sh:path         martialis:researchNote .

<https://w3id.org/martialis/ontology#SiteShape/location>
        sh:class        martialis:GeoRef;
        sh:description  "An embedded place reference (free-text label, country code, optional authority IRI and point), not a Place entity. Carried by Site (where a Place or Organization is) and by Event and the life events (where something happened); a Place or Organization has no location of its own. The specific Place an event happened at is martialis:eventPlace; keeping the two on separate predicates keeps a Place entity and a GeoRef apart.";
        sh:maxCount     1;
        sh:minCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        0;
        sh:path         sdo:location .

<https://w3id.org/martialis/ontology#SiteShape/ignoredProperties>
        rdf:first  rdf:type;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#SiteShape/hasEvidence>
        sh:class        martialis:SourceAssertionRelation;
        sh:description  "Links an entity (assertion, interaction, life event, or top-level entity) to its evidence records.";
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        5;
        sh:path         martialis:hasEvidence .

<https://w3id.org/martialis/ontology#SiteShape/address>
        sh:datatype  xsd:string;
        sh:maxCount  1;
        sh:nodeKind  sh:Literal;
        sh:order     1;
        sh:path      sdo:address .

martialis:RankingSystemShape
        rdf:type              sh:NodeShape;
        rdfs:comment          "A named, sourced grading system that a style's practitioners are ranked in, such as dan-kyu, menkyo or a state sports classification.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#RankingSystemShape/ignoredProperties>;
        sh:property           <https://w3id.org/martialis/ontology#RankingSystemShape/researchNote> , <https://w3id.org/martialis/ontology#RankingSystemShape/rankingSystemKind> , <https://w3id.org/martialis/ontology#RankingSystemShape/name> , <https://w3id.org/martialis/ontology#RankingSystemShape/minOrdinal> , <https://w3id.org/martialis/ontology#RankingSystemShape/maxOrdinal> , <https://w3id.org/martialis/ontology#RankingSystemShape/hasEvidence> , <https://w3id.org/martialis/ontology#RankingSystemShape/gradeScheme> , <https://w3id.org/martialis/ontology#RankingSystemShape/foundedEvent> , <https://w3id.org/martialis/ontology#RankingSystemShape/description> , <https://w3id.org/martialis/ontology#RankingSystemShape/derivedFromSystem> , <https://w3id.org/martialis/ontology#RankingSystemShape/alternateName>;
        sh:targetClass        martialis:RankingSystem .

<https://w3id.org/martialis/ontology#RankingSystemShape/researchNote>
        sh:datatype     xsd:string;
        sh:description  "A curatorial note recording what is known, suspected, or still to be investigated about a record. Addressed to a maintainer, not a reader (YAML: notes).";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        11;
        sh:path         martialis:researchNote .

<https://w3id.org/martialis/ontology#RankingSystemShape/rankingSystemKind>
        sh:description  "'numbered' (an open-ended integer ladder, recorded as rankType/rankOrdinal) or 'enumerated' (a fixed ordered list of grades, a skos:ConceptScheme).";
        sh:in           <https://w3id.org/martialis/ontology#RankingSystemShape/rankingSystemKind/in>;
        sh:maxCount     1;
        sh:minCount     1;
        sh:order        4;
        sh:path         martialis:rankingSystemKind .

<https://w3id.org/martialis/ontology#RankingSystemShape/rankingSystemKind/in>
        rdf:first  "numbered";
        rdf:rest   <https://w3id.org/martialis/ontology#RankingSystemShape/rankingSystemKind/in/1> .

<https://w3id.org/martialis/ontology#RankingSystemShape/rankingSystemKind/in/1>
        rdf:first  "enumerated";
        rdf:rest   () .

<https://w3id.org/martialis/ontology#RankingSystemShape/name>
        sh:description  "Primary name, as a language map.";
        sh:minCount     1;
        sh:order        2;
        sh:path         sdo:name .

<https://w3id.org/martialis/ontology#RankingSystemShape/minOrdinal>
        sh:datatype     xsd:integer;
        sh:description  "Lowest valid grade number (kyu side), if this system bounds it. Absent for the unbounded default.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        5;
        sh:path         martialis:minOrdinal .

<https://w3id.org/martialis/ontology#RankingSystemShape/maxOrdinal>
        sh:datatype     xsd:integer;
        sh:description  "Highest valid grade number (dan side), if this system bounds it. Absent for the unbounded default.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        6;
        sh:path         martialis:maxOrdinal .

<https://w3id.org/martialis/ontology#RankingSystemShape/ignoredProperties>
        rdf:first  rdf:type;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#RankingSystemShape/hasEvidence>
        sh:class        martialis:SourceAssertionRelation;
        sh:description  "Links an entity (assertion, interaction, life event, or top-level entity) to its evidence records.";
        sh:minCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        12;
        sh:path         martialis:hasEvidence .

<https://w3id.org/martialis/ontology#RankingSystemShape/gradeScheme>
        sh:description  "The skos:ConceptScheme enumerating this system's grades (see ontology/vocabularies.ttl), required when martialis:rankingSystemKind is 'enumerated'.";
        sh:maxCount     1;
        sh:nodeKind     sh:IRI;
        sh:order        7;
        sh:path         martialis:gradeScheme .

<https://w3id.org/martialis/ontology#RankingSystemShape/foundedEvent>
        sh:class        martialis:FoundingEvent;
        sh:description  "Founding event with date, location, and sources. Used by Style, Organization, Place, and RankingSystem (YAML 'instituted').";
        sh:maxCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        9;
        sh:path         martialis:foundedEvent .

<https://w3id.org/martialis/ontology#RankingSystemShape/description>
        sh:description  "Reader-facing description, as a language map.";
        sh:order        10;
        sh:path         sdo:description .

<https://w3id.org/martialis/ontology#RankingSystemShape/derivedFromSystem>
        sh:class        martialis:RankingSystem;
        sh:description  "This RankingSystem's grading concept derives from a more generic ancestor system. Distinct from martialis:variantOf (style-to-style).";
        sh:maxCount     1;
        sh:nodeKind     sh:IRI;
        sh:order        8;
        sh:path         martialis:derivedFromSystem .

<https://w3id.org/martialis/ontology#RankingSystemShape/alternateName>
        sh:description  "Alternative names, as a language map.";
        sh:order        3;
        sh:path         sdo:alternateName .

martialis:RankAssertionShape
        rdf:type              sh:NodeShape;
        rdfs:comment          "A claim that the subject (Person) holds a rank in a Style (rankStyle). The rank is a (rankSystem, rankType/rankOrdinal or rankGrade) tuple.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#RankAssertionShape/ignoredProperties>;
        sh:property           <https://w3id.org/martialis/ontology#RankAssertionShape/researchNote> , <https://w3id.org/martialis/ontology#RankAssertionShape/rankType> , <https://w3id.org/martialis/ontology#RankAssertionShape/atEvent> , <https://w3id.org/martialis/ontology#RankAssertionShape/conferredBy> , <https://w3id.org/martialis/ontology#RankAssertionShape/dateCalendar> , <https://w3id.org/martialis/ontology#RankAssertionShape/dateConferred> , <https://w3id.org/martialis/ontology#RankAssertionShape/dateOriginal> , <https://w3id.org/martialis/ontology#RankAssertionShape/grantedBy> , <https://w3id.org/martialis/ontology#RankAssertionShape/hasConfidence> , <https://w3id.org/martialis/ontology#RankAssertionShape/hasEvidence> , <https://w3id.org/martialis/ontology#RankAssertionShape/rankGrade> , <https://w3id.org/martialis/ontology#RankAssertionShape/rankOrdinal> , <https://w3id.org/martialis/ontology#RankAssertionShape/rankStyle> , <https://w3id.org/martialis/ontology#RankAssertionShape/rankSystem>;
        sh:targetClass        martialis:RankAssertion .

<https://w3id.org/martialis/ontology#RankAssertionShape/researchNote>
        sh:datatype     xsd:string;
        sh:description  "A curatorial note recording what is known, suspected, or still to be investigated about a record. Addressed to a maintainer, not a reader (YAML: notes).";
