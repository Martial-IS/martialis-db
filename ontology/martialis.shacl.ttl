martialis:GeoRefShape
        rdf:type              sh:NodeShape;
        rdfs:comment          "A place reference: free-text label plus an authority IRI.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#GeoRefShape/ignoredProperties>;
        sh:property           <https://w3id.org/martialis/ontology#GeoRefShape/sameAs> , <https://w3id.org/martialis/ontology#GeoRefShape/name> , <https://w3id.org/martialis/ontology#GeoRefShape/geo> , <https://w3id.org/martialis/ontology#GeoRefShape/addressCountry>;
        sh:targetClass        martialis:GeoRef .

<https://w3id.org/martialis/ontology#GeoRefShape/sameAs>
        sh:description  "The Wikidata item that IS this source, place reference or nationality, as a wd: CURIE. A source has one only when it is a work with its own item (a book, a periodical); a Wikipedia article has none, and the item of its subject is not its identity. An entity record lists its identity links, Wikidata among them, in sameAs.";
        sh:maxCount     1;
        sh:nodeKind     sh:IRI;
        sh:order        2;
        sh:path         sdo:sameAs .

<https://w3id.org/martialis/ontology#GeoRefShape/name>
        sh:datatype     xsd:string;
        sh:description  "A plain, unlocalised display name (a location, a link).";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        0;
        sh:path         sdo:name .

<https://w3id.org/martialis/ontology#GeoRefShape/ignoredProperties>
        rdf:first  rdf:type;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#GeoRefShape/geo>
        sh:class        martialis:Coordinates;
        sh:description  "An optional WGS84 point, for a reference precise enough to show on a map. The wikidata IRI stays authoritative for identity; coordinates are for display.";
        sh:maxCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        3;
        sh:path         sdo:geo .

<https://w3id.org/martialis/ontology#GeoRefShape/addressCountry>
        sh:maxCount  1;
        sh:nodeKind  sh:IRI;
        sh:order     1;
        sh:path      sdo:addressCountry .

martialis:FoundingEventShape
