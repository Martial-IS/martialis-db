martialis:CoordinatesShape
        rdf:type              sh:NodeShape;
        rdfs:comment          "A WGS84 point. Latitude and longitude are both required, so a coordinate cannot be recorded half-formed.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#CoordinatesShape/ignoredProperties>;
        sh:property           <https://w3id.org/martialis/ontology#CoordinatesShape/longitude> , <https://w3id.org/martialis/ontology#CoordinatesShape/latitude>;
        sh:targetClass        martialis:Coordinates .

<https://w3id.org/martialis/ontology#CoordinatesShape/longitude>
        sh:datatype      xsd:double;
        sh:description   "WGS84 longitude in decimal degrees.";
        sh:maxCount      1;
        sh:maxInclusive  180;
        sh:minCount      1;
        sh:minInclusive  -180;
        sh:nodeKind      sh:Literal;
        sh:order         1;
        sh:path          sdo:longitude .

<https://w3id.org/martialis/ontology#CoordinatesShape/latitude>
        sh:datatype      xsd:double;
        sh:description   "WGS84 latitude in decimal degrees. Double, not decimal: JSON-LD serialises a fractional number in exponential form (e.g. \"3.57E1\"), which is an ill-formed xsd:decimal lexical but a valid xsd:double one.";
        sh:maxCount      1;
        sh:maxInclusive  90;
        sh:minCount      1;
        sh:minInclusive  -90;
        sh:nodeKind      sh:Literal;
        sh:order         0;
        sh:path          sdo:latitude .

<https://w3id.org/martialis/ontology#CoordinatesShape/ignoredProperties>
        rdf:first  rdf:type;
        rdf:rest   () .

martialis:ContributorShape
        rdf:type              sh:NodeShape;
        rdfs:comment          "A person or body credited on a Source in a CSL contributor role, named in CSL name parts and optionally linked to a Person or Organization record.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#ContributorShape/ignoredProperties>;
        sh:property           <https://w3id.org/martialis/ontology#ContributorShape/suffix> , <https://w3id.org/martialis/ontology#ContributorShape/nonDroppingParticle> , <https://w3id.org/martialis/ontology#ContributorShape/name> , <https://w3id.org/martialis/ontology#ContributorShape/givenName> , <https://w3id.org/martialis/ontology#ContributorShape/familyName> , <https://w3id.org/martialis/ontology#ContributorShape/droppingParticle> , <https://w3id.org/martialis/ontology#ContributorShape/contributorRole> , <https://w3id.org/martialis/ontology#ContributorShape/contributorPerson> , <https://w3id.org/martialis/ontology#ContributorShape/contributorOrg>;
        sh:targetClass        martialis:Contributor .

<https://w3id.org/martialis/ontology#ContributorShape/suffix>
        sh:datatype  xsd:string;
        sh:maxCount  1;
        sh:nodeKind  sh:Literal;
        sh:order     6;
        sh:path      martialis:suffix .

<https://w3id.org/martialis/ontology#ContributorShape/nonDroppingParticle>
        sh:datatype     xsd:string;
        sh:description  "CSL name-variable non-dropping-particle: a name part retained when the name is alphabetized (e.g. 'de' in 'de Gaulle, Charles').";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        5;
        sh:path         martialis:nonDroppingParticle .

<https://w3id.org/martialis/ontology#ContributorShape/name>
