        rdf:rest   () .

<https://w3id.org/martialis/ontology#ContributorShape/givenName>
        sh:datatype  xsd:string;
        sh:maxCount  1;
        sh:nodeKind  sh:Literal;
        sh:order     2;
        sh:path      sdo:givenName .

<https://w3id.org/martialis/ontology#ContributorShape/familyName>
        sh:datatype  xsd:string;
        sh:maxCount  1;
        sh:nodeKind  sh:Literal;
        sh:order     1;
        sh:path      sdo:familyName .

<https://w3id.org/martialis/ontology#ContributorShape/droppingParticle>
        sh:datatype  xsd:string;
        sh:maxCount  1;
        sh:nodeKind  sh:Literal;
        sh:order     4;
        sh:path      martialis:droppingParticle .

<https://w3id.org/martialis/ontology#ContributorShape/contributorRole>
        sh:description  "CSL's 26-value contributor role vocabulary: author, editor, translator, interviewer, director, compiler, illustrator, and others.";
        sh:in           <https://w3id.org/martialis/ontology#ContributorShape/contributorRole/in>;
        sh:maxCount     1;
        sh:minCount     1;
        sh:order        0;
        sh:path         martialis:contributorRole .

