martialis:EditionOfShape
        rdf:type              sh:NodeShape;
        rdfs:comment          "The work a Source is an edition, translation, reprint or facsimile of, and the kind of relation.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#EditionOfShape/ignoredProperties>;
        sh:property           <https://w3id.org/martialis/ontology#EditionOfShape/editionRelationType> , <https://w3id.org/martialis/ontology#EditionOfShape/editionOfSource>;
