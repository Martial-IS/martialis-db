        rdf:first  affrel:branch_of;
        rdf:rest   <https://w3id.org/martialis/ontology#AffiliationAssertionShape/affiliationRelation/in/1> .

<https://w3id.org/martialis/ontology#AffiliationAssertionShape/affiliationRelation/in/7>
        rdf:first  affrel:split_from;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#AffiliationAssertionShape/affiliationRelation/in/6>
        rdf:first  affrel:replaces;
