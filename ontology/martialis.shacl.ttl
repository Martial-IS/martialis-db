<https://w3id.org/martialis/ontology#EditionOfShape/ignoredProperties>
        rdf:first  rdf:type;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#EditionOfShape/editionRelationType>
        sh:description  "edition | translation | reprint | facsimile.";
        sh:in           <https://w3id.org/martialis/ontology#EditionOfShape/editionRelationType/in>;
        sh:maxCount     1;
        sh:order        1;
        sh:path         martialis:editionRelationType .

<https://w3id.org/martialis/ontology#EditionOfShape/editionRelationType/in>
        rdf:first  editrel:edition;
        rdf:rest   <https://w3id.org/martialis/ontology#EditionOfShape/editionRelationType/in/1> .

<https://w3id.org/martialis/ontology#EditionOfShape/editionRelationType/in/3>
        rdf:first  editrel:translation;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#EditionOfShape/editionRelationType/in/2>
