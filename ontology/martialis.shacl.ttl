<https://w3id.org/martialis/ontology#PhotoShape/imageAttribution>
        sh:class        martialis:Attribution;
        sh:description  "Credits/attribution for an image or video, indicating its source. Distinct from hasEvidence: attribution carries no supports/contradicts semantics.";
        sh:maxCount     1;
        sh:minCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        1;
        sh:path         martialis:imageAttribution .

<https://w3id.org/martialis/ontology#PhotoShape/ignoredProperties>
        rdf:first  rdf:type;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#PhotoShape/contentUrl>
        sh:maxCount  1;
        sh:minCount  1;
        sh:nodeKind  sh:IRI;
        sh:order     0;
        sh:path      sdo:contentUrl .

martialis:PersonShape
        rdf:type              sh:NodeShape;
        rdfs:comment          "A person recorded in the database: the subject of lineage, rank and honor claims, or a party to them such as a teacher, an examiner or an author.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#PersonShape/ignoredProperties>;
        sh:property           <https://w3id.org/martialis/ontology#PersonShape/video> , <https://w3id.org/martialis/ontology#PersonShape/sameAs> , <https://w3id.org/martialis/ontology#PersonShape/researchNote> , <https://w3id.org/martialis/ontology#PersonShape/primaryImage> , <https://w3id.org/martialis/ontology#PersonShape/nationality> , <https://w3id.org/martialis/ontology#PersonShape/name> , <https://w3id.org/martialis/ontology#PersonShape/keywords> , <https://w3id.org/martialis/ontology#PersonShape/alternateName> , <https://w3id.org/martialis/ontology#PersonShape/birthEvent> , <https://w3id.org/martialis/ontology#PersonShape/deathEvent> , <https://w3id.org/martialis/ontology#PersonShape/description> , <https://w3id.org/martialis/ontology#PersonShape/hasDocumentTransmissionAssertion> , <https://w3id.org/martialis/ontology#PersonShape/hasEvidence> , <https://w3id.org/martialis/ontology#PersonShape/hasHistoricityAssertion> , <https://w3id.org/martialis/ontology#PersonShape/hasHonorAssertion> , <https://w3id.org/martialis/ontology#PersonShape/hasIdentityAssertion> , <https://w3id.org/martialis/ontology#PersonShape/hasRankAssertion> , <https://w3id.org/martialis/ontology#PersonShape/hasTeacherAssertion> , <https://w3id.org/martialis/ontology#PersonShape/image>;
        sh:targetClass        martialis:Person .

<https://w3id.org/martialis/ontology#PersonShape/video>
        sh:class     martialis:Video;
        sh:nodeKind  sh:BlankNodeOrIRI;
        sh:order     11;
        sh:path      sdo:video .

<https://w3id.org/martialis/ontology#PersonShape/sameAs>
        sh:description  "The same entity in an external authority, as a CURIE naming the entity itself (not a web page about it): wd: (Wikidata), dbr: (DBpedia), viaf:, isni:, lcnaf: (Library of Congress names), ndlna: (National Diet Library), orcid:. Nothing else belongs here: a web page, a Wikipedia article or an official site is not an identity.";
        sh:nodeKind     sh:IRI;
        sh:order        20;
        sh:path         sdo:sameAs;
        sh:pattern      "^(http://www\\.wikidata\\.org/entity/Q[1-9][0-9]*|http://dbpedia\\.org/resource/[^\\s]+|http://viaf\\.org/viaf/[1-9][0-9]*|https://isni\\.org/isni/[0-9]{15}[0-9X]|http://id\\.loc\\.gov/authorities/names/n[a-z]?[0-9]+|http://id\\.ndl\\.go\\.jp/auth/ndlna/[0-9]+|https://orcid\\.org/[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X])$" .

<https://w3id.org/martialis/ontology#PersonShape/researchNote>
        sh:datatype     xsd:string;
        sh:description  "A curatorial note recording what is known, suspected, or still to be investigated about a record. Addressed to a maintainer, not a reader (YAML: notes).";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        8;
        sh:path         martialis:researchNote .

<https://w3id.org/martialis/ontology#PersonShape/primaryImage>
        sh:class        martialis:Photo;
        sh:description  "The single primary depiction of an entity. The multivalued photos gallery uses schema:image; a single-valued slot cannot share that IRI without its maxCount 1 shape firing on the gallery.";
        sh:maxCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        9;
        sh:path         martialis:primaryImage .

<https://w3id.org/martialis/ontology#PersonShape/nationality>
        sh:class        martialis:NationalityEntry;
        sh:description  "Nationalities, each a country code and optional Wikidata Q-ID.";
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        4;
        sh:path         sdo:nationality .

<https://w3id.org/martialis/ontology#PersonShape/name>
        sh:description  "Primary name, as a language map.";
        sh:minCount     1;
        sh:order        2;
        sh:path         sdo:name .

<https://w3id.org/martialis/ontology#PersonShape/keywords>
        sh:datatype  xsd:string;
        sh:nodeKind  sh:Literal;
        sh:order     19;
        sh:path      sdo:keywords .

<https://w3id.org/martialis/ontology#PersonShape/image>
        sh:class        martialis:Photo;
        sh:description  "A gallery of depictions; the generic sdo:image relation.";
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        10;
        sh:path         sdo:image .

<https://w3id.org/martialis/ontology#PersonShape/ignoredProperties>
        rdf:first  rdf:type;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#PersonShape/hasTeacherAssertion>
        sh:class        martialis:TeacherAssertion;
        sh:description  "Links a Person to their TeacherAssertions: claims of having studied under a teacher. The assertion names the teacher when a source identifies one; evidence attaches to the assertion's interactions.";
        sh:nodeKind     sh:IRI;
        sh:order        12;
        sh:path         martialis:hasTeacherAssertion .

<https://w3id.org/martialis/ontology#PersonShape/hasRankAssertion>
        sh:class        martialis:RankAssertion;
        sh:description  "Links a Person to their RankAssertions: claims of holding a rank in a style.";
        sh:nodeKind     sh:IRI;
        sh:order        13;
        sh:path         martialis:hasRankAssertion .

<https://w3id.org/martialis/ontology#PersonShape/hasIdentityAssertion>
        sh:class        martialis:IdentityAssertion;
        sh:description  "Links a Person to their IdentityAssertions: sourced hypotheses that two Person records may be the same individual.";
        sh:nodeKind     sh:IRI;
        sh:order        16;
        sh:path         martialis:hasIdentityAssertion .

<https://w3id.org/martialis/ontology#PersonShape/hasHonorAssertion>
        sh:class        martialis:HonorAssertion;
        sh:description  "Links a Person to their HonorAssertions: non-style-specific titles or certificates (Hanshi, Kyoshi). Distinct from OfficerRole, which is a tenured office with a real end.";
        sh:nodeKind     sh:IRI;
        sh:order        14;
        sh:path         martialis:hasHonorAssertion .

<https://w3id.org/martialis/ontology#PersonShape/hasHistoricityAssertion>
        sh:class        martialis:HistoricityAssertion;
        sh:description  "Links a Person to their HistoricityAssertions: sourced, graded claims about whether the person existed as one historical individual. Competing readings are separate entries.";
        sh:nodeKind     sh:IRI;
        sh:order        17;
        sh:path         martialis:hasHistoricityAssertion .

<https://w3id.org/martialis/ontology#PersonShape/hasEvidence>
        sh:class        martialis:SourceAssertionRelation;
        sh:description  "Links an entity (assertion, interaction, life event, or top-level entity) to its evidence records.";
        sh:minCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        18;
        sh:path         martialis:hasEvidence .

<https://w3id.org/martialis/ontology#PersonShape/hasDocumentTransmissionAssertion>
        sh:class        martialis:DocumentTransmissionAssertion;
        sh:description  "Links a Person to their DocumentTransmissionAssertions: claims of learning from a document rather than a person.";
        sh:nodeKind     sh:IRI;
        sh:order        15;
        sh:path         martialis:hasDocumentTransmissionAssertion .

<https://w3id.org/martialis/ontology#PersonShape/description>
        sh:description  "Reader-facing description, as a language map.";
        sh:order        7;
        sh:path         sdo:description .

<https://w3id.org/martialis/ontology#PersonShape/deathEvent>
        sh:class        martialis:DeathEvent;
        sh:description  "Links a Person to their death LifeEvent, which carries the date, location, and sources.";
        sh:maxCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        6;
        sh:path         martialis:deathEvent .

<https://w3id.org/martialis/ontology#PersonShape/birthEvent>
        sh:class        martialis:BirthEvent;
        sh:description  "Links a Person to their birth LifeEvent, which carries the date, location, and sources.";
        sh:maxCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        5;
        sh:path         martialis:birthEvent .

<https://w3id.org/martialis/ontology#PersonShape/alternateName>
        sh:description  "Alternative names, as a language map.";
        sh:order        3;
        sh:path         sdo:alternateName .

martialis:ParticipationShape
        rdf:type              sh:NodeShape;
        rdfs:comment          "A participation record in an Event: the participating agent (a Person as participant, or an Organization as participantOrganization), their role, and the evidence.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#ParticipationShape/ignoredProperties>;
        sh:property           <https://w3id.org/martialis/ontology#ParticipationShape/researchNote> , <https://w3id.org/martialis/ontology#ParticipationShape/participationStyle> , <https://w3id.org/martialis/ontology#ParticipationShape/participationRole> , <https://w3id.org/martialis/ontology#ParticipationShape/participantOrganization> , <https://w3id.org/martialis/ontology#ParticipationShape/participant> , <https://w3id.org/martialis/ontology#ParticipationShape/hasEvidence> , <https://w3id.org/martialis/ontology#ParticipationShape/hasConfidence>;
        sh:targetClass        martialis:Participation .

<https://w3id.org/martialis/ontology#ParticipationShape/researchNote>
        sh:datatype     xsd:string;
        sh:description  "A curatorial note recording what is known, suspected, or still to be investigated about a record. Addressed to a maintainer, not a reader (YAML: notes).";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        3;
        sh:path         martialis:researchNote .

<https://w3id.org/martialis/ontology#ParticipationShape/participationStyle>
        sh:class        martialis:Style;
        sh:description  "The style a participant specifically taught or practised at this event. Optional; omitted on single-style events.";
        sh:nodeKind     sh:IRI;
        sh:order        1;
        sh:path         martialis:participationStyle .

<https://w3id.org/martialis/ontology#ParticipationShape/participationRole>
        sh:description  "The role an agent played in an Event: competitor, official, organizer, demonstrator, guest, instructor, signatory, or other. A student's attendance is a TeacherAssertion on the student's record, linked with martialis:atEvent.";
        sh:in           <https://w3id.org/martialis/ontology#ParticipationShape/participationRole/in>;
        sh:maxCount     1;
        sh:minCount     1;
        sh:order        0;
        sh:path         martialis:participationRole .

<https://w3id.org/martialis/ontology#ParticipationShape/participationRole/in>
        rdf:first  eventrole:competitor;
        rdf:rest   <https://w3id.org/martialis/ontology#ParticipationShape/participationRole/in/1> .

<https://w3id.org/martialis/ontology#ParticipationShape/participationRole/in/7>
        rdf:first  eventrole:signatory;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#ParticipationShape/participationRole/in/6>
        rdf:first  eventrole:other;
        rdf:rest   <https://w3id.org/martialis/ontology#ParticipationShape/participationRole/in/7> .

<https://w3id.org/martialis/ontology#ParticipationShape/participationRole/in/5>
        rdf:first  eventrole:organizer;
        rdf:rest   <https://w3id.org/martialis/ontology#ParticipationShape/participationRole/in/6> .

<https://w3id.org/martialis/ontology#ParticipationShape/participationRole/in/4>
        rdf:first  eventrole:official;
        rdf:rest   <https://w3id.org/martialis/ontology#ParticipationShape/participationRole/in/5> .

<https://w3id.org/martialis/ontology#ParticipationShape/participationRole/in/3>
        rdf:first  eventrole:instructor;
        rdf:rest   <https://w3id.org/martialis/ontology#ParticipationShape/participationRole/in/4> .

<https://w3id.org/martialis/ontology#ParticipationShape/participationRole/in/2>
        rdf:first  eventrole:guest;
        rdf:rest   <https://w3id.org/martialis/ontology#ParticipationShape/participationRole/in/3> .

<https://w3id.org/martialis/ontology#ParticipationShape/participationRole/in/1>
        rdf:first  eventrole:demonstrator;
        rdf:rest   <https://w3id.org/martialis/ontology#ParticipationShape/participationRole/in/2> .

<https://w3id.org/martialis/ontology#ParticipationShape/participantOrganization>
        sh:class        martialis:Organization;
        sh:description  "The participating Organization of a Participation, when no person is named. A distinct predicate from participant, because the two value shapes (Person and Organization) cannot share one IRI.";
        sh:maxCount     1;
        sh:nodeKind     sh:IRI;
        sh:order        6;
        sh:path         martialis:participantOrganization .

<https://w3id.org/martialis/ontology#ParticipationShape/participant>
        sh:class        martialis:Person;
        sh:description  "The participating person.";
        sh:maxCount     1;
        sh:nodeKind     sh:IRI;
        sh:order        5;
        sh:path         martialis:participant .

<https://w3id.org/martialis/ontology#ParticipationShape/ignoredProperties>
        rdf:first  rdf:type;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#ParticipationShape/hasEvidence>
        sh:class        martialis:SourceAssertionRelation;
        sh:description  "Links an entity (assertion, interaction, life event, or top-level entity) to its evidence records.";
        sh:minCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        4;
        sh:path         martialis:hasEvidence .

<https://w3id.org/martialis/ontology#ParticipationShape/hasConfidence>
        sh:class        martialis:Confidence;
        sh:description  "Links an Assertion to its Confidence assessment.";
        sh:maxCount     1;
        sh:minCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        2;
        sh:path         martialis:hasConfidence .

