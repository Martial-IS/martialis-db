<https://w3id.org/martialis/ontology#HonorAssertionShape/dateOriginal>
        sh:datatype     xsd:string;
        sh:description  "Free-text date as given by the source, when it differs from the Gregorian-equivalent EDTF value in the paired date property. Paired with martialis:dateCalendar.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        7;
        sh:path         martialis:dateOriginal .

<https://w3id.org/martialis/ontology#HonorAssertionShape/dateConferred>
        sh:datatype     xsd:string;
        sh:description  "When the rank or honor was conferred, in EDTF.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        6;
        sh:path         martialis:dateConferred;
        sh:pattern      "^(?:(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?|(?:(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?|\\.\\.|unknown)/(?:(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?|\\.\\.|unknown)|\\[(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?(?:,(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?)+\\])$" .

