<https://w3id.org/martialis/ontology#ContributorShape/contributorPerson>
        sh:class        martialis:Person;
        sh:description  "Links a contributor to their own Person entry, when one exists.";
        sh:maxCount     1;
        sh:nodeKind     sh:IRI;
        sh:order        7;
        sh:path         martialis:contributorPerson .

<https://w3id.org/martialis/ontology#ContributorShape/contributorOrg>
        sh:class        martialis:Organization;
        sh:description  "Links a corporate contributor (e.g. an editorial board credited as a body) to its own Organization entry, when it is in the database.";
        sh:maxCount     1;
        sh:nodeKind     sh:IRI;
        sh:order        8;
        sh:path         martialis:contributorOrg .

martialis:ConfidenceShape
        rdf:type              sh:NodeShape;
        rdfs:comment          "A confidence assessment applied to an assertion.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#ConfidenceShape/ignoredProperties>;
        sh:property           <https://w3id.org/martialis/ontology#ConfidenceShape/confidenceRationale> , <https://w3id.org/martialis/ontology#ConfidenceShape/confidenceLevel> , <https://w3id.org/martialis/ontology#ConfidenceShape/assessedBy>;
        sh:targetClass        martialis:Confidence .

<https://w3id.org/martialis/ontology#ConfidenceShape/ignoredProperties>
        rdf:first  rdf:type;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#ConfidenceShape/confidenceRationale>
        sh:datatype     xsd:string;
        sh:description  "Free-text justification for the confidence level: what the evidence does and does not establish.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        2;
        sh:path         martialis:confidenceRationale .

<https://w3id.org/martialis/ontology#ConfidenceShape/confidenceLevel>
        sh:description  "The curator's conclusion about the claim after weighing all its evidence: refuted, doubtful, possible, probable or confirmed, ordered by martialis:gradeOrdinal. A certainty scale only: contested evidence is carried by martialis:supports false, not by a level.";
        sh:in           <https://w3id.org/martialis/ontology#ConfidenceShape/confidenceLevel/in>;
        sh:maxCount     1;
        sh:minCount     1;
        sh:order        0;
        sh:path         martialis:confidenceLevel .

<https://w3id.org/martialis/ontology#ConfidenceShape/confidenceLevel/in>
        rdf:first  conflevel:confirmed;
        rdf:rest   <https://w3id.org/martialis/ontology#ConfidenceShape/confidenceLevel/in/1> .

<https://w3id.org/martialis/ontology#ConfidenceShape/confidenceLevel/in/4>
        rdf:first  conflevel:refuted;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#ConfidenceShape/confidenceLevel/in/3>
        rdf:first  conflevel:probable;
        rdf:rest   <https://w3id.org/martialis/ontology#ConfidenceShape/confidenceLevel/in/4> .

<https://w3id.org/martialis/ontology#ConfidenceShape/confidenceLevel/in/2>
        rdf:first  conflevel:possible;
        rdf:rest   <https://w3id.org/martialis/ontology#ConfidenceShape/confidenceLevel/in/3> .

<https://w3id.org/martialis/ontology#ConfidenceShape/confidenceLevel/in/1>
        rdf:first  conflevel:doubtful;
        rdf:rest   <https://w3id.org/martialis/ontology#ConfidenceShape/confidenceLevel/in/2> .

<https://w3id.org/martialis/ontology#ConfidenceShape/assessedBy>
        sh:description  "The agent who performed the confidence assessment (https://martial.is/agent/).";
        sh:maxCount     1;
        sh:nodeKind     sh:IRI;
        sh:order        1;
        sh:path         martialis:assessedBy .

martialis:BirthEventShape
        rdf:type              sh:NodeShape;
        rdfs:comment          "A person's birth: its date, place and evidence.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#BirthEventShape/ignoredProperties>;
        sh:property           <https://w3id.org/martialis/ontology#BirthEventShape/startDate> , <https://w3id.org/martialis/ontology#BirthEventShape/location> , <https://w3id.org/martialis/ontology#BirthEventShape/hasEvidence> , <https://w3id.org/martialis/ontology#BirthEventShape/dateOriginal> , <https://w3id.org/martialis/ontology#BirthEventShape/dateCalendar>;
        sh:targetClass        martialis:BirthEvent .

<https://w3id.org/martialis/ontology#BirthEventShape/startDate>
        sh:datatype     xsd:string;
        sh:description  "When the birth took place, in EDTF. Exported as the birth event's schema:startDate; the export also states a plain ISO date on the person as schema:birthDate.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        0;
        sh:path         sdo:startDate;
        sh:pattern      "^(?:(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?|(?:(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?|\\.\\.|unknown)/(?:(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?|\\.\\.|unknown)|\\[(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?(?:,(?:-?[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?|[0-9]{3}X|[0-9]{2}XX)[?~%]?)+\\])$" .

<https://w3id.org/martialis/ontology#BirthEventShape/location>
        sh:class        martialis:GeoRef;
        sh:description  "Where the birth took place. Exported as the birth event's schema:location; the export also states it on the person as schema:birthPlace.";
        sh:maxCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        3;
        sh:path         sdo:location .

<https://w3id.org/martialis/ontology#BirthEventShape/ignoredProperties>
        rdf:first  rdf:type;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#BirthEventShape/hasEvidence>
        sh:class        martialis:SourceAssertionRelation;
        sh:description  "Links an entity (assertion, interaction, life event, or top-level entity) to its evidence records.";
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        4;
        sh:path         martialis:hasEvidence .

<https://w3id.org/martialis/ontology#BirthEventShape/dateOriginal>
        sh:datatype     xsd:string;
        sh:description  "Free-text date as given by the source, when it differs from the Gregorian-equivalent EDTF value in the paired date property. Paired with martialis:dateCalendar.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        1;
        sh:path         martialis:dateOriginal .

<https://w3id.org/martialis/ontology#BirthEventShape/dateCalendar>
        sh:description  "Calendar system a source's own date was expressed in: julian, japanese-nengo, japanese-lunisolar, other-lunisolar, or other.";
        sh:in           <https://w3id.org/martialis/ontology#BirthEventShape/dateCalendar/in>;
        sh:maxCount     1;
        sh:order        2;
        sh:path         martialis:dateCalendar .

<https://w3id.org/martialis/ontology#BirthEventShape/dateCalendar/in>
        rdf:first  datecal:japanese_lunisolar;
        rdf:rest   <https://w3id.org/martialis/ontology#BirthEventShape/dateCalendar/in/1> .

<https://w3id.org/martialis/ontology#BirthEventShape/dateCalendar/in/4>
        rdf:first  datecal:other_lunisolar;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#BirthEventShape/dateCalendar/in/3>
        rdf:first  datecal:other;
        rdf:rest   <https://w3id.org/martialis/ontology#BirthEventShape/dateCalendar/in/4> .

<https://w3id.org/martialis/ontology#BirthEventShape/dateCalendar/in/2>
        rdf:first  datecal:julian;
        rdf:rest   <https://w3id.org/martialis/ontology#BirthEventShape/dateCalendar/in/3> .

<https://w3id.org/martialis/ontology#BirthEventShape/dateCalendar/in/1>
        rdf:first  datecal:japanese_nengo;
        rdf:rest   <https://w3id.org/martialis/ontology#BirthEventShape/dateCalendar/in/2> .

martialis:AttributionShape
        rdf:type              sh:NodeShape;
        rdfs:comment          "Crediting a media item to a source; carries no supports semantics.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#AttributionShape/ignoredProperties>;
        sh:property           <https://w3id.org/martialis/ontology#AttributionShape/url> , <https://w3id.org/martialis/ontology#AttributionShape/quotation> , <https://w3id.org/martialis/ontology#AttributionShape/informationType> , <https://w3id.org/martialis/ontology#AttributionShape/evidenceType> , <https://w3id.org/martialis/ontology#AttributionShape/citation> , <https://w3id.org/martialis/ontology#AttributionShape/basedOnSource> , <https://w3id.org/martialis/ontology#AttributionShape/archivedAt>;
        sh:targetClass        martialis:Attribution .

<https://w3id.org/martialis/ontology#AttributionShape/url>
        sh:maxCount  1;
        sh:nodeKind  sh:IRI;
        sh:order     1;
        sh:path      sdo:url .

<https://w3id.org/martialis/ontology#AttributionShape/quotation>
        sh:datatype     xsd:string;
        sh:description  "The passage of the source that states the claim, transcribed verbatim: the source's words, order, case and punctuation. Editorial interventions are square-bracketed, as in standard transcription: [...] for an omission inside the passage, [sic] after an error in the source, and a short clarifying insertion where the excerpt would be unclear without it; never a fact the source does not state.";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        4;
        sh:path         martialis:quotation .

<https://w3id.org/martialis/ontology#AttributionShape/informationType>
        sh:description  "The informant's proximity to the specific fact cited (Mills): primary (first-hand), secondary (learned from others) or undetermined (the informant cannot be identified). Set per citation. Absent when not yet assessed.";
        sh:in           <https://w3id.org/martialis/ontology#AttributionShape/informationType/in>;
        sh:maxCount     1;
        sh:order        5;
        sh:path         martialis:informationType .

<https://w3id.org/martialis/ontology#AttributionShape/informationType/in>
        rdf:first  infotype:primary;
        rdf:rest   <https://w3id.org/martialis/ontology#AttributionShape/informationType/in/1> .

<https://w3id.org/martialis/ontology#AttributionShape/informationType/in/2>
        rdf:first  infotype:undetermined;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#AttributionShape/informationType/in/1>
        rdf:first  infotype:secondary;
        rdf:rest   <https://w3id.org/martialis/ontology#AttributionShape/informationType/in/2> .

<https://w3id.org/martialis/ontology#AttributionShape/ignoredProperties>
        rdf:first  rdf:type;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#AttributionShape/evidenceType>
        sh:description  "How the cited information bears on the claim (Mills): direct, indirect or negative. Independent of martialis:supports, which gives the direction. Absent when not yet assessed.";
        sh:in           <https://w3id.org/martialis/ontology#AttributionShape/evidenceType/in>;
        sh:maxCount     1;
        sh:order        6;
        sh:path         martialis:evidenceType .

<https://w3id.org/martialis/ontology#AttributionShape/evidenceType/in>
        rdf:first  evidencetype:direct;
        rdf:rest   <https://w3id.org/martialis/ontology#AttributionShape/evidenceType/in/1> .

<https://w3id.org/martialis/ontology#AttributionShape/evidenceType/in/2>
        rdf:first  evidencetype:negative;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#AttributionShape/evidenceType/in/1>
        rdf:first  evidencetype:indirect;
        rdf:rest   <https://w3id.org/martialis/ontology#AttributionShape/evidenceType/in/2> .

<https://w3id.org/martialis/ontology#AttributionShape/citation>
        sh:datatype  xsd:string;
        sh:maxCount  1;
        sh:nodeKind  sh:Literal;
        sh:order     3;
        sh:path      sdo:citation .

<https://w3id.org/martialis/ontology#AttributionShape/basedOnSource>
        sh:class        martialis:Source;
        sh:description  "The Source backing this evidence record.";
        sh:maxCount     1;
        sh:nodeKind     sh:IRI;
        sh:order        0;
        sh:path         martialis:basedOnSource .

<https://w3id.org/martialis/ontology#AttributionShape/archivedAt>
        sh:maxCount  1;
        sh:nodeKind  sh:IRI;
        sh:order     2;
        sh:path      sdo:archivedAt .

martialis:AffiliationAssertionShape
        rdf:type              sh:NodeShape;
        rdfs:comment          "A typed, sourced claim that the subject (a Place or Organization) is affiliated with, or descends from, the related Organization.";
        sh:closed             false;
        sh:ignoredProperties  <https://w3id.org/martialis/ontology#AffiliationAssertionShape/ignoredProperties>;
        sh:property           <https://w3id.org/martialis/ontology#AffiliationAssertionShape/validDuring> , <https://w3id.org/martialis/ontology#AffiliationAssertionShape/researchNote> , <https://w3id.org/martialis/ontology#AffiliationAssertionShape/relatedOrganization> , <https://w3id.org/martialis/ontology#AffiliationAssertionShape/hasEvidence> , <https://w3id.org/martialis/ontology#AffiliationAssertionShape/hasConfidence> , <https://w3id.org/martialis/ontology#AffiliationAssertionShape/atEvent> , <https://w3id.org/martialis/ontology#AffiliationAssertionShape/affiliationRelation>;
        sh:targetClass        martialis:AffiliationAssertion .

<https://w3id.org/martialis/ontology#AffiliationAssertionShape/validDuring>
        sh:class        martialis:TimeInterval;
        sh:description  "The period during which an assertion held (used by DocumentTransmissionAssertion and AffiliationAssertion; teacher relationships carry periods on their interactions instead).";
        sh:maxCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        2;
        sh:path         martialis:validDuring .

<https://w3id.org/martialis/ontology#AffiliationAssertionShape/researchNote>
        sh:datatype     xsd:string;
        sh:description  "A curatorial note recording what is known, suspected, or still to be investigated about a record. Addressed to a maintainer, not a reader (YAML: notes).";
        sh:maxCount     1;
        sh:nodeKind     sh:Literal;
        sh:order        4;
        sh:path         martialis:researchNote .

<https://w3id.org/martialis/ontology#AffiliationAssertionShape/relatedOrganization>
        sh:class        martialis:Organization;
        sh:description  "The organization the subject is affiliated with or descends from, as affiliationRelation says.";
        sh:maxCount     1;
        sh:minCount     1;
        sh:nodeKind     sh:IRI;
        sh:order        6;
        sh:path         martialis:relatedOrganization .

<https://w3id.org/martialis/ontology#AffiliationAssertionShape/ignoredProperties>
        rdf:first  rdf:type;
        rdf:rest   () .

<https://w3id.org/martialis/ontology#AffiliationAssertionShape/hasEvidence>
        sh:class        martialis:SourceAssertionRelation;
        sh:description  "Links an entity (assertion, interaction, life event, or top-level entity) to its evidence records.";
        sh:minCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        5;
        sh:path         martialis:hasEvidence .

<https://w3id.org/martialis/ontology#AffiliationAssertionShape/hasConfidence>
        sh:class        martialis:Confidence;
        sh:description  "Links an Assertion to its Confidence assessment.";
        sh:maxCount     1;
        sh:minCount     1;
        sh:nodeKind     sh:BlankNodeOrIRI;
        sh:order        3;
        sh:path         martialis:hasConfidence .

<https://w3id.org/martialis/ontology#AffiliationAssertionShape/atEvent>
        sh:class        martialis:Event;
        sh:description  "Optional link from an assertion or life event to the canonical Event record(s) it took place at. Multivalued.";
        sh:nodeKind     sh:IRI;
        sh:order        1;
        sh:path         martialis:atEvent .

<https://w3id.org/martialis/ontology#AffiliationAssertionShape/affiliationRelation>
        sh:description  "Relation kind: member_of, branch_of, recognised_by (ties) or derived_from, split_from, merged_from, replaces, renamed_from (organization genealogy).";
        sh:in           <https://w3id.org/martialis/ontology#AffiliationAssertionShape/affiliationRelation/in>;
        sh:maxCount     1;
        sh:minCount     1;
        sh:order        0;
