<http://purl.org/ontology/bibo/handle> rdf:type owl:DatatypeProperty .


###  http://purl.org/ontology/bibo/issue
<http://purl.org/ontology/bibo/issue> rdf:type owl:DatatypeProperty ;
                                      rdfs:subPropertyOf <http://purl.org/ontology/bibo/locator> ;
                                      rdfs:domain <http://purl.org/ontology/bibo/Issue> ;
                                      rdfs:comment "An issue number"@en ;
                                      rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
                                      rdfs:label "issue"@en ;
                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://purl.org/ontology/bibo/locator
<http://purl.org/ontology/bibo/locator> rdf:type owl:DatatypeProperty ;
                                        rdfs:domain <http://purl.org/ontology/bibo/Document> ;
                                        rdfs:comment "A description (often numeric) that locates an item within a containing document or collection."@en ;
                                        rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
                                        rdfs:label "locator"@en ;
                                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://purl.org/ontology/bibo/oclcnum
<http://purl.org/ontology/bibo/oclcnum> rdf:type owl:DatatypeProperty .


###  http://purl.org/ontology/bibo/pages
<http://purl.org/ontology/bibo/pages> rdf:type owl:DatatypeProperty ;
                                      rdfs:subPropertyOf <http://purl.org/ontology/bibo/locator> ;
                                      rdfs:domain <http://purl.org/ontology/bibo/Document> ;
                                      rdfs:comment "A string of non-contiguous page spans that locate a Document within a Collection. Example: 23-25, 34, 54-56. For continuous page ranges, use the pageStart and pageEnd properties."@en ;
                                      rdfs:isDefinedBy "http://purl.org/ontology/bibo/"^^xsd:anyURI ;
                                      rdfs:label "pages"@en ;
