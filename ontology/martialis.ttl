###  https://w3id.org/martialis/ontology#eventPlace
martialis:eventPlace rdf:type owl:ObjectProperty ;
                     rdfs:range martialis:Place ;
                     rdfs:comment "The Place an Event, FoundingEvent or DissolutionEvent happened at. Narrower than schema:location, but mapped to it rather than a sub-property of it: on these classes schema:location holds only the GeoRef of the location slot."@en ;
                     rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                     rdfs:label "Veranstaltungsort"@de ,
                                "event place"@en ,
                                "lieu de l’événement"@fr ,
                                "local do evento"@pt ,
                                "lugar del evento"@es ,
                                "staður viðburðar"@is ,
                                "会場"@ja ,
                                "活动地点"@zh ;
                     skos:broadMatch sdo:location ;
                     sdo:domainIncludes martialis:DissolutionEvent ,
                                        martialis:Event ,
                                        martialis:FoundingEvent .


