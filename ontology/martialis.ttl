###  https://w3id.org/martialis/ontology#sourceClassification
martialis:sourceClassification rdf:type owl:ObjectProperty ;
                               rdfs:domain martialis:Source ;
                               rdfs:range skos:Concept ;
                               rdfs:comment "The Source's form relative to the record it carries (Mills): original, derivative or authored. Set once on the Source."@en ;
                               rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                               rdfs:label "Quellenklassifikation"@de ,
                                          "clasificación de la fuente"@es ,
                                          "classification de la source"@fr ,
