sdo:VideoObject rdf:type owl:Class .


###  https://w3id.org/martialis/ontology#AffiliationAssertion
martialis:AffiliationAssertion rdf:type owl:Class ;
                               rdfs:subClassOf martialis:Assertion ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty martialis:affiliationRelation ;
                                                 owl:allValuesFrom skos:Concept
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty martialis:atEvent ;
                                                 owl:allValuesFrom martialis:Event
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty martialis:hasConfidence ;
                                                 owl:allValuesFrom martialis:Confidence
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty martialis:hasEvidence ;
                                                 owl:allValuesFrom martialis:SourceAssertionRelation
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty martialis:relatedOrganization ;
                                                 owl:allValuesFrom martialis:Organization
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty martialis:validDuring ;
                                                 owl:allValuesFrom martialis:TimeInterval
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty martialis:hasEvidence ;
                                                 owl:minCardinality "1"^^xsd:nonNegativeInteger
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty martialis:affiliationRelation ;
                                                 owl:cardinality "1"^^xsd:nonNegativeInteger
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty martialis:hasConfidence ;
                                                 owl:cardinality "1"^^xsd:nonNegativeInteger
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty martialis:relatedOrganization ;
                                                 owl:cardinality "1"^^xsd:nonNegativeInteger
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty martialis:validDuring ;
                                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty martialis:researchNote ;
                                                 owl:allValuesFrom xsd:string
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty martialis:researchNote ;
                                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                               ] ;
                               <http://purl.org/vocab/vann/example> "TIES: <dojo> martialis:hasAffiliationAssertion [ martialis:relatedOrganization <aikikai> ; martialis:affiliationRelation \"recognised_by\" ; martialis:validDuring [ martialis:startYear 1970 ; martialis:endYear 1979 ] ] . GENEALOGY: <newBody> martialis:hasAffiliationAssertion [ martialis:relatedOrganization <oldBody> ; martialis:affiliationRelation \"split_from\" ] ."@en ;
                               rdfs:comment "A typed, sourced claim that the subject (a Place or Organization) is affiliated with, or descends from, the related Organization."@en ;
                               rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                               rdfs:label "Zugehörigkeitsaussage"@de ,
                                          "affiliation assertion"@en ,
                                          "aserción de afiliación"@es ,
                                          "assertion d’affiliation"@fr ,
                                          "asserção de afiliação"@pt ,
                                          "fullyrðing um aðild"@is ,
                                          "所属関係アサーション"@ja ,
                                          "隶属关系断言"@zh .


###  https://w3id.org/martialis/ontology#Agent
martialis:Agent rdf:type owl:Class ;
                rdfs:subClassOf prov:Agent ,
                                [ rdf:type owl:Class ;
                                  owl:unionOf ( martialis:Organization
                                                martialis:Person
                                              )
                                ] ;
                rdfs:comment "A person or an organization: the abstract superclass of Person and Organization."@en ;
                rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                rdfs:label "Akteur"@de ,
                           "agent"@en ,
                           "agent"@fr ,
                           "agente"@es ,
                           "agente"@pt ,
                           "gerandi"@is ,
                           "エージェント"@ja ,
                           "行为者"@zh .


###  https://w3id.org/martialis/ontology#Assertion
martialis:Assertion rdf:type owl:Class ;
                    rdfs:subClassOf prov:Entity ,
                                    [ rdf:type owl:Class ;
                                      owl:unionOf ( martialis:AffiliationAssertion
                                                    martialis:DocumentTransmissionAssertion
                                                    martialis:HistoricityAssertion
                                                    martialis:HonorAssertion
                                                    martialis:IdentityAssertion
                                                    martialis:InstructorRole
                                                    martialis:Membership
                                                    martialis:OfficerRole
                                                    martialis:Participation
                                                    martialis:RankAssertion
                                                    martialis:StyleRelationAssertion
                                                    martialis:TeacherAssertion
                                                  )
                                    ] ;
                    rdfs:comment "A sourced claim nested in an entity record, typed by what it asserts: a teacher relationship, a rank, an honor, an affiliation, a style relation, a document transmission, a candidate identity, a historicity, a participation in an event, an instructor or officer role, or a membership. Every claim has its own ULID, so it keeps its identity when the claims around it are added, removed or reordered."@en ;
                    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                    rdfs:label "Aussage"@de ,
                               "aserción"@es ,
                               "assertion"@en ,
                               "assertion"@fr ,
                               "asserção"@pt ,
                               "fullyrðing"@is ,
                               "アサーション"@ja ,
                               "断言"@zh .


###  https://w3id.org/martialis/ontology#Attribution
martialis:Attribution rdf:type owl:Class ;
                      rdfs:subClassOf [ rdf:type owl:Restriction ;
                                        owl:onProperty martialis:basedOnSource ;
                                        owl:allValuesFrom martialis:Source
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty martialis:evidenceType ;
                                        owl:allValuesFrom skos:Concept
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty martialis:informationType ;
                                        owl:allValuesFrom skos:Concept
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty sdo:archivedAt ;
                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty sdo:url ;
                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty martialis:basedOnSource ;
                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty martialis:evidenceType ;
                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty martialis:informationType ;
                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty sdo:citation ;
                                        owl:allValuesFrom xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty martialis:quotation ;
                                        owl:allValuesFrom xsd:string
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty sdo:citation ;
                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty martialis:quotation ;
                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                      ] ;
                      rdfs:comment "Crediting a media item to a source; carries no supports semantics."@en ;
                      rdfs:label "Attribution" .


###  https://w3id.org/martialis/ontology#BirthEvent
martialis:BirthEvent rdf:type owl:Class ;
                     rdfs:subClassOf martialis:LifeEvent ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty sdo:location ;
                                       owl:allValuesFrom martialis:GeoRef
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty martialis:dateCalendar ;
                                       owl:allValuesFrom skos:Concept
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty martialis:hasEvidence ;
                                       owl:allValuesFrom martialis:SourceAssertionRelation
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty sdo:location ;
                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty martialis:dateCalendar ;
                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty sdo:startDate ;
                                       owl:allValuesFrom xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty martialis:dateOriginal ;
                                       owl:allValuesFrom xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty sdo:startDate ;
                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty martialis:dateOriginal ;
                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                     ] ;
                     rdfs:comment "A person's birth: its date, place and evidence."@en ;
                     rdfs:label "BirthEvent" .


###  https://w3id.org/martialis/ontology#Confidence
martialis:Confidence rdf:type owl:Class ;
                     rdfs:subClassOf prov:Entity ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty martialis:confidenceLevel ;
                                       owl:allValuesFrom skos:Concept
                                     ] ,
