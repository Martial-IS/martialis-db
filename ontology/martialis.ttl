martialis:quotation rdf:type owl:DatatypeProperty ;
                    rdfs:domain martialis:SourceAssertionRelation ;
                    rdfs:comment "The passage of the source that states the claim, transcribed verbatim: the source's words, order, case and punctuation. Editorial interventions are square-bracketed, as in standard transcription: [...] for an omission inside the passage, [sic] after an error in the source, and a short clarifying insertion where the excerpt would be unclear without it; never a fact the source does not state."@en ;
                    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                    rdfs:label "Zitat"@de ,
                               "cita"@es ,
                               "citation"@fr ,
                               "citação"@pt ,
                               "quotation"@en ,
                               "tilvitnun"@is ,
                               "引文"@zh ,
                               "引用"@ja .


###  https://w3id.org/martialis/ontology#rankOrdinal
martialis:rankOrdinal rdf:type owl:DatatypeProperty ;
                      rdfs:domain martialis:RankAssertion ;
                      rdfs:range xsd:integer ;
                      rdfs:comment "The grade number within a numbered RankingSystem (e.g. 6 for 6th dan). Mutually exclusive with martialis:rankGrade."@en ;
                      rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                      rdfs:label "Graduierungsnummer"@de ,
                                 "numéro de grade"@fr ,
                                 "númer gráðu"@is ,
                                 "número de graduación"@es ,
                                 "número de graduação"@pt ,
                                 "rank ordinal"@en ,
                                 "段位数"@ja ,
                                 "段位数"@zh .


###  https://w3id.org/martialis/ontology#rankingSystemKind
martialis:rankingSystemKind rdf:type owl:DatatypeProperty ;
                            rdfs:domain martialis:RankingSystem ;
                            rdfs:range xsd:string ;
                            rdfs:comment "'numbered' (an open-ended integer ladder, recorded as rankType/rankOrdinal) or 'enumerated' (a fixed ordered list of grades, a skos:ConceptScheme)."@en ;
                            rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                            rdfs:label "Art des Graduierungssystems"@de ,
                                       "ranking system kind"@en ,
                                       "tegund gráðukerfis"@is ,
                                       "tipo de sistema de graduación"@es ,
                                       "tipo de sistema de graduação"@pt ,
                                       "type de système de grades"@fr ,
                                       "段級制度種別"@ja ,
                                       "段级制度类型"@zh .


###  https://w3id.org/martialis/ontology#researchNote
martialis:researchNote rdf:type owl:DatatypeProperty ;
                       rdfs:comment "A curatorial note recording what is known, suspected, or still to be investigated about a record. Addressed to a maintainer, not a reader (YAML: notes)."@en ;
                       rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                       rdfs:label "Forschungsnotiz"@de ,
                                  "nota de investigación"@es ,
                                  "nota de investigação"@pt ,
                                  "note de recherche"@fr ,
                                  "rannsóknarathugasemd"@is ,
                                  "research note"@en ,
                                  "研究笔记"@zh ,
                                  "調査メモ"@ja ;
                       skos:closeMatch skos:editorialNote ;
                       sdo:domainIncludes martialis:Assertion ,
                                          martialis:Event ,
                                          martialis:Organization ,
                                          martialis:Person ,
                                          martialis:Place ,
                                          martialis:RankingSystem ,
                                          martialis:Source ,
                                          martialis:Style ,
                                          martialis:TeacherInteraction .


###  https://w3id.org/martialis/ontology#section
martialis:section rdf:type owl:DatatypeProperty ;
                  rdfs:domain martialis:Source ;
                  rdfs:comment "Section of the container in which this item appears (e.g. a newspaper section). CSL 'section'."@en ;
                  rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                  rdfs:label "Abschnitt"@de ,
                             "kafli"@is ,
                             "sección"@es ,
                             "section"@en ,
                             "section"@fr ,
                             "secção"@pt ,
                             "節"@ja ,
                             "节"@zh .


###  https://w3id.org/martialis/ontology#selfPublished
martialis:selfPublished rdf:type owl:DatatypeProperty ;
                        rdfs:domain martialis:Source ;
                        rdfs:range xsd:boolean ;
                        rdfs:comment "Whether the publisher and the contributor(s) are the same party. Preferably derived from the linked entities rather than asserted."@en ;
                        rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                        rdfs:label "auto-publicado"@pt ,
                                   "autoeditado"@es ,
                                   "autoédité"@fr ,
                                   "eigin útgáfa"@is ,
                                   "im Selbstverlag"@de ,
                                   "self published"@en ,
                                   "自費出版"@ja ,
                                   "自费出版"@zh .


###  https://w3id.org/martialis/ontology#sourceLocation
martialis:sourceLocation rdf:type owl:DatatypeProperty ;
                         rdfs:domain martialis:SourceAssertionRelation ;
                         rdfs:comment "Where the cited claim sits within the work (YAML: locator) - page number, timestamp, section, etc. Paired with martialis:sourceLocatorLabel."@en ;
                         rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                         rdfs:label "Fundstelle in der Quelle"@de ,
                                    "emplacement dans la source"@fr ,
                                    "localização na fonte"@pt ,
                                    "source location"@en ,
                                    "staðsetning í heimild"@is ,
                                    "ubicación en la fuente"@es ,
                                    "来源内位置"@zh ,
                                    "資料内位置"@ja .


###  https://w3id.org/martialis/ontology#sourceLocatorLabel
martialis:sourceLocatorLabel rdf:type owl:DatatypeProperty ;
                             rdfs:domain martialis:SourceAssertionRelation ;
                             rdfs:range xsd:string ;
                             dcterms:conformsTo <https://docs.citationstyles.org/en/stable/specification.html#locators> ;
                             rdfs:comment "What kind of locator martialis:sourceLocation is: CSL's citation-locator vocabulary (page, volume, chapter, folio, section, timestamp, ...). Optional."@en ;
                             rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                             rdfs:label "Art der Fundstelle"@de ,
                                        "source locator label"@en ,
                                        "tegund staðsetningar"@is ,
                                        "tipo de localización"@es ,
                                        "tipo de localização"@pt ,
                                        "type de localisation"@fr ,
                                        "ロケーター種別"@ja ,
                                        "定位类型"@zh .


###  https://w3id.org/martialis/ontology#sourceType
martialis:sourceType rdf:type owl:DatatypeProperty ;
                     rdfs:domain martialis:Source ;
                     rdfs:range xsd:string ;
                     dcterms:conformsTo <https://docs.citationstyles.org/en/stable/specification.html#appendix-iii-types> ;
                     rdfs:comment "The bibliographic form: a CSL-JSON item type, plus the extension 'website' (exported as CSL 'periodical'). Required on every Source except a dated state, which inherits it."@en ;
                     rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                     rdfs:label "Quellentyp"@de ,
                                "source type"@en ,
                                "tegund heimildar"@is ,
                                "tipo de fonte"@pt ,
                                "tipo de fuente"@es ,
                                "type de source"@fr ,
                                "来源类型"@zh ,
                                "資料種別"@ja .


###  https://w3id.org/martialis/ontology#startYear
martialis:startYear rdf:type owl:DatatypeProperty ;
                    rdfs:domain martialis:TimeInterval ;
                    rdfs:range xsd:integer ;
                    rdfs:comment "The start of a TimeInterval, as a bare integer year (xsd:integer rather than xsd:gYear)."@en ;
                    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                    rdfs:label "Anfangsjahr"@de ,
                               "année de début"@fr ,
                               "ano inicial"@pt ,
                               "año inicial"@es ,
                               "start year"@en ,
                               "upphafsár"@is ,
                               "开始年份"@zh ,
                               "開始年"@ja .


###  https://w3id.org/martialis/ontology#suffix
martialis:suffix rdf:type owl:DatatypeProperty ;
                 rdfs:range xsd:string ;
                 rdfs:comment "CSL name-variable suffix: a name part after the given name, such as 'Jr.' or 'III'. Not an honorific."@en ;
                 rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                 rdfs:label "Namenssuffix"@de ,
                            "suffix"@en ,
                            "suffixe"@fr ,
                            "sufijo"@es ,
                            "sufixo"@pt ,
                            "viðskeyti"@is ,
                            "后缀"@zh ,
                            "接尾辞"@ja .


###  https://w3id.org/martialis/ontology#supports
martialis:supports rdf:type owl:DatatypeProperty ;
                   rdfs:domain martialis:SourceAssertionRelation ;
                   rdfs:range xsd:boolean ;
                   rdfs:comment "Whether the source supports or contradicts the assertion (true/false)."@en ;
                   rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                   rdfs:label "apoia"@pt ,
                              "respalda"@es ,
                              "styður"@is ,
                              "stützt"@de ,
                              "supports"@en ,
                              "étaye"@fr ,
                              "支持"@zh ,
                              "支持する"@ja .


