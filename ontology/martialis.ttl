                                         "relation d’affiliation"@fr ,
                                         "relação de afiliação"@pt ,
                                         "tegund aðildar"@is ,
                                         "所属関係"@ja ,
                                         "隶属关系"@zh ;
                              martialis:conceptScheme <https://w3id.org/martialis/vocab/affiliation-relation> .


###  https://w3id.org/martialis/ontology#assertedStyle
martialis:assertedStyle rdf:type owl:ObjectProperty ;
                        rdfs:range martialis:Style ;
                        rdfs:comment "The style associated with a teacher-student assertion, denial, or document-transmission claim (assertedStyle)."@en ;
                        rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                        rdfs:label "asserted style"@en ,
                                   "behaupteter Stil"@de ,
                                   "estilo afirmado"@es ,
                                   "estilo afirmado"@pt ,
                                   "style affirmé"@fr ,
                                   "stíll sem fullyrðingin varðar"@is ,
                                   "主張された流派"@ja ,
                                   "所述流派"@zh ;
                        sdo:domainIncludes martialis:DocumentTransmissionAssertion ,
                                           martialis:TeacherAssertion .


###  https://w3id.org/martialis/ontology#assessedBy
martialis:assessedBy rdf:type owl:ObjectProperty ;
