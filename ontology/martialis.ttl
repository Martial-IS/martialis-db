###  https://w3id.org/martialis/ontology#rankGrade
martialis:rankGrade rdf:type owl:ObjectProperty ;
                    rdfs:domain martialis:RankAssertion ;
                    rdfs:range skos:Concept ;
                    rdfs:comment "The specific grade within an enumerated RankingSystem's scheme (e.g. Menkyo Kaiden). Mutually exclusive with martialis:rankOrdinal/rankType."@en ;
                    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                    rdfs:label "Graduierungsstufe"@de ,
                               "grade"@fr ,
                               "grado de la graduación"@es ,
                               "grau de graduação"@pt ,
                               "gráða"@is ,
