                                "evaluado por"@es ,
                                "metið af"@is ,
                                "évalué par"@fr ,
                                "評価者"@ja ,
                                "评估者"@zh .


###  https://w3id.org/martialis/ontology#atEvent
martialis:atEvent rdf:type owl:ObjectProperty ;
                  rdfs:range martialis:Event ;
                  rdfs:comment "Optional link from an assertion or life event to the canonical Event record(s) it took place at. Multivalued."@en ;
                  rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                  rdfs:label "at event"@en ,
                             "bei Veranstaltung"@de ,
                             "em evento"@pt ,
                             "en evento"@es ,
                             "lors de l’événement"@fr ,
                             "á viðburði"@is ,
                             "于活动"@zh ,
                             "行事にて"@ja ;
                  sdo:domainIncludes martialis:AffiliationAssertion ,
                                     martialis:DocumentTransmissionAssertion ,
                                     martialis:HonorAssertion ,
                                     martialis:LifeEvent ,
                                     martialis:RankAssertion ,
                                     martialis:TeacherInteraction .


