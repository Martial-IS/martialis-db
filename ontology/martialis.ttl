                              "tegund gráðu"@is ,
                              "tipo de graduación"@es ,
                              "tipo de graduação"@pt ,
                              "type de grade"@fr ,
                              "段位種別"@ja ,
                              "段位类型"@zh ;
                   martialis:conceptScheme <https://w3id.org/martialis/vocab/rank-type> .


