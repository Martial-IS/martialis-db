                                 "图片权利"@zh ,
                                 "画像の権利"@ja ;
                      sdo:domainIncludes martialis:Photo ,
                                         martialis:Video ;
                      martialis:conceptScheme <https://w3id.org/martialis/vocab/media-rights> .


