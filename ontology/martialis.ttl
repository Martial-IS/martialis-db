###  https://w3id.org/martialis/ontology#rankSystem
martialis:rankSystem rdf:type owl:ObjectProperty ;
                     rdfs:range martialis:RankingSystem ;
                     rdfs:comment "The RankingSystem a Style's practitioners are ranked in, or that a RankAssertion's rank belongs to. Absent on a Style means rank is unresearched."@en ;
                     rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                     rdfs:label "gráðukerfi sem fylgt er"@is ,
                                "rank system"@en ,
                                "sistema de graduación adoptado"@es ,
                                "sistema de graduação adotado"@pt ,
                                "système de grades adopté"@fr ,
