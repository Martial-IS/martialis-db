                                "採用段級制度"@ja ,
                                "采用的段级制度"@zh ;
                     sdo:domainIncludes martialis:RankAssertion ,
                                        martialis:Style .


###  https://w3id.org/martialis/ontology#rankType
martialis:rankType rdf:type owl:ObjectProperty ;
                   rdfs:domain martialis:RankAssertion ;
                   rdfs:range skos:Concept ;
                   rdfs:comment "Which half of a numbered ladder a grade is on: dan (ascending), kyu (descending), or dan_unspecified. Only meaningful for a 'numbered' system."@en ;
                   rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                   rdfs:label "Graduierungsart"@de ,
