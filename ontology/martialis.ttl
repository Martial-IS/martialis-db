                       rdfs:comment "Free-text date as given by the source, when it differs from the Gregorian-equivalent EDTF value in the paired date property. Paired with martialis:dateCalendar."@en ;
                       rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                       rdfs:label "Originaldatum"@de ,
