                                       owl:onProperty martialis:confidenceLevel ;
                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty martialis:assessedBy ;
                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty martialis:confidenceRationale ;
                                       owl:allValuesFrom xsd:string
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty martialis:confidenceRationale ;
                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                     ] ;
                     <http://purl.org/vocab/vann/example> "martialis:conf01 a martialis:Confidence ; martialis:confidenceLevel <https://w3id.org/martialis/vocab/confidence-level/probable> ; martialis:confidenceRationale \"Two independent secondary sources agree; no primary document located.\" ; martialis:assessedBy <https://martial.is/agent/JDP> ."@en ;
                     rdfs:comment "A confidence assessment applied to an assertion."@en ;
                     rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                     rdfs:label "Vertrauensbewertung"@de ,
                                "confiance"@fr ,
                                "confianza"@es ,
                                "confiança"@pt ,
                                "confidence"@en ,
                                "vissa"@is ,
                                "信頼度評価"@ja ,
                                "可信度评估"@zh .


