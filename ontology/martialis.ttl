###  https://w3id.org/martialis/ontology#TeacherAssertion
martialis:TeacherAssertion rdf:type owl:Class ;
                           rdfs:subClassOf martialis:Assertion ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty martialis:teacher ;
                                             owl:someValuesFrom martialis:Person
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty martialis:assertedStyle ;
                                             owl:allValuesFrom martialis:Style
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty martialis:hasConfidence ;
                                             owl:allValuesFrom martialis:Confidence
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty martialis:hasEvidence ;
                                             owl:allValuesFrom martialis:SourceAssertionRelation
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty martialis:hasInteraction ;
                                             owl:allValuesFrom martialis:TeacherInteraction
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty martialis:role ;
                                             owl:allValuesFrom skos:Concept
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty martialis:teacher ;
                                             owl:allValuesFrom martialis:Person
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty martialis:hasInteraction ;
                                             owl:minCardinality "1"^^xsd:nonNegativeInteger
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty martialis:hasConfidence ;
                                             owl:cardinality "1"^^xsd:nonNegativeInteger
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty martialis:assertedStyle ;
                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty martialis:role ;
                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty martialis:teacher ;
                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty martialis:researchNote ;
                                             owl:allValuesFrom xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty martialis:researchNote ;
                                             owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                           ] ;
                           <http://purl.org/vocab/vann/example> "UNIDENTIFIED TEACHER: ex:Student martialis:hasTeacherAssertion martialis:assertion02 . martialis:assertion02 a martialis:TeacherAssertion ; martialis:assertedStyle ex:Judo ; martialis:hasInteraction [ a martialis:TeacherInteraction ; martialis:interactionPlace ex:Kodokan ; martialis:interactionPeriod [ martialis:startYear 1958 ; martialis:endYear 1959 ] ; martialis:hasEvidence [ martialis:basedOnSource ex:CourseRecord ; martialis:supports true ] ] ."@en ,
                                                                "ex:Student martialis:hasTeacherAssertion martialis:assertion01 . martialis:assertion01 a martialis:TeacherAssertion ; martialis:teacher ex:Teacher ; martialis:assertedStyle ex:Shotokan ; martialis:hasInteraction [ a martialis:TeacherInteraction ; martialis:interactionPlace ex:HombuDojo ; martialis:interactionPeriod [ martialis:startYear 1962 ] ; martialis:hasEvidence [ martialis:basedOnSource ex:Interview1989 ; martialis:supports true ] ] ."@en ;
                           rdfs:comment "A claim that a person taught the subject a style. The teacher is martialis:teacher. With no teacher, the claim states that a teacher existed whom no source names: every interaction then needs a Place or Event anchor and a dated period, and no wasTaughtBy/teaches edge is materialized. A claim assessed doubtful or refuted stays a TeacherAssertion and gives no edge either. Evidence attaches to the interactions."@en ;
                           rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                           rdfs:label "Lehreraussage"@de ,
                                      "aserción de maestro"@es ,
                                      "assertion de professeur"@fr ,
                                      "asserção de professor"@pt ,
                                      "fullyrðing um kennara"@is ,
                                      "teacher assertion"@en ,
                                      "师徒关系断言"@zh ,
                                      "師弟関係アサーション"@ja .


