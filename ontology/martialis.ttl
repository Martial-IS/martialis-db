###  https://w3id.org/martialis/ontology#affiliationRelation
martialis:affiliationRelation rdf:type owl:ObjectProperty ;
                              rdfs:domain martialis:AffiliationAssertion ;
                              rdfs:range skos:Concept ;
                              rdfs:comment "Relation kind: member_of, branch_of, recognised_by (ties) or derived_from, split_from, merged_from, replaces, renamed_from (organization genealogy)."@en ;
