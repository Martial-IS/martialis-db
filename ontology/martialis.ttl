###  https://w3id.org/martialis/ontology#conferredBy
martialis:conferredBy rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf martialis:object ;
                      rdfs:range martialis:Organization ;
                      rdfs:comment "The organization that conferred the rank or honor."@en ;
                      rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                      rdfs:label "conferido por"@es ,
                                 "conferido por"@pt ,
                                 "conferred by"@en ,
                                 "conféré par"@fr ,
                                 "veitt af"@is ,
                                 "verliehen von"@de ,
                                 "授与団体"@ja ,
                                 "授予机构"@zh ;
                      sdo:domainIncludes martialis:HonorAssertion ,
                                         martialis:RankAssertion .


###  https://w3id.org/martialis/ontology#confidenceLevel
martialis:confidenceLevel rdf:type owl:ObjectProperty ;
                          rdfs:domain martialis:Confidence ;
                          rdfs:range skos:Concept ;
                          rdfs:comment "The curator's conclusion about the claim after weighing all its evidence: refuted, doubtful, possible, probable or confirmed, ordered by martialis:gradeOrdinal. A certainty scale only: contested evidence is carried by martialis:supports false, not by a level."@en ;
                          rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                          rdfs:label "Vertrauensstufe"@de ,
                                     "confidence level"@en ,
                                     "niveau de confiance"@fr ,
                                     "nivel de confianza"@es ,
                                     "nível de confiança"@pt ,
                                     "vissustig"@is ,
                                     "信頼度"@ja ,
                                     "可信度"@zh ;
                          martialis:conceptScheme <https://w3id.org/martialis/vocab/confidence-level> .


