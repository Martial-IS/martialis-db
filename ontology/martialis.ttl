                         rdfs:range martialis:Person ;
                         rdfs:comment "Direct candidate-identity edge, materialized symmetrically at export time from IdentityAssertions. Deliberately weaker than owl:sameAs. Built from every claim not assessed doubtful or refuted: possible, probable or confirmed. The assertion carries the evidence and the level."@en ;
                         rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                         rdfs:label "hugsanlega sama og"@is ,
                                    "möglicherweise identisch mit"@de ,
                                    "peut-être identique à"@fr ,
                                    "posiblemente el mismo que"@es ,
                                    "possibly same as"@en ,
                                    "possivelmente o mesmo que"@pt ,
                                    "可能为同一人"@zh ,
                                    "同一人物の可能性"@ja .


###  https://w3id.org/martialis/ontology#primaryImage
martialis:primaryImage rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf sdo:image ;
                       rdfs:range martialis:Photo ;
                       rdfs:comment "The single primary depiction of an entity. The multivalued photos gallery uses schema:image; a single-valued slot cannot share that IRI without its maxCount 1 shape firing on the gallery."@en ;
                       rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                       rdfs:label "Hauptbild"@de ,
                                  "aðalmynd"@is ,
                                  "image principale"@fr ,
                                  "imagem principal"@pt ,
                                  "imagen principal"@es ,
                                  "primary image"@en ,
                                  "主图"@zh ,
                                  "主画像"@ja ;
                       sdo:domainIncludes martialis:Person ,
                                          martialis:Source .


###  https://w3id.org/martialis/ontology#publisherOrg
martialis:publisherOrg rdf:type owl:ObjectProperty ;
                       rdfs:domain martialis:Source ;
                       rdfs:range martialis:Organization ;
                       rdfs:comment "Links a Source's publisher to its own Organization entry, when one exists."@en ;
                       rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
