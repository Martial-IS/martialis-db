                                         "師弟関係アサーションを有する"@ja .


###  https://w3id.org/martialis/ontology#hasVariant
martialis:hasVariant rdf:type owl:ObjectProperty ;
                     owl:inverseOf martialis:variantOf ;
                     rdfs:domain martialis:Style ;
                     rdfs:range martialis:Style ;
                     rdfs:comment "Direct broader-to-narrower style edge, materialized at export time alongside variantOf. Built from every claim not assessed doubtful or refuted: possible, probable or confirmed. The assertion carries the evidence and the level."@en ;
                     rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                     rdfs:label "a pour variante"@fr ,
                                "has variant"@en ,
                                "hat Variante"@de ,
                                "hefur afbrigði"@is ,
                                "tem variante"@pt ,
                                "tiene variante"@es ,
                                "亜流を有する"@ja ,
                                "具有分支流派"@zh ;
                     skos:broadMatch skos:narrower .


