                               "段級位"@ja ,
                               "段级位"@zh ;
                    martialis:conceptScheme rankgrade:bjj ,
                                            rankgrade:menkyo ,
                                            rankgrade:unified-sports-classification .


###  https://w3id.org/martialis/ontology#rankStyle
martialis:rankStyle rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf martialis:object ;
                    rdfs:comment "The style the rank is in."@en ;
