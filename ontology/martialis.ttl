                               "流派種別"@ja ,
                               "流派类型"@zh ;
                    martialis:conceptScheme <https://w3id.org/martialis/vocab/style-classification> .


###  https://w3id.org/martialis/ontology#taughtAt
martialis:taughtAt rdf:type owl:ObjectProperty ;
                   rdfs:domain martialis:Person ;
                   rdfs:range martialis:Place ;
                   rdfs:comment "Materialized at export time from TeacherAssertion interactions: this person taught at this place at least once. Descriptive only, not a staffing claim. Built from every claim not assessed doubtful or refuted: possible, probable or confirmed. The assertion carries the evidence and the level."@en ;
                   rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                   rdfs:label "a enseigné à"@fr ,
                              "enseñó en"@es ,
                              "ensinou em"@pt ,
                              "kenndi við"@is ,
                              "lehrte an"@de ,
                              "taught at"@en ,
                              "执教地点"@zh ,
                              "指導場所"@ja .


###  https://w3id.org/martialis/ontology#teacher
martialis:teacher rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf martialis:object ;
                  rdfs:comment "The teacher. Omit it when no source identifies the teacher; every interaction then needs a Place or Event anchor and a dated period."@en ;
                  rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
                  rdfs:label "Lehrer"@de ,
                             "kennari"@is ,
