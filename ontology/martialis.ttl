                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty sdo:contentUrl ;
                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty martialis:imageAttribution ;
                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty martialis:mediaRights ;
                                  owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                ] ;
                rdfs:comment "A video file about an entity: its URL, its attribution to a source and its rights status."@en ;
