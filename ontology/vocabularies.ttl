    skos:definition "The second competitive rank of the Unified Sports Classification System."@en .

rankgrade:ussc_class_1 a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/unified-sports-classification> ;
    skos:notation "ussc_class_1" ; martialis:gradeOrdinal 3 ;
    skos:prefLabel "First-Class Sportsman"@en , "Desportista de 1.ª Classe"@pt , "Deportista de 1.ª clase"@es , "Sportif de 1re classe"@fr , "Sportler 1. Klasse"@de , "Íþróttamaður í 1. flokki"@is , "スポーツ1級"@ja , "一级运动员"@zh ;
    skos:definition "The third competitive rank of the Unified Sports Classification System."@en ;
    skos:scopeNote "Roughly equates to a regional champion."@en .

rankgrade:ussc_candidate_master a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/unified-sports-classification> ;
    skos:notation "ussc_candidate_master" ; martialis:gradeOrdinal 4 ;
    skos:prefLabel "Candidate Master of Sport"@en , "Candidato a Mestre do Desporto"@pt , "Candidato a Maestro del Deporte"@es , "Candidat maître des sports"@fr , "Kandidat für Meister des Sports"@de , "Kandídat til meistaratignar í íþróttum"@is , "スポーツマスター候補"@ja , "运动健将候补"@zh ;
    skos:altLabel "Candidate for Master of Sport"@en ;
    skos:definition "The fourth competitive rank of the Unified Sports Classification System."@en ;
    skos:scopeNote "Roughly equates to a nationally ranked competitor."@en .

rankgrade:ussc_master a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/unified-sports-classification> ;
    skos:notation "ussc_master" ; martialis:gradeOrdinal 5 ;
    skos:prefLabel "Master of Sport"@en , "Mestre do Desporto"@pt , "Maestro del Deporte"@es , "Maître des sports"@fr , "Meister des Sports"@de , "Meistari í íþróttum"@is , "スポーツマスター"@ja , "运动健将"@zh ;
    skos:altLabel "Master of Sports"@en , "Master of Sports of the USSR"@en ;
    skos:definition "A national-level title, awarded for meeting fixed competitive standards."@en .

rankgrade:ussc_master_international a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/unified-sports-classification> ;
    skos:notation "ussc_master_international" ; martialis:gradeOrdinal 6 ;
    skos:prefLabel "Master of Sport, International Class"@en , "Mestre do Desporto Internacional"@pt , "Maestro del Deporte de clase internacional"@es , "Maître des sports de classe internationale"@fr , "Meister des Sports, internationale Klasse"@de , "Meistari í íþróttum, alþjóðaflokkur"@is , "国際級スポーツマスター"@ja , "国际级运动健将"@zh ;
    skos:altLabel "International Master of Sport"@en ;
    skos:definition "The tier above Master of Sport, for international-level results."@en .

rankgrade:ussc_honoured_master a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/unified-sports-classification> ;
    skos:notation "ussc_honoured_master" ; martialis:gradeOrdinal 7 ;
    skos:prefLabel "Honoured Master of Sport"@en , "Mestre Emérito do Desporto"@pt , "Maestro Emérito del Deporte"@es , "Maître émérite des sports"@fr , "Verdienter Meister des Sports"@de , "Heiðursmeistari í íþróttum"@is , "名誉スポーツマスター"@ja , "荣誉运动健将"@zh ;
    skos:altLabel "Merited Master of Sport"@en , "Honored Master of Sports"@en , "Distinguished Master of Sport"@en , "Honored Master of Sports of the USSR"@en ;
    skos:definition "The highest tier of the Unified Sports Classification System, a state honour rather than a purely competitive standard."@en .

# ---- country ----
# Local country-code exceptions not covered by the EU Publications Office authority.
<https://w3id.org/martialis/vocab/country> a skos:ConceptScheme ;
    dcterms:title "Martialis Country Exceptions Vocabulary"@en ;
    dcterms:description "Country/region codes used in database/ that the EU Publications Office's country authority table does not cover: local extensions under ISO 3166-1's user-assigned code ranges."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:creator <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:publisher <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:rightsHolder <https://orcid.org/0009-0000-9488-3542> ;
    skos:scopeNote "Local exceptions only. Every other country is the EU Publications Office country authority IRI itself (eucountry:), used directly. An entity with no country has no schema:addressCountry value."@en ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "country" ;
    vann:preferredNamespaceUri <https://w3id.org/martialis/vocab/country/> ;
    skos:hasTopConcept country:XRY .

country:XRY a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/country> ;
    skos:notation "XRY" ;
    skos:prefLabel "Ryukyu Kingdom"@en , "Reino de Ryukyu"@pt , "Reino de Ryukyu"@es , "Royaume de Ryukyu"@fr , "Königreich Ryukyu"@de , "Ryukyu-konungsríkið"@is , "琉球王国"@ja , "琉球王国"@zh ;
    skos:broadMatch <http://publications.europa.eu/resource/authority/country/JPN> ;
    skos:historyNote "Independent kingdom until its annexation by Japan in 1879 (formalised as Okinawa Prefecture); has no ISO 3166 code of its own. XRY is assigned under ISO 3166-1's user-assigned alpha-3 range (X.. ), not an official code."@en ;
    skos:definition "Local code for lineage claims specifically attributed to the pre-annexation Ryukyu Kingdom rather than modern Japan."@en .

# ---- media-rights ----
# One axis mixing Creative Commons licences with rightsstatements.org
# statements, the same approach Europeana's edm:rights takes. SPDX alone
# cannot cover this: SPDX has identifiers for CC-BY-SA-4.0 and CC0-1.0 but
# none for "in copyright" or "not yet evaluated", which is the common case
# for third-party media referenced by URL. SPDX ids ride along as
# skos:altLabel on the CC concepts, for continuity with REUSE.toml.
# rightsstatements.org's CNE ("Copyright Not Evaluated") is deliberately not
# minted: martialis:mediaRights is optional, so absence already means
# "not evaluated" and a concept for that would just be a second spelling of
# absence.
<https://w3id.org/martialis/vocab/media-rights> a skos:ConceptScheme ;
    dcterms:title "Martialis Media Rights Vocabulary"@en ;
    dcterms:description "Copyright or licence status of a Photo or Video's own content: a Creative Commons licence where one was granted, a Public Domain Mark, or a rightsstatements.org copyright statement. Absence of a value means the status has not been evaluated."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:creator <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:publisher <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:rightsHolder <https://orcid.org/0009-0000-9488-3542> ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "mediarights" ;
    vann:preferredNamespaceUri <https://w3id.org/martialis/vocab/media-rights/> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#mediaRights> ;
    skos:hasTopConcept mediarights:public_domain_mark , mediarights:cc0-1.0 ,
        mediarights:cc-by-2.0 , mediarights:cc-by-2.5 , mediarights:cc-by-3.0 ,
        mediarights:cc-by-4.0 , mediarights:cc-by-sa-2.0 , mediarights:cc-by-sa-2.5 ,
        mediarights:cc-by-sa-3.0 , mediarights:cc-by-sa-3.0-de , mediarights:cc-by-sa-3.0-nl , mediarights:cc-by-sa-2.0-at ,
        mediarights:cc-by-sa-4.0 , mediarights:attribution ,
        mediarights:in_copyright , mediarights:no_known_copyright ,
        mediarights:copyright_undetermined .

mediarights:public_domain_mark a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/media-rights> ;
    skos:inScheme <https://w3id.org/martialis/vocab/media-rights> ;
    skos:notation "public_domain_mark" ;
    skos:prefLabel "Public Domain"@en , "Domínio Público"@pt , "Dominio público"@es , "Domaine public"@fr , "Gemeinfrei"@de , "Almenningseign"@is , "パブリックドメイン"@ja , "公有领域"@zh ;
    skos:altLabel "Public Domain Mark"@en , "Marca de Domínio Público"@pt , "Marca de Dominio Público"@es , "Marque du domaine public"@fr , "Public-Domain-Markierung"@de , "Merki um almenning"@is , "パブリックドメインマーク"@ja , "公共领域标志"@zh ;
    skos:definition "The work is identified as being free of known copyright restrictions."@en ;
    skos:scopeNote "A labelling mark, not a licence: it asserts no rights were found, not that any were waived."@en ;
    skos:exactMatch <https://creativecommons.org/publicdomain/mark/1.0/> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#mediaRights> .

