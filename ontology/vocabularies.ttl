    skos:definition "A single bout or a linked series of fights between named parties or schools (a challenge match, a cross-style contest such as the Kodokan vs Totsuka rivalry)."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#eventType> .

eventclass:seminar a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/event-classification> ;
    skos:inScheme <https://w3id.org/martialis/vocab/event-classification> ;
    skos:notation "seminar" ;
    skos:prefLabel "Seminar"@en , "Seminário"@pt , "Seminario"@es , "Stage"@fr , "Seminar"@de , "Námskeið"@is , "講習会"@ja , "讲习会"@zh ;
    skos:altLabel "Workshop"@en , "Oficina"@pt ;
    skos:definition "A short instructional gathering, usually led by a visiting or guest instructor."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#eventType> .

eventclass:course a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/event-classification> ;
    skos:inScheme <https://w3id.org/martialis/vocab/event-classification> ;
    skos:notation "course" ;
    skos:prefLabel "Course"@en , "Curso"@pt , "Curso"@es , "Formation"@fr , "Kurs"@de , "Námsbraut"@is , "課程"@ja , "课程"@zh ;
    skos:definition "A structured instructional programme spanning multiple sessions (a term course, an intensive training course)."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#eventType> .

eventclass:demonstration a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/event-classification> ;
    skos:inScheme <https://w3id.org/martialis/vocab/event-classification> ;
    skos:notation "demonstration" ;
    skos:prefLabel "Demonstration"@en , "Demonstração"@pt , "Demostración"@es , "Démonstration"@fr , "Vorführung"@de , "Sýning"@is , "演武"@ja , "演武"@zh ;
    skos:definition "A non-competitive technical demonstration."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#eventType> .

eventclass:grading a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/event-classification> ;
    skos:inScheme <https://w3id.org/martialis/vocab/event-classification> ;
    skos:notation "grading" ;
    skos:prefLabel "Grading"@en , "Exame de graduação"@pt , "Examen de graduación"@es , "Passage de grade"@fr , "Gürtelprüfung"@de , "Gráðupróf"@is , "昇段審査"@ja , "晋级考核"@zh ;
    skos:altLabel "Promotion"@en , "Promoção"@pt ;
    skos:definition "A rank examination or promotion event."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#eventType> .

eventclass:ceremony a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/event-classification> ;
    skos:inScheme <https://w3id.org/martialis/vocab/event-classification> ;
    skos:notation "ceremony" ;
    skos:prefLabel "Ceremony"@en , "Cerimónia"@pt , "Ceremonia"@es , "Cérémonie"@fr , "Zeremonie"@de , "Athöfn"@is , "式典"@ja , "仪式"@zh ;
    skos:definition "A formal commemorative or award ceremony (anniversaries, hall-of-fame inductions, dojo openings)."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#eventType> .

eventclass:recognition a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/event-classification> ;
    skos:inScheme <https://w3id.org/martialis/vocab/event-classification> ;
    skos:notation "recognition" ;
    skos:prefLabel "Recognition"@en , "Reconhecimento"@pt , "Reconocimiento"@es , "Reconnaissance"@fr , "Anerkennung"@de , "Viðurkenning"@is , "認定"@ja , "认可"@zh ;
    skos:definition "A formal recognition act by another body."@en ;
    skos:example "A governing body recognising a style or organization."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#eventType> .

eventclass:exchange a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/event-classification> ;
    skos:inScheme <https://w3id.org/martialis/vocab/event-classification> ;
    skos:notation "exchange" ;
    skos:prefLabel "Exchange"@en , "Intercâmbio"@pt , "Intercambio"@es , "Échange"@fr , "Austausch"@de , "Skiptiheimsókn"@is , "交流"@ja , "交流"@zh ;
    skos:definition "An exchange visit or delegation programme."@en ;
    skos:example "The SAC Judo programme sending US airmen to train in Tokyo."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#eventType> .

eventclass:other a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/event-classification> ;
    skos:inScheme <https://w3id.org/martialis/vocab/event-classification> ;
    skos:notation "other" ;
    skos:prefLabel "Other"@en , "Outro"@pt , "Otro"@es , "Autre"@fr , "Sonstiges"@de , "Annað"@is , "その他"@ja , "其他"@zh ;
    skos:definition "None of the other values apply."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#eventType> .

# ---- event-role ----
<https://w3id.org/martialis/vocab/event-role> a skos:ConceptScheme ;
    dcterms:title "Martialis Event Role Vocabulary"@en ;
    dcterms:description "The role an agent played in an Event, recorded on Participation nodes via martialis:participationRole. Agents may be persons or organizations (a team as competitor, a delegation as demonstrator). instructor covers the teaching role of course/seminar events; a student's attendance is a TeacherAssertion on the student's own record, linked to the event with martialis:atEvent. Distinct from the teacher-role scheme (student-teacher relationship modes)."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:creator <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:publisher <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:rightsHolder <https://orcid.org/0009-0000-9488-3542> ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "eventrole" ;
    vann:preferredNamespaceUri <https://w3id.org/martialis/vocab/event-role/> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#participationRole> ;
    skos:hasTopConcept eventrole:competitor , eventrole:official , eventrole:organizer , eventrole:demonstrator , eventrole:guest , eventrole:instructor , eventrole:signatory , eventrole:other .

eventrole:competitor a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/event-role> ;
    skos:inScheme <https://w3id.org/martialis/vocab/event-role> ;
    skos:notation "competitor" ;
    skos:prefLabel "Competitor"@en , "Competidor"@pt , "Competidor"@es , "Compétiteur"@fr , "Wettkämpfer"@de , "Keppandi"@is , "競技者"@ja , "参赛者"@zh ;
    skos:definition "A person taking part in the event competitively."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#participationRole> .

eventrole:official a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/event-role> ;
    skos:inScheme <https://w3id.org/martialis/vocab/event-role> ;
    skos:notation "official" ;
    skos:prefLabel "Official"@en , "Oficial"@pt , "Árbitro"@es , "Arbitre"@fr , "Kampfrichter"@de , "Dómari"@is , "審判"@ja , "裁判"@zh ;
    skos:altLabel "Referee"@en , "Judge"@en , "Árbitro"@pt , "Juiz"@pt ;
    skos:definition "A person officiating the event: a referee, judge, or similar adjudicating role."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#participationRole> .

eventrole:organizer a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/event-role> ;
    skos:inScheme <https://w3id.org/martialis/vocab/event-role> ;
    skos:notation "organizer" ;
    skos:prefLabel "Organizer"@en , "Organizador"@pt , "Organizador"@es , "Organisateur"@fr , "Organisator"@de , "Skipuleggjandi"@is , "主催者"@ja , "组织者"@zh ;
    skos:definition "A person organizing or running the event."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#participationRole> .

eventrole:demonstrator a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/event-role> ;
    skos:inScheme <https://w3id.org/martialis/vocab/event-role> ;
    skos:notation "demonstrator" ;
    skos:prefLabel "Demonstrator"@en , "Demonstrador"@pt , "Demostrador"@es , "Démonstrateur"@fr , "Vorführender"@de , "Sýnandi"@is , "演武者"@ja , "演示者"@zh ;
    skos:definition "A person demonstrating technique at the event."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#participationRole> .

eventrole:guest a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/event-role> ;
    skos:inScheme <https://w3id.org/martialis/vocab/event-role> ;
    skos:notation "guest" ;
    skos:prefLabel "Guest"@en , "Convidado"@pt , "Invitado"@es , "Invité"@fr , "Gast"@de , "Gestur"@is , "ゲスト"@ja , "嘉宾"@zh ;
    skos:definition "An invited participant in a non-competitive capacity."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#participationRole> .

eventrole:instructor a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/event-role> ;
    skos:inScheme <https://w3id.org/martialis/vocab/event-role> ;
    skos:notation "instructor" ;
    skos:prefLabel "Instructor"@en , "Instrutor"@pt , "Instructor"@es , "Enseignant"@fr , "Lehrer"@de , "Leiðbeinandi"@is , "指導者"@ja , "教练"@zh ;
    skos:definition "A person teaching at the event: the instructor of a course or seminar."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#participationRole> .

eventrole:signatory a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/event-role> ;
    skos:inScheme <https://w3id.org/martialis/vocab/event-role> ;
    skos:notation "signatory" ;
    skos:prefLabel "Signatory"@en , "Signatário"@pt , "Firmante"@es , "Signataire"@fr , "Unterzeichner"@de , "Undirritari"@is , "署名者"@ja , "签署人"@zh ;
    skos:definition "A person who signed the petition, declaration or other document the event records."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#participationRole> .

eventrole:other a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/event-role> ;
    skos:inScheme <https://w3id.org/martialis/vocab/event-role> ;
    skos:notation "other" ;
    skos:prefLabel "Other"@en , "Outro"@pt , "Otro"@es , "Autre"@fr , "Sonstiges"@de , "Annað"@is , "その他"@ja , "其他"@zh ;
    skos:definition "None of the other values apply."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#participationRole> .

# ---- confidence-level ----
<https://w3id.org/martialis/vocab/confidence-level> a skos:ConceptScheme ;
    dcterms:title "Martialis Confidence Level Vocabulary"@en ;
    dcterms:description "The curator's conclusion about a claim after weighing all its evidence: an ordered certainty scale, ascending by martialis:gradeOrdinal. Contestedness is not a level: it is carried by evidence with martialis:supports false."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:creator <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:publisher <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:rightsHolder <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:bibliographicCitation "Board for Certification of Genealogists. Genealogy Standards, 2nd ed. (Genealogical Proof Standard); Mills, Elizabeth Shown. Evidence Explained: Citing History Sources from Artifacts to Cyberspace. Baltimore: Genealogical Publishing Company." ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "conflevel" ;
    vann:preferredNamespaceUri <https://w3id.org/martialis/vocab/confidence-level/> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#confidenceLevel> ;
    skos:hasTopConcept conflevel:refuted , conflevel:doubtful , conflevel:possible , conflevel:probable , conflevel:confirmed .

conflevel:refuted a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/confidence-level> ;
    skos:inScheme <https://w3id.org/martialis/vocab/confidence-level> ;
    skos:notation "refuted" ; martialis:gradeOrdinal -1 ;
    skos:prefLabel "Refuted"@en , "Refutado"@pt , "Refutado"@es , "Réfuté"@fr , "Widerlegt"@de , "Hrakið"@is , "反証済み"@ja , "已证伪"@zh ;
    skos:definition "The evidence establishes that the claim is false: it is incompatible with the claim, and nothing credible supports it."@en ;
    skos:scopeNote "Typical of an anachronism, an impossibility, or the other party's own record denying the claim. The absence of an expected record alone does not refute a claim: that is doubtful."@en ;
    skos:closeMatch <http://gedcomx.org/Low> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#confidenceLevel> .

conflevel:doubtful a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/confidence-level> ;
    skos:inScheme <https://w3id.org/martialis/vocab/confidence-level> ;
    skos:notation "doubtful" ; martialis:gradeOrdinal 0 ;
    skos:prefLabel "Doubtful"@en , "Duvidoso"@pt , "Dudoso"@es , "Douteux"@fr , "Zweifelhaft"@de , "Vafasamt"@is , "疑わしい"@ja , "存疑"@zh ;
    skos:definition "A source makes the claim, but the evidence does not substantiate it."@en ;
    skos:scopeNote "Typical of a founding legend, or an attribution that no independent record accommodates. Evidence incompatible with the claim, such as an anachronism, makes it refuted."@en ;
    skos:closeMatch <http://gedcomx.org/Low> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#confidenceLevel> .

conflevel:possible a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/confidence-level> ;
    skos:inScheme <https://w3id.org/martialis/vocab/confidence-level> ;
    skos:notation "possible" ; martialis:gradeOrdinal 1 ;
    skos:prefLabel "Possible"@en , "Possível"@pt , "Posible"@es , "Possible"@fr , "Möglich"@de , "Mögulegt"@is , "可能性あり"@ja , "可能"@zh ;
    skos:definition "Some evidence points to the claim, but it is thin, indirect, or in unresolved conflict with other evidence."@en ;
    skos:closeMatch <http://gedcomx.org/Low> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#confidenceLevel> .

conflevel:probable a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/confidence-level> ;
    skos:inScheme <https://w3id.org/martialis/vocab/confidence-level> ;
    skos:notation "probable" ; martialis:gradeOrdinal 2 ;
    skos:prefLabel "Probable"@en , "Provável"@pt , "Probable"@es , "Probable"@fr , "Wahrscheinlich"@de , "Líklegt"@is , "可能性が高い"@ja , "很可能"@zh ;
    skos:definition "The evidence favours the claim and nothing credible contradicts it, but it falls short of establishing it."@en ;
    skos:closeMatch <http://gedcomx.org/Medium> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#confidenceLevel> .

conflevel:confirmed a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/confidence-level> ;
    skos:inScheme <https://w3id.org/martialis/vocab/confidence-level> ;
    skos:notation "confirmed" ; martialis:gradeOrdinal 3 ;
    skos:prefLabel "Confirmed"@en , "Confirmado"@pt , "Confirmado"@es , "Confirmé"@fr , "Bestätigt"@de , "Staðfest"@is , "確認済み"@ja , "已确认"@zh ;
    skos:definition "The evidence establishes the claim: it is sufficient and consistent, and any conflicting evidence is resolved."@en ;
    skos:scopeNote "Typically direct evidence with primary information, or independent sources in agreement."@en ;
    skos:closeMatch <http://gedcomx.org/High> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#confidenceLevel> .

# ---- historicity ----
<https://w3id.org/martialis/vocab/historicity> a skos:ConceptScheme ;
    dcterms:title "Martialis Historicity Vocabulary"@en ;
    dcterms:description "Whether the subject of a Person record existed as one historical individual. Recorded only when a source questions it; each reading is a separate claim with its own evidence and confidence."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:creator <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:publisher <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:rightsHolder <https://orcid.org/0009-0000-9488-3542> ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "hist" ;
    vann:preferredNamespaceUri <https://w3id.org/martialis/vocab/historicity/> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#historicity> ;
    skos:hasTopConcept hist:historical , hist:legendary , hist:composite , hist:title .

hist:historical a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/historicity> ;
    skos:inScheme <https://w3id.org/martialis/vocab/historicity> ;
    skos:notation "historical" ;
    skos:prefLabel "Historical figure"@en , "Figura histórica"@pt , "Figura histórica"@es , "Figure historique"@fr , "Historische Person"@de , "Söguleg persóna"@is , "実在の人物"@ja , "历史人物"@zh ;
    skos:definition "The subject existed as one individual."@en ;
    skos:scopeNote "Records the answer when a source disputes the subject's existence and the evidence supports it."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#historicity> .

hist:legendary a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/historicity> ;
    skos:inScheme <https://w3id.org/martialis/vocab/historicity> ;
    skos:notation "legendary" ;
    skos:prefLabel "Legendary figure"@en , "Figura lendária"@pt , "Figura legendaria"@es , "Figure légendaire"@fr , "Legendäre Gestalt"@de , "Goðsagnapersóna"@is , "伝説上の人物"@ja , "传说人物"@zh ;
    skos:definition "The subject is known from legend or tradition that presents them as historical, and their existence is not established."@en ;
    skos:scopeNote "Typical of a founding figure known only from the tradition that the founding produced."@en ;
    skos:closeMatch <http://www.wikidata.org/entity/Q13002315> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#historicity> .

hist:composite a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/historicity> ;
    skos:inScheme <https://w3id.org/martialis/vocab/historicity> ;
    skos:notation "composite" ;
    skos:prefLabel "Composite figure"@en , "Figura compósita"@pt , "Figura compuesta"@es , "Figure composite"@fr , "Zusammengesetzte Gestalt"@de , "Samsett persóna"@is , "複合的人物"@ja , "复合人物"@zh ;
    skos:definition "The record stands for a figure made from the accounts of more than one individual."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#historicity> .

hist:title a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/historicity> ;
    skos:inScheme <https://w3id.org/martialis/vocab/historicity> ;
    skos:notation "title" ;
    skos:prefLabel "Title or office"@en , "Título ou cargo"@pt , "Título o cargo"@es , "Titre ou charge"@fr , "Titel oder Amt"@de , "Titill eða embætti"@is , "称号・名跡"@ja , "称号或职位"@zh ;
    skos:definition "The name is a title, an office or an inherited name held by more than one individual, not the name of one person."@en ;
    skos:scopeNote "When the sources tell the holders apart, record each holder as a separate Person."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#historicity> .

# ---- source-classification ----
<https://w3id.org/martialis/vocab/source-classification> a skos:ConceptScheme ;
    dcterms:title "Martialis Source Classification Vocabulary"@en ;
    dcterms:description "A Source's physical form relative to the record it carries, after Mills' source classification. A fact about the Source, set once on the Source record."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:creator <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:publisher <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:rightsHolder <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:bibliographicCitation "Mills, Elizabeth Shown. Evidence Explained: Citing History Sources from Artifacts to Cyberspace. Baltimore: Genealogical Publishing Company (the Evidence Analysis Process Model: source, information, evidence)." ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "srcclass" ;
    vann:preferredNamespaceUri <https://w3id.org/martialis/vocab/source-classification/> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#sourceClassification> ;
    skos:hasTopConcept srcclass:original , srcclass:derivative , srcclass:authored .

srcclass:original a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/source-classification> ;
    skos:inScheme <https://w3id.org/martialis/vocab/source-classification> ;
    skos:notation "original" ;
    skos:prefLabel "Original"@en , "Original"@pt , "Original"@es , "Originale"@fr , "Original"@de , "Frumrit"@is , "原資料"@ja , "原始资料"@zh ;
    skos:definition "The first record of its content, not copied or compiled from an earlier record."@en ;
    skos:example "A dated licence scroll, a certificate, a register, a letter, a recorded interview."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#sourceClassification> .

srcclass:derivative a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/source-classification> ;
    skos:inScheme <https://w3id.org/martialis/vocab/source-classification> ;
    skos:notation "derivative" ;
    skos:prefLabel "Derivative"@en , "Derivada"@pt , "Derivada"@es , "Dérivée"@fr , "Abgeleitet"@de , "Afleitt rit"@is , "派生資料"@ja , "派生资料"@zh ;
    skos:definition "A copy, transcript, abstract, translation or database entry made from an earlier record."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#sourceClassification> .

srcclass:authored a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/source-classification> ;
    skos:inScheme <https://w3id.org/martialis/vocab/source-classification> ;
    skos:notation "authored" ;
    skos:prefLabel "Authored"@en , "Autoral"@pt , "De autor"@es , "D’auteur"@fr , "Verfasst"@de , "Samið rit"@is , "著作資料"@ja , "著述资料"@zh ;
    skos:definition "A narrative or compilation an author wrote from other records, memory, or tradition."@en ;
    skos:example "A book, an article, a school history, an encyclopedia entry."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#sourceClassification> .

# ---- information-type ----
<https://w3id.org/martialis/vocab/information-type> a skos:ConceptScheme ;
    dcterms:title "Martialis Information Type Vocabulary"@en ;
    dcterms:description "The informant's proximity to the specific fact a citation supports, after Mills' information classification. Set per citation: one source can give primary information on one fact and secondary on another."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:creator <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:publisher <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:rightsHolder <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:bibliographicCitation "Mills, Elizabeth Shown. Evidence Explained: Citing History Sources from Artifacts to Cyberspace. Baltimore: Genealogical Publishing Company (the Evidence Analysis Process Model: source, information, evidence)." ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "infotype" ;
    vann:preferredNamespaceUri <https://w3id.org/martialis/vocab/information-type/> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#informationType> ;
    skos:hasTopConcept infotype:primary , infotype:secondary , infotype:undetermined .

infotype:primary a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/information-type> ;
    skos:inScheme <https://w3id.org/martialis/vocab/information-type> ;
    skos:notation "primary" ;
    skos:prefLabel "Primary"@en , "Primária"@pt , "Primaria"@es , "Primaire"@fr , "Primär"@de , "Fyrsta stigs"@is , "一次情報"@ja , "一手信息"@zh ;
    skos:definition "Given by someone with first-hand knowledge of the fact."@en ;
    skos:scopeNote "The subject's own words about their training, a teacher's own grant, a witness to the event."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#informationType> .

infotype:secondary a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/information-type> ;
    skos:inScheme <https://w3id.org/martialis/vocab/information-type> ;
    skos:notation "secondary" ;
    skos:prefLabel "Secondary"@en , "Secundária"@pt , "Secundaria"@es , "Secondaire"@fr , "Sekundär"@de , "Annars stigs"@is , "二次情報"@ja , "二手信息"@zh ;
    skos:definition "Given by someone who learned the fact from others."@en ;
    skos:scopeNote "A historian's account, a later biography, an encyclopedia, a lineage's retelling of its own past."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#informationType> .

infotype:undetermined a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/information-type> ;
    skos:inScheme <https://w3id.org/martialis/vocab/information-type> ;
    skos:notation "undetermined" ;
    skos:prefLabel "Undetermined"@en , "Indeterminada"@pt , "Indeterminada"@es , "Indéterminée"@fr , "Unbestimmt"@de , "Óákvarðað"@is , "不明"@ja , "不明"@zh ;
    skos:definition "Assessed, but the informant cannot be identified, so whether the fact was known first-hand cannot be told."@en ;
    skos:scopeNote "An unsigned rank list, a registry or database row, a web page with no author or stated source. Unlike an absent value, which means not yet assessed."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#informationType> .

# ---- evidence-type ----
<https://w3id.org/martialis/vocab/evidence-type> a skos:ConceptScheme ;
    dcterms:title "Martialis Evidence Type Vocabulary"@en ;
    dcterms:description "How a citation's information bears on the claim it sits under, after Mills' evidence classification. Independent of direction: martialis:supports says whether it bears for or against."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:creator <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:publisher <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:rightsHolder <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:bibliographicCitation "Mills, Elizabeth Shown. Evidence Explained: Citing History Sources from Artifacts to Cyberspace. Baltimore: Genealogical Publishing Company (the Evidence Analysis Process Model: source, information, evidence)." ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "evidencetype" ;
    vann:preferredNamespaceUri <https://w3id.org/martialis/vocab/evidence-type/> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#evidenceType> ;
    skos:hasTopConcept evidencetype:direct , evidencetype:indirect , evidencetype:negative .

evidencetype:direct a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/evidence-type> ;
    skos:inScheme <https://w3id.org/martialis/vocab/evidence-type> ;
    skos:notation "direct" ;
    skos:prefLabel "Direct"@en , "Direta"@pt , "Directa"@es , "Directe"@fr , "Direkt"@de , "Beint"@is , "直接証拠"@ja , "直接证据"@zh ;
    skos:definition "The information states the claim itself."@en ;
    skos:example "\"He received menkyo kaiden from Takeda in 1930.\""@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#evidenceType> .

evidencetype:indirect a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/evidence-type> ;
    skos:inScheme <https://w3id.org/martialis/vocab/evidence-type> ;
    skos:notation "indirect" ;
    skos:prefLabel "Indirect"@en , "Indireta"@pt , "Indirecta"@es , "Indirecte"@fr , "Indirekt"@de , "Óbeint"@is , "間接証拠"@ja , "间接证据"@zh ;
    skos:definition "The information does not state the claim, but the claim can be inferred from it, alone or with other evidence."@en ;
    skos:example "A photograph of the two men at the same dojo in the same year."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#evidenceType> .

evidencetype:negative a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/evidence-type> ;
    skos:inScheme <https://w3id.org/martialis/vocab/evidence-type> ;
    skos:notation "negative" ;
    skos:prefLabel "Negative"@en , "Negativa"@pt , "Negativa"@es , "Négative"@fr , "Negativ"@de , "Neikvætt"@is , "否定的証拠"@ja , "否定性证据"@zh ;
    skos:definition "An inference from the absence of information in a source that would be expected to hold it."@en ;
    skos:example "A complete dan register for the year that does not list him."@en ;
    skos:scopeNote "Distinct from supports false, which says whether the citation backs or contradicts the claim: negative evidence usually contradicts it."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#evidenceType> .

# ---- edition-relation ----
<https://w3id.org/martialis/vocab/edition-relation> a skos:ConceptScheme ;
    dcterms:title "Martialis Edition Relation Vocabulary"@en ;
    dcterms:description "How one Source relates to the work it is an edition of."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:creator <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:publisher <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:rightsHolder <https://orcid.org/0009-0000-9488-3542> ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "editrel" ;
    vann:preferredNamespaceUri <https://w3id.org/martialis/vocab/edition-relation/> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#editionRelationType> ;
    skos:hasTopConcept editrel:edition , editrel:translation , editrel:reprint , editrel:facsimile .

editrel:edition a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/edition-relation> ;
    skos:inScheme <https://w3id.org/martialis/vocab/edition-relation> ;
    skos:notation "edition" ;
    skos:prefLabel "Edition"@en , "Edição"@pt , "Edición"@es , "Édition"@fr , "Ausgabe"@de , "Útgáfa"@is , "版"@ja , "版本"@zh ;
    skos:definition "A later or revised edition of the same work in the same language."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#editionRelationType> .

editrel:translation a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/edition-relation> ;
    skos:inScheme <https://w3id.org/martialis/vocab/edition-relation> ;
    skos:notation "translation" ;
    skos:prefLabel "Translation"@en , "Tradução"@pt , "Traducción"@es , "Traduction"@fr , "Übersetzung"@de , "Þýðing"@is , "翻訳"@ja , "译本"@zh ;
    skos:definition "A translation of the work into another language."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#editionRelationType> .

editrel:reprint a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/edition-relation> ;
    skos:inScheme <https://w3id.org/martialis/vocab/edition-relation> ;
    skos:notation "reprint" ;
    skos:prefLabel "Reprint"@en , "Reimpressão"@pt , "Reimpresión"@es , "Réimpression"@fr , "Nachdruck"@de , "Endurprentun"@is , "再版"@ja , "重印"@zh ;
    skos:definition "An unaltered reissue of the work."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#editionRelationType> .

editrel:facsimile a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/edition-relation> ;
    skos:inScheme <https://w3id.org/martialis/vocab/edition-relation> ;
    skos:notation "facsimile" ;
    skos:prefLabel "Facsimile"@en , "Fac-símile"@pt , "Facsímil"@es , "Fac-similé"@fr , "Faksimile"@de , "Ljósprentun"@is , "複製版"@ja , "影印本"@zh ;
    skos:definition "A photographic or scanned reproduction of the original work."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#editionRelationType> .

# ---- peer-review ----
<https://w3id.org/martialis/vocab/peer-review> a skos:ConceptScheme ;
    dcterms:title "Martialis Peer Review Status Vocabulary"@en ;
    dcterms:description "Whether a Source was peer-reviewed before publication: the values of martialis:peerReview, a sub-property of bibo:status. Each value matches the BIBO document status and the DRIVER/OpenAIRE value of the same meaning."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:creator <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:publisher <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:rightsHolder <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:bibliographicCitation "Bibliographic Ontology (BIBO): bibo:status and its bibo:DocumentStatus values. OpenAIRE Guidelines for Literature Repositories / DRIVER Guidelines 2.0 (info:eu-repo/semantics peer-review status values)." ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "peerreview" ;
    vann:preferredNamespaceUri <https://w3id.org/martialis/vocab/peer-review/> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology> ,
                 <https://w3id.org/martialis/ontology#peerReview> ;
    skos:hasTopConcept peerreview:peer_reviewed , peerreview:not_peer_reviewed .

peerreview:peer_reviewed a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/peer-review> ;
    skos:inScheme <https://w3id.org/martialis/vocab/peer-review> ;
    skos:notation "peer_reviewed" ;
    skos:prefLabel "Peer-reviewed"@en , "Com revisão por pares"@pt , "Con revisión por pares"@es , "Évalué par les pairs"@fr , "Begutachtet"@de , "Ritrýnt"@is , "査読あり"@ja , "同行评审"@zh ;
    skos:definition "Reviewed by independent experts in its field before publication."@en ;
    skos:scopeNote "Record it on a container Source when every item in it shares the status (a refereed journal, a wiki); an item inherits it through partOf and states its own only when it differs, such as a book review in a refereed journal. Absent when not established."@en ;
    skos:exactMatch <info:eu-repo/semantics/peerReviewed> , <http://purl.org/ontology/bibo/status/peerReviewed> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#peerReview> .

peerreview:not_peer_reviewed a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/peer-review> ;
    skos:inScheme <https://w3id.org/martialis/vocab/peer-review> ;
    skos:notation "not_peer_reviewed" ;
    skos:prefLabel "Not peer-reviewed"@en , "Sem revisão por pares"@pt , "Sin revisión por pares"@es , "Non évalué par les pairs"@fr , "Nicht begutachtet"@de , "Ekki ritrýnt"@is , "査読なし"@ja , "非同行评审"@zh ;
    skos:definition "Published without review by independent experts."@en ;
    skos:scopeNote "Record it on a container Source when every item in it shares the status (a refereed journal, a wiki); an item inherits it through partOf and states its own only when it differs, such as a book review in a refereed journal. Absent when not established."@en ;
    skos:exactMatch <info:eu-repo/semantics/nonPeerReviewed> , <http://purl.org/ontology/bibo/status/nonPeerReviewed> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#peerReview> .


# ---- date-calendar ----
<https://w3id.org/martialis/vocab/date-calendar> a skos:ConceptScheme ;
    dcterms:title "Martialis Date Calendar Vocabulary"@en ;
    dcterms:description "The calendar system an original source date was recorded in."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:creator <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:publisher <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:rightsHolder <https://orcid.org/0009-0000-9488-3542> ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "datecal" ;
    vann:preferredNamespaceUri <https://w3id.org/martialis/vocab/date-calendar/> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#dateCalendar> ;
    skos:hasTopConcept datecal:julian , datecal:japanese_nengo , datecal:japanese_lunisolar , datecal:other_lunisolar , datecal:other .

datecal:julian a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/date-calendar> ;
    skos:inScheme <https://w3id.org/martialis/vocab/date-calendar> ;
    skos:notation "julian" ;
    skos:prefLabel "Julian"@en , "Juliano"@pt , "Juliano"@es , "Julien"@fr , "Julianisch"@de , "Júlíanskt tímatal"@is , "ユリウス暦"@ja , "儒略历"@zh ;
    skos:definition "The Julian calendar, as used before a region's Gregorian adoption."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#dateCalendar> .

datecal:japanese_nengo a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/date-calendar> ;
    skos:inScheme <https://w3id.org/martialis/vocab/date-calendar> ;
    skos:notation "japanese_nengo" ;
    skos:prefLabel "Japanese nengo (era name)"@en , "Nengo japonês (nome de era)"@pt , "Nengo japonés (nombre de era)"@es , "Nengo japonais (nom d’ère)"@fr , "Japanischer Nengo (Äraname)"@de , "Japanskt nengo (tímabilsheiti)"@is , "和暦（元号）"@ja , "日本年号纪年"@zh ;
    skos:altLabel "Wareki"@en ;
    skos:hiddenLabel "nengo"@en ;
    skos:definition "The Japanese era-name calendar (e.g. Meiji, Taisho, Showa, Heisei, Reiwa)."@en ;
    skos:scopeNote "Gregorian in structure but counted from an emperor's reign."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#dateCalendar> .

datecal:japanese_lunisolar a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/date-calendar> ;
    skos:inScheme <https://w3id.org/martialis/vocab/date-calendar> ;
    skos:notation "japanese_lunisolar" ;
    skos:prefLabel "Japanese lunisolar"@en , "Lunissolar japonês"@pt , "Lunisolar japonés"@es , "Luni-solaire japonais"@fr , "Japanischer Lunisolarkalender"@de , "Japanskt tungl- og sólartímatal"@is , "和暦（旧暦）"@ja , "日本阴阳历"@zh ;
    skos:definition "The pre-Meiji Japanese lunisolar calendar."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#dateCalendar> .

datecal:other_lunisolar a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/date-calendar> ;
    skos:inScheme <https://w3id.org/martialis/vocab/date-calendar> ;
    skos:notation "other_lunisolar" ;
    skos:prefLabel "Other lunisolar"@en , "Outro lunissolar"@pt , "Otro lunisolar"@es , "Autre luni-solaire"@fr , "Anderer Lunisolarkalender"@de , "Annað tungl- og sólartímatal"@is , "その他の太陰太陽暦"@ja , "其他阴阳历"@zh ;
    skos:definition "A lunisolar calendar other than the Japanese one."@en ;
    skos:example "The traditional Chinese calendar."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#dateCalendar> .

datecal:other a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/date-calendar> ;
    skos:inScheme <https://w3id.org/martialis/vocab/date-calendar> ;
    skos:notation "other" ;
    skos:prefLabel "Other"@en , "Outro"@pt , "Otro"@es , "Autre"@fr , "Sonstiges"@de , "Annað"@is , "その他"@ja , "其他"@zh ;
    skos:definition "A calendar system not covered by the other values."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#dateCalendar> .

# ---- rank-type ----
<https://w3id.org/martialis/vocab/rank-type> a skos:ConceptScheme ;
    dcterms:title "Martialis Rank Type Vocabulary"@en ;
    dcterms:description "Which half of a numbered grading ladder a rank is on: dan (ascending) or kyu (descending); or dan_unspecified, for a source that documents dan-level status without a specific degree."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:creator <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:publisher <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:rightsHolder <https://orcid.org/0009-0000-9488-3542> ;
    skos:scopeNote "Numbered dan/kyu ladders only. Enumerated grades (menkyo, the Unified Sports Classification System, BJJ belts) and Chinese Duanwei are RankingSystem entities; title-shaped ranks are HonorAssertions."@en ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "ranktype" ;
    vann:preferredNamespaceUri <https://w3id.org/martialis/vocab/rank-type/> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#rankType> ;
    skos:hasTopConcept ranktype:dan , ranktype:kyu , ranktype:dan_unspecified .

ranktype:dan a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/rank-type> ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-type> ;
    skos:notation "dan" ;
    skos:prefLabel "Dan"@en , "Dan"@pt , "Dan"@es , "Dan"@fr , "Dan"@de , "Dan"@is , "段"@ja , "段"@zh ;
    skos:definition "A numbered black-belt grade, counting up from 1st dan."@en ;
    skos:scopeNote "Covers every tradition's ascending numbered ladder (Japanese dan, Chinese duan, Korean dan, and similar) - which sourced institution administers it is recorded on the RankingSystem the rank references, not on this type."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#rankType> .

ranktype:kyu a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/rank-type> ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-type> ;
    skos:notation "kyu" ;
    skos:prefLabel "Kyu"@en , "Kyu"@pt , "Kyu"@es , "Kyu"@fr , "Kyu"@de , "Kyu"@is , "級"@ja , "级"@zh ;
    skos:definition "A numbered pre-black-belt grade, counting down to 1st kyu."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#rankType> .

ranktype:dan_unspecified a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/rank-type> ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-type> ;
    skos:notation "dan_unspecified" ;
    skos:prefLabel "Black Belt"@en , "Faixa preta"@pt , "Cinturón negro"@es , "Ceinture noire"@fr , "Danträger"@de , "Svart belti"@is , "有段者"@ja , "有段者"@zh ;
    skos:altLabel "Yudansha"@en , "Yūdansha"@en ;
    skos:definition "Holds a dan-level grade in a numbered RankingSystem, but the source does not state which specific degree."@en ;
    skos:scopeNote "A distinct, verified idiom in every project locale, not a formula composed from 'dan' plus a missing number: Japanese 有段者 (yūdansha), Chinese 有段者 (yǒuduànzhě), German Danträger, Portuguese faixa preta, English 'black belt'. rankOrdinal stays absent whenever this value is used."@en ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#rankType> .

# ---- rank-grade: menkyo ----
# Grade scheme for the Menkyo RankingSystem entity.
<https://w3id.org/martialis/vocab/rank-grade/menkyo> a skos:ConceptScheme ;
    dcterms:title "Menkyo Grade Vocabulary"@en ;
    dcterms:description "The traditional koryu licence ladder: shoden, chuden, okuden, menkyo, menkyo kaiden, and gokui."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:creator <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:publisher <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:rightsHolder <https://orcid.org/0009-0000-9488-3542> ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "rankgrade" ;
    vann:preferredNamespaceUri <https://w3id.org/martialis/vocab/rank-grade/> ;
    skos:hasTopConcept rankgrade:menkyo_shoden , rankgrade:menkyo_chuden , rankgrade:menkyo_okuden ,
                        rankgrade:menkyo_license , rankgrade:menkyo_kaiden , rankgrade:menkyo_gokui .

rankgrade:menkyo_shoden a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/menkyo> ;
    skos:notation "menkyo_shoden" ; martialis:gradeOrdinal 1 ;
    skos:prefLabel "Shoden"@en , "Shoden"@pt , "Shoden"@es , "Shoden"@fr , "Shoden"@de , "Shoden"@is , "初伝"@ja , "初传"@zh ;
    skos:altLabel "Shoden Kirigami Mokuroku"@en ;
    skos:definition "Shoden (初伝, 'beginning transmission'): the first tier of the traditional koryu licence ladder."@en ;
    skos:scopeNote "'Kirigami' and 'mokuroku' name specific certificate/catalogue documents historically issued at this tier, observed combined as 'Shoden Kirigami Mokuroku' in sourced data."@en .

rankgrade:menkyo_chuden a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/menkyo> ;
    skos:notation "menkyo_chuden" ; martialis:gradeOrdinal 2 ;
    skos:prefLabel "Chuden"@en , "Chuden"@pt , "Chuden"@es , "Chuden"@fr , "Chuden"@de , "Chuden"@is , "中伝"@ja , "中传"@zh ;
    skos:definition "Chuden (中伝, 'middle transmission'): the second tier of the traditional koryu licence ladder, between shoden and okuden."@en .

rankgrade:menkyo_okuden a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/menkyo> ;
    skos:notation "menkyo_okuden" ; martialis:gradeOrdinal 3 ;
    skos:prefLabel "Okuden"@en , "Okuden"@pt , "Okuden"@es , "Okuden"@fr , "Okuden"@de , "Okuden"@is , "奥伝"@ja , "奥传"@zh ;
    skos:altLabel "Okuden Inka"@en ;
    skos:definition "Okuden (奥伝, 'inner transmission'): the third tier of the traditional koryu licence ladder, below menkyo and menkyo kaiden."@en ;
    skos:scopeNote "'Inka' (印可, 'seal of approval') names the certificate confirming this tier, observed combined as 'Okuden Inka' in sourced data."@en .

rankgrade:menkyo_license a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/menkyo> ;
    skos:notation "menkyo_license" ; martialis:gradeOrdinal 4 ;
    skos:prefLabel "Menkyo"@en , "Menkyo"@pt , "Menkyo"@es , "Menkyo"@fr , "Menkyo"@de , "Menkyo"@is , "免許"@ja , "免许"@zh ;
    skos:altLabel "menkyo"@en , "Teaching license"@en ;
    skos:definition "Menkyo (免許, 'licence'): a formal teaching licence, one tier below full transmission (menkyo kaiden)."@en .

rankgrade:menkyo_kaiden a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/menkyo> ;
    skos:notation "menkyo_kaiden" ; martialis:gradeOrdinal 5 ;
    skos:prefLabel "Menkyo Kaiden"@en , "Menkyo Kaiden"@pt , "Menkyo Kaiden"@es , "Menkyo Kaiden"@fr , "Menkyo Kaiden"@de , "Menkyo Kaiden"@is , "免許皆伝"@ja , "免许皆传"@zh ;
    skos:altLabel "Menkyokaiden (免許皆伝)"@en , "menkyo kaiden"@en ;
    skos:definition "Menkyo kaiden (免許皆伝, 'licence of total transmission'): full transmission of a koryu's teachings, the top of the traditional licence ladder."@en .

rankgrade:menkyo_gokui a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/menkyo> ;
    skos:notation "menkyo_gokui" ; martialis:gradeOrdinal 5 ;
    skos:prefLabel "Gokui"@en , "Gokui"@pt , "Gokui"@es , "Gokui"@fr , "Gokui"@de , "Gokui"@is , "極意"@ja , "极意"@zh ;
    skos:altLabel "Gokui kaiden"@en ;
    skos:definition "Gokui (極意, 'ultimate secrets'): transmission of a school's innermost teachings."@en ;
    skos:scopeNote "Roughly kaiden-adjacent in seniority (hence the tied gradeOrdinal), kept as a distinct concept because the sourced term names 'gokui', not 'menkyo'."@en .

# ---- honor-grade: shogo ----
# Honorific teaching-title scheme for HonorAssertion.honorGrade.
<https://w3id.org/martialis/vocab/honor-grade/shogo> a skos:ConceptScheme ;
    dcterms:title "Shogo Honorific Grade Vocabulary"@en ;
    dcterms:description "The shogo teaching-title ladder: renshi, kyoshi, hanshi, in ascending order of seniority. Originated by the Dai Nippon Butoku Kai and conferred by many other bodies. A concept is the rung only: the conferring body is the HonorAssertion's object, and titles from different bodies are not asserted to be equivalent."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:creator <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:publisher <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:rightsHolder <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:bibliographicCitation "Shogo teaching titles (renshi/kyoshi/hanshi), as originated by the Dai Nippon Butoku Kai." ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "honorgrade" ;
    vann:preferredNamespaceUri <https://w3id.org/martialis/vocab/honor-grade/> ;
    skos:hasTopConcept honorgrade:shogo_renshi , honorgrade:shogo_kyoshi , honorgrade:shogo_hanshi .

honorgrade:shogo_renshi a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/honor-grade/shogo> ;
    skos:notation "shogo_renshi" ; martialis:gradeOrdinal 1 ;
    skos:prefLabel "Renshi"@en , "Renshi"@pt , "Renshi"@es , "Renshi"@fr , "Renshi"@de , "Renshi"@is , "錬士"@ja , "炼士"@zh ;
    skos:definition "Renshi (錬士): the entry tier of the shogo teaching-title system."@en .

honorgrade:shogo_kyoshi a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/honor-grade/shogo> ;
    skos:notation "shogo_kyoshi" ; martialis:gradeOrdinal 2 ;
    skos:prefLabel "Kyoshi"@en , "Kyoshi"@pt , "Kyoshi"@es , "Kyoshi"@fr , "Kyoshi"@de , "Kyoshi"@is , "教士"@ja , "教士"@zh ;
    skos:altLabel "kyōshi"@en ;
    skos:definition "Kyoshi (教士): the mid tier of the shogo teaching-title system, above renshi and below hanshi."@en .

honorgrade:shogo_hanshi a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/honor-grade/shogo> ;
    skos:notation "shogo_hanshi" ; martialis:gradeOrdinal 3 ;
    skos:prefLabel "Hanshi"@en , "Hanshi"@pt , "Hanshi"@es , "Hanshi"@fr , "Hanshi"@de , "Hanshi"@is , "範士"@ja , "范士"@zh ;
    skos:altLabel "hanshi"@en ;
    skos:definition "Hanshi (範士): the senior tier of the shogo teaching-title system, above kyoshi."@en .

# ---- rank-grade: bjj ----
# Grade scheme for the BJJ_Ranking_System RankingSystem entity.
<https://w3id.org/martialis/vocab/rank-grade/bjj> a skos:ConceptScheme ;
    dcterms:title "BJJ Belt Grade Vocabulary"@en ;
    dcterms:description "The Brazilian Jiu-Jitsu belt system: white, blue, purple, brown, black, red-and-black, red-and-white, red - belt colour is the rank itself, not insignia on a numbered ladder."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:creator <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:publisher <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:rightsHolder <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:bibliographicCitation "International Brazilian Jiu-Jitsu Federation. General System of Graduation. June 2025." ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "rankgrade" ;
    vann:preferredNamespaceUri <https://w3id.org/martialis/vocab/rank-grade/> ;
    skos:hasTopConcept rankgrade:bjj_white , rankgrade:bjj_blue , rankgrade:bjj_purple ,
                        rankgrade:bjj_brown , rankgrade:bjj_black , rankgrade:bjj_red_black ,
                        rankgrade:bjj_red_white , rankgrade:bjj_red .

rankgrade:bjj_white a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/bjj> ;
    skos:notation "bjj_white" ; martialis:gradeOrdinal 1 ;
    skos:prefLabel "White belt"@en , "Faixa branca"@pt , "Cinturón blanco"@es , "Ceinture blanche"@fr , "Weißer Gürtel"@de , "Hvítt belti"@is , "白帯"@ja , "白带"@zh ;
    skos:definition "The entry-level Brazilian Jiu-Jitsu belt."@en ;
    skos:scopeNote "IBJJF General System of Graduation, Art. 1.2."@en .

rankgrade:bjj_blue a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/bjj> ;
    skos:notation "bjj_blue" ; martialis:gradeOrdinal 2 ;
    skos:prefLabel "Blue belt"@en , "Faixa azul"@pt , "Cinturón azul"@es , "Ceinture bleue"@fr , "Blauer Gürtel"@de , "Blátt belti"@is , "青帯"@ja , "蓝带"@zh ;
    skos:definition "The second Brazilian Jiu-Jitsu belt, after white."@en ;
    skos:scopeNote "IBJJF General System of Graduation, Art. 1.2."@en .

rankgrade:bjj_purple a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/bjj> ;
    skos:notation "bjj_purple" ; martialis:gradeOrdinal 3 ;
    skos:prefLabel "Purple belt"@en , "Faixa roxa"@pt , "Cinturón morado"@es , "Ceinture violette"@fr , "Violetter Gürtel"@de , "Fjólublátt belti"@is , "紫帯"@ja , "紫带"@zh ;
    skos:definition "The third Brazilian Jiu-Jitsu belt, after blue."@en ;
    skos:scopeNote "IBJJF General System of Graduation, Art. 1.2."@en .

rankgrade:bjj_brown a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/bjj> ;
    skos:notation "bjj_brown" ; martialis:gradeOrdinal 4 ;
    skos:prefLabel "Brown belt"@en , "Faixa marrom"@pt , "Cinturón marrón"@es , "Ceinture marron"@fr , "Brauner Gürtel"@de , "Brúnt belti"@is , "茶帯"@ja , "棕带"@zh ;
    skos:definition "The fourth Brazilian Jiu-Jitsu belt, the last before black."@en ;
    skos:scopeNote "IBJJF General System of Graduation, Art. 1.2."@en .

rankgrade:bjj_black a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/bjj> ;
    skos:notation "bjj_black" ; martialis:gradeOrdinal 5 ;
    skos:prefLabel "Black belt"@en , "Faixa preta"@pt , "Cinturón negro"@es , "Ceinture noire"@fr , "Schwarzer Gürtel"@de , "Svart belti"@is , "黒帯"@ja , "黑带"@zh ;
    skos:definition "The senior practitioner belt."@en ;
    skos:scopeNote "Divides into six numbered degrees before the red-and-black/red-and-white/red belts continue the count (IBJJF General System of Graduation, Art. 1.2, 4.1.2)."@en .

rankgrade:bjj_red_black a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/bjj> ;
    skos:notation "bjj_red_black" ; martialis:gradeOrdinal 6 ;
    skos:prefLabel "Red-and-black belt"@en , "Faixa vermelha e preta"@pt , "Cinturón rojo y negro"@es , "Ceinture rouge et noire"@fr , "Schwarz-Roter Gürtel"@de , "Rautt og svart belti"@is , "赤黒帯"@ja , "红黑带"@zh ;
    skos:altLabel "Coral belt"@en , "Faixa coral"@pt ;
    skos:definition "The 7th-degree black-belt tier, marked by its own belt colour rather than a stripe count."@en ;
    skos:scopeNote "Commonly called 'coral'. Sourced degree numbers vary in practice; this concept names the colour pairing as the source states it, not a fixed degree (IBJJF General System of Graduation, Art. 1.2, 4.1.5)."@en .

rankgrade:bjj_red_white a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/bjj> ;
    skos:notation "bjj_red_white" ; martialis:gradeOrdinal 7 ;
    skos:prefLabel "Red-and-white belt"@en , "Faixa vermelha e branca"@pt , "Cinturón rojo y blanco"@es , "Ceinture rouge et blanche"@fr , "Rot-Weißer Gürtel"@de , "Rautt og hvítt belti"@is , "紅白帯"@ja , "红白带"@zh ;
    skos:altLabel "Coral belt"@en , "Faixa coral"@pt ;
    skos:definition "The 8th-degree black-belt tier, marked by its own belt colour rather than a stripe count."@en ;
    skos:scopeNote "Commonly called 'coral'. Sourced degree numbers vary in practice; this concept names the colour pairing as the source states it, not a fixed degree (IBJJF General System of Graduation, Art. 1.2, 4.1.5)."@en .

rankgrade:bjj_red a skos:Concept ;
    skos:inScheme <https://w3id.org/martialis/vocab/rank-grade/bjj> ;
    skos:notation "bjj_red" ; martialis:gradeOrdinal 8 ;
    skos:prefLabel "Red belt"@en , "Faixa vermelha"@pt , "Cinturón rojo"@es , "Ceinture rouge"@fr , "Roter Gürtel"@de , "Rautt belti"@is , "赤帯"@ja , "红带"@zh ;
    skos:definition "The senior-most Brazilian Jiu-Jitsu belt, from the 9th degree."@en ;
    skos:scopeNote "The 10th degree was given only to the art's founders (IBJJF General System of Graduation, Art. 1.2, 4.1.5)."@en .

# ---- rank-grade: Unified Sports Classification System (USSR/Russia) ----
# Grade scheme for the Unified_Sports_Classification_System RankingSystem entity.
<https://w3id.org/martialis/vocab/rank-grade/unified-sports-classification> a skos:ConceptScheme ;
    dcterms:title "Unified Sports Classification System Grade Vocabulary"@en ;
    dcterms:description "The USSR/Russia state sports-title ladder, from 3rd class sportsman to Honoured Master of Sport - used by Sambo and other Soviet-sphere combat sports as a real credentialing system, not free text."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:creator <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:publisher <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:rightsHolder <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:bibliographicCitation "Wikipedia: Unified Sports Classification System of the USSR and Russia (state-run credentialing system, established 1935, revised on the Olympic cycle)." ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "rankgrade" ;
    vann:preferredNamespaceUri <https://w3id.org/martialis/vocab/rank-grade/> ;
    skos:hasTopConcept rankgrade:ussc_class_3 , rankgrade:ussc_class_2 , rankgrade:ussc_class_1 ,
                        rankgrade:ussc_candidate_master , rankgrade:ussc_master ,
                        rankgrade:ussc_master_international , rankgrade:ussc_honoured_master .

