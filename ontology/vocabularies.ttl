mediarights:attribution a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/media-rights> ;
    skos:inScheme <https://w3id.org/martialis/vocab/media-rights> ;
    skos:notation "attribution" ;
    skos:prefLabel "Attribution"@en , "Atribuição"@pt , "Atribución"@es , "Attribution"@fr , "Namensnennung"@de , "Tilvísun"@is , "帰属表示"@ja , "署名"@zh ;
    skos:definition "Reuse for any purpose is permitted, provided the copyright holder is credited."@en ;
    skos:scopeNote "A free licence that is not a Creative Commons licence, as Wikimedia Commons' Attribution template states it."@en ;
    rdfs:seeAlso <https://commons.wikimedia.org/wiki/Template:Attribution> , <https://w3id.org/martialis/ontology#mediaRights> .

mediarights:in_copyright a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/media-rights> ;
    skos:inScheme <https://w3id.org/martialis/vocab/media-rights> ;
    skos:notation "in_copyright" ;
    skos:prefLabel "In Copyright"@en , "Sob Direitos de Autor"@pt , "Protegido por derechos de autor"@es , "Protégé par le droit d’auteur"@fr , "Urheberrechtlich geschützt"@de , "Höfundarréttarvarið"@is , "著作権あり"@ja , "有版权"@zh ;
    skos:definition "The work is (or is presumed to be) protected by copyright, with no licence granted to reuse it."@en ;
    skos:exactMatch <http://rightsstatements.org/vocab/InC/1.0/> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#mediaRights> .

mediarights:no_known_copyright a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/media-rights> ;
    skos:inScheme <https://w3id.org/martialis/vocab/media-rights> ;
    skos:notation "no_known_copyright" ;
    skos:prefLabel "No Known Copyright"@en , "Sem Direitos de Autor Conhecidos"@pt , "Sin derechos de autor conocidos"@es , "Aucun droit d’auteur connu"@fr , "Keine bekannten Urheberrechte"@de , "Enginn þekktur höfundarréttur"@is , "既知の著作権なし"@ja , "无已知版权"@zh ;
    skos:definition "A reasonable investigation found no evidence of copyright restrictions, short of a formal public-domain determination."@en ;
    skos:exactMatch <http://rightsstatements.org/vocab/NKC/1.0/> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#mediaRights> .

mediarights:copyright_undetermined a skos:Concept ;
    skos:topConceptOf <https://w3id.org/martialis/vocab/media-rights> ;
    skos:inScheme <https://w3id.org/martialis/vocab/media-rights> ;
    skos:notation "copyright_undetermined" ;
    skos:prefLabel "Copyright Undetermined"@en , "Direitos de Autor Indeterminados"@pt , "Derechos de autor indeterminados"@es , "Droits d’auteur indéterminés"@fr , "Urheberrecht ungeklärt"@de , "Höfundarréttur óljós"@is , "著作権不明"@ja , "版权未定"@zh ;
    skos:definition "The copyright status was investigated and could not be established."@en ;
    skos:scopeNote "Distinct from the absence of a value: this records that the question was asked and stayed unresolved, not merely unasked."@en ;
    skos:exactMatch <http://rightsstatements.org/vocab/UND/1.0/> ;
    rdfs:seeAlso <https://w3id.org/martialis/ontology#mediaRights> .

mediarights:displayable a skos:Collection ;
    skos:prefLabel "Displayable"@en , "Exibível"@pt , "Publicable"@es , "Affichable"@fr , "Anzeigbar"@de , "Má birta"@is , "表示可能"@ja , "可展示"@zh ;
    skos:definition "Values under which the project considers itself free to display the media item on its own site. An editorial policy of this project, not legal advice."@en ;
