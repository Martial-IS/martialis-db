<https://martial.is/entity/01M0AAFQFXZ7G2JDEFZY8M5AKF>
        rdf:type                       martialis:Person;
        schema:alternateName           "Mataemon Tanabe"@en;
        schema:alternateName           "Newaza Tanabe"@ja-Latn;
        schema:alternateName           "Newaza no Tatsujin"@ja-Latn;
        schema:birthDate               "1869";
        schema:birthPlace              <https://martial.is/entity/01M0AAFQFXZ7G2JDEFZY8M5AKF/birthEvent/birthPlace>;
        schema:deathDate               "1942";
        schema:deathPlace              <https://martial.is/entity/01M0AAFQFXZ7G2JDEFZY8M5AKF/deathEvent/deathPlace>;
        schema:description             "Japanese jujutsu practitioner, fourth head of the Fusen-ryu school founded by Motsugai Takeda. His fame came from challenge-match wins over several Kodokan members - most famously Takisaburo Tobari in 1891 - and came to be considered one of the greatest modern jujutsuka. Nicknamed \"Newaza Tanabe\" and \"Newaza no Tatsujin\" for his mastery of ground techniques, he was also equally skilled in standing techniques. He was one of the twenty representing masters chosen in 1895 to open the jujutsu division of the Dai Nippon Butoku Kai, where he taught until his retirement in 1922. He declined to join the Kodokan; Kano incorporated his ground techniques into judo after seeing Kodokan experts struggle against him. He was the inspiration for the character Gennosuke Higaki in Tsuneo Tomita's Sanshiro Sugata novel series. Died in Osaka, 1942."@en;
        schema:keywords                "koryu";
        schema:keywords                "jujutsu";
        schema:keywords                "japan";
        schema:keywords                "judo";
        schema:name                    "Tanabe Mataemon"@ja-Latn;
