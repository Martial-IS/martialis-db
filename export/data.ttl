<https://martial.is/entity/01M06K0RMZNWJ90EEQ7CXBFHGS>
        rdf:type                       martialis:Person;
        schema:alternateName           "Yukio Tani"@en;
        schema:birthDate               "1881";
        schema:birthPlace              <https://martial.is/entity/01M06K0RMZNWJ90EEQ7CXBFHGS/birthEvent/birthPlace>;
        schema:deathDate               "1950-01-24";
        schema:deathPlace              <https://martial.is/entity/01M06K0RMZNWJ90EEQ7CXBFHGS/deathEvent/deathPlace>;
        schema:description             "Pioneering Japanese jujutsu and judo instructor and professional challenge wrestler, one of the first jujutsu\nstylists to teach and compete outside Japan. Early training in Japan was tied to his father, a Tenjin Shinyo-ryu\nmaster; he is rumored to have studied with Mataemon Tanabe and had some training in Yataro Handa's Seibukan school\nin Osaka. In 1900 the nineteen-year-old travelled to London at Barton-Wright's invitation and, with Sadakazu\nUyenishi, staffed the Bartitsu School of Arms; he then pioneered the music-hall challenge circuit under William\nBankier. From 1918 he was the first professional jujutsu teacher at Gunji Koizumi's Budokwai, where Jigoro Kano\nawarded him 2nd dan judo in 1920 (eventually 4th dan). His leading student Masutaro Otani founded the MOSJ, which\nevolved into the British Judo Council. Died in London, 24 January 1950.\n"@en;
        schema:description             "日本の柔術・柔道の先駆者およびプロの挑戦レスラー。海外で教鞭をとり、試合を行った最初期の柔術家の一人。1900年、バートン＝ライトの招きでロンドンに渡り、上西貞一とともにバーティツ学校の講師を務めた。1918年から小泉軍治の武道会で初のプロ講師となり、1920年には嘉納治五郎から柔道二段を授与された。1950年1月24日、ロンドンにて死去。"@ja;
        schema:keywords                "united-kingdom";
        schema:keywords                "jujutsu";
        schema:keywords                "pioneer";
        schema:keywords                "judo";
        schema:name                    "Tani Yukio"@ja-Latn;
        schema:name                    "谷 幸雄"@ja;
