<https://martial.is/entity/01M0AZQ3TJ40Z0WJJD8T706CQB>
        rdf:type                        martialis:Source;
        schema:alternateName            "近代武道の成立過程に関する研究―『日本武術名家伝』の年表的整理―";
        schema:archivedAt               <https://web.archive.org/web/20261018101607/https://www.jstage.jst.go.jp/article/budo1968/8/3/8_60/_article/-char/ja/>;
        schema:datePublished            "1976";
        schema:description              "杉江正敏（大阪大学）による研究ノート（武道学研究 第8巻第3号、60-66頁）。『日本武術名家伝』の略伝を明治期武道家の\n年表に整理したもの。明治6-7年（1873-74年）の項に、剣術教師が堂島の半田弥太郎の演武場に剣術教師として住み込んで\n門生を指導したと記録されており、1878年の盛武館創設以前の明治初期における半田の大阪での活動の独立した裏付けとなる。\n"@ja;
        schema:description              "Research note (武道学研究 / Research Journal of Budo, vol. 8, no. 3, pp. 60-66) by Sugie Masatoshi (Osaka\nUniversity) arranging the biographies of the 日本武術名家伝 into a chronological table of Meiji-era martial\nartists. The table's Meiji 6-7 (1873-74) entries record that a kenjutsu teacher served at Handa Yataro's practice\nhall (演武場) at Dojima, residing there to instruct students - independent corroboration of Handa's Osaka presence\nin the early Meiji period, before the 1878 founding of the Seibukan.\n"@en;
        schema:inLanguage               "ja";
        schema:keywords                 "japan";
        schema:keywords                 "academic";
        schema:name                     "近代武道の成立過程に関する研究―『日本武術名家伝』の年表的整理―";
        schema:publisher                <https://martial.is/entity/01M0AZQ3TJ40Z0WJJD8T706CQB/publisher>;
        schema:url                      <https://www.jstage.jst.go.jp/article/budo1968/8/3/8_60/_article/-char/ja/>;
        martialis:accessed              "../2026-08-19";
        martialis:archiveDate           "2026-10-18";
        martialis:doi                   "10.11214/budo1968.8.3_60";
        martialis:earliestYear          1976;
        martialis:hasContributor        <https://martial.is/entity/01M0AZQ3TJ40Z0WJJD8T706CQB/hasContributor/0>;
        martialis:latestYear            1976;
