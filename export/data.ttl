<https://martial.is/entity/01M19SYYS39CCMB0A3AHREYPXR>
        rdf:type                    martialis:Event;
        schema:about                <https://martial.is/entity/01KJJAWN29MA64W22606R3WD9B>;
        schema:alternateName        "First Kodokan Judo Exhibition in North America"@en;
        schema:description          "1903年10月17日、シアトル劇場で行われた私的な柔道演武会。サミュエル・ヒルの主催で、山下義韶と助手の 川口三郎が投技や固技を披露した。観客はメアリー・ヒル、ラッセル・アルジャー上院議員、シアトルの スポーツ記者ら。知られる限り、北米で非日本人観客に講道館柔道が披露された最初の機会とされる。この後、 プロレスラーが現れなかったため代役として招かれたアマチュアボクサーのC.E.ラドクリフ（210ポンド）と 山下が非公式の立ち合いを行った。"@ja;
        schema:description          "A private judo exhibition at the Seattle Theatre, hired by Sam Hill between shows: Yamashita Yoshiaki and his assistant Saburo Kawaguchi demonstrated throws and holds for Hill's guests - Mary Hill, Senator Russell Alger, and several Seattle sports writers. So far as is known, this was the first time Kodokan judo was shown to a non-Japanese audience in North America. It was followed by an informal bout in which Yamashita handled C.E. Radclyffe, a 210-pound English amateur boxer, after the professional wrestlers Hill had hoped to match failed to appear."@en;
        schema:keywords             "seattle";
        schema:keywords             "kodokan";
        schema:location             <https://martial.is/entity/01M19SYYS39CCMB0A3AHREYPXR/location>;
        schema:name                 "Seattle Theatre Judo Exhibition"@en;
        schema:name                 "シアトル劇場柔道演武会"@ja;
        schema:startDate            "1903-10-17";
        schema:superEvent           <https://martial.is/entity/01M19SYYS3JXJSD3JGQ89RG6SM>;
        martialis:earliestYear      1903;
        martialis:eventType         <https://w3id.org/martialis/vocab/event-classification/demonstration>;
        martialis:hasEvidence       <https://martial.is/entity/01M19SYYS39CCMB0A3AHREYPXR/hasEvidence/0>;
        martialis:hasParticipation  <https://martial.is/entity/01M3YH7N5FF7D17CCNC82JZ3HY>;
        martialis:latestYear        1903 .

