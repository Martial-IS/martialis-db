<https://martial.is/entity/01M0A2FCGSR8REC4KS6X3HF1H0>
        rdf:type                       martialis:Person;
        schema:alternateName           "Sarah Winifred Benedict Tapping"@en;
        schema:alternateName           "Sarah Winifred Benedict"@en;
        schema:alternateName           "Sarah Winifred Benedict Mayer"@en;
        schema:birthDate               "1896-10-16";
        schema:birthPlace              <https://martial.is/entity/01M0A2FCGSR8REC4KS6X3HF1H0/birthEvent/birthPlace>;
        schema:deathDate               "1957-03-19";
        schema:deathPlace              <https://martial.is/entity/01M0A2FCGSR8REC4KS6X3HF1H0/deathEvent/deathPlace>;
        schema:description             "English actress and judoka, the first non-Japanese woman to obtain a black belt in judo. Born in London in 1896\ninto an acting dynasty, she worked in the West End from 1914. She trained in judo with Gunji Koizumi at the\nBudokwai from 1926, where the ladies' classes were taught by Koizumi and Yukio Tani, reaching 4th kyu by 1932. On\nan around-the-world trip in 1934 she trained in Japan, first in Kobe and Kyoto, then in Tokyo under Kanō Jigorō,\nwho devised a training regime for her and allowed her to practise in the Kodokan main dojo with the men. After\nreaching Kodokan 1st kyu she graded for shōdan at the Kyoto Butokukai in February 1935 - the first non-Japanese\nwoman black belt. On her return she was Honorary Secretary of the Budokwai's ladies' section; she is the subject of\nan Oxford Dictionary of National Biography entry.\n"@en;
        schema:keywords                "united-kingdom";
        schema:keywords                "pioneer";
        schema:keywords                "women-judo";
        schema:keywords                "judo";
        schema:name                    "Sarah Mayer"@en;
        schema:nationality             <https://martial.is/entity/01M0A2FCGSR8REC4KS6X3HF1H0/nationality/0>;
