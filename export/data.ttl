<https://martial.is/entity/01KZH5KBKXH1SZ0CCDVKPM2M31>
        rdf:type                        martialis:Source;
        schema:archivedAt               <http://web.archive.org/web/20260822213040/http://findingkarate.com/wordpress/eiichi-miyazato/>;
        schema:datePublished            "2023";
        schema:description              "Finding Karate profile of Eiichi Miyazato (1922-1999). Born July 5, 1922 in Naha, one of seven children; his father Jiro, a merchant, had been a student of Kanryo Higaonna; Miyazato started training around age 13, introduced to Chojun Miyagi (a family neighbour); his elder brother Eiko was a longtime student at Miyagi's Garden Dojo. Judo under Shoko Itokazu from 1936, eventually the Kodokan, All Okinawa Judo Champion and All Japan Police Judo Champion. Draftee, deployed to Manchuria; father died in the Battle of Okinawa. Joined the Ryukyu Police in 1946, assisted Miyagi at the Police Academy. After Miyagi's death (October 8, 1953) inherited his training equipment, took over the Garden Dojo at 32, succeeded Miyagi as Chief Instructor of the Police Academy. Jundokan dojo in Naha from 1957 (3-story building), new location 1970; resigned police 1971. Hanshi from All Japan Karate-do Federation (September 8, 1979); 7th dan Kodokan judo (May 1, 1981); 10th dan and Hanshi from the Okinawa Gojuryu Karatedo Kyokai (March 20, 1988); chairman of the Okinawa Prefecture Karatedo Federation (1991). Died December 11, 1999; posthumously awarded 8th dan by the Kodokan."@en;
        schema:inLanguage               "en";
        schema:keywords                 "goju-ryu";
        schema:keywords                 "karate";
        schema:name                     "Eiichi Miyazato";
        schema:publisher                <https://martial.is/entity/01KZH5KBKXH1SZ0CCDVKPM2M31/publisher>;
        schema:url                      <http://findingkarate.com/wordpress/eiichi-miyazato/>;
        martialis:accessed              "2026-09-23";
        martialis:earliestYear          2023;
        martialis:hasContributor        <https://martial.is/entity/01KZH5KBKXH1SZ0CCDVKPM2M31/hasContributor/0>;
        martialis:latestYear            2023;
        martialis:partOf                <https://martial.is/entity/01M64QW2FNVW32XVEJ4452RT2D>;
        martialis:peerReview            <https://w3id.org/martialis/vocab/peer-review/not_peer_reviewed>;
        martialis:sourceClassification  srcclass:authored;
        martialis:sourceGenre           <https://w3id.org/martialis/vocab/source-genre/biography>;
        martialis:sourceType            "webpage" .

