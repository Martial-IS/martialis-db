<https://martial.is/entity/01KZC8S2GE3X9V7N27WXMQEPQA>
        rdf:type                martialis:Style;
        schema:alternateName    "Shorin Ryu"@en;
        schema:description      "Shorin-ryu (少林流) is one of the major modern Okinawan martial arts, an umbrella term\nfor the schools descended from the Shuri-te tradition of Matsumura Sokon and Anko\nItosu, combining Shaolin kung fu elements with the native Shuri-te fighting style.\nIt diverged into many schools, including Kobayashi Shorin-ryu (Chibana Choshin),\nMatsubayashi-ryu (Nagamine Shoshin) and Shobayashi Shorin-ryu (Shimabuku Eizo).\n"@en;
        schema:keywords         "gendai";
        schema:keywords         "karate";
