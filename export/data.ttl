<https://martial.is/entity/01KYND6715JYA1K07KHXH3FNG6>
        rdf:type                       martialis:Person;
        schema:alternateName           "Shizuya Satoh"@en;
        schema:birthDate               "1929";
        schema:birthPlace              <https://martial.is/entity/01KYND6715JYA1K07KHXH3FNG6/birthEvent/birthPlace>;
        schema:deathDate               "2011-02-25";
        schema:description             "Founder of Nihon Jujutsu, Meijin 10th dan Nihon Jujutsu (Kokusai Budoin IMAF), Hanshi 9th dan Judo (Kokusai Budoin IMAF). Student of Mifune Kyuzo at the Kodokan. Founded the US Embassy Judo Club in 1957 and served as its chief instructor until his death. Former Chief Director of Kokusai Budoin, IMAF (1982-2011)."@en;
