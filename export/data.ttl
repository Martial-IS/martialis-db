<https://martial.is/entity/01M0RBSXARZ3W02J1SVG7K9366>
        rdf:type                        martialis:Source;
        <http://purl.org/ontology/bibo/pages>  "15-30";
        <http://purl.org/ontology/bibo/volume>  "4";
        schema:archivedAt               <http://web.archive.org/web/20250505041257/https://www.waseda.jp/inst/oris/assets/uploads/2021/03/JIRS_vol-4_02_-Eduardo-Gonzalez.pdf>;
        schema:datePublished            "2021-03";
        schema:description              "Peer-reviewed study of how bushidō imagery and nihonjinron rhetoric shaped karate's postwar global spread. On Mishima Yukio it states that after training in kendo and iaido he started karate training in 1967 at the Japan Karate Association, and that shortly before his death he took part in the 13th All-Japan Karate Championships at the Nippon Budokan in 1970 (this latter claim follows Pita Céspedes 2014 rather than primary JKA records). Also documents his role, with Hagakure nyūmon (1967), in restoring the popular international image of bushidō."@en;
        schema:inLanguage               "en";
        schema:keywords                 "bushido";
        schema:keywords                 "karate";
        schema:name                     "In which Ways is Karate (dō) Japanese? A Consideration on Cultural Images of Bushidō and Nihonjinron in the Postwar Globalization of Martial Arts";
        schema:publisher                <https://martial.is/entity/01M0RBSXARZ3W02J1SVG7K9366/publisher>;
        schema:url                      <https://www.waseda.jp/inst/oris/assets/uploads/2021/03/JIRS_vol-4_02_-Eduardo-Gonzalez.pdf>;
        martialis:accessed              "2026-08-24";
