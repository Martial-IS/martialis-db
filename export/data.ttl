<https://martial.is/entity/01M3YH7N5G794YNGVPVHWZSZPQ/hasInteraction/0/hasEvidence/0>
        rdf:type                   martialis:SourceAssertionRelation;
        schema:citation            "Entrevista ao Professor Leopoldo Ferreira (Pedro Escudeiro, 2000 - Archived)";
        martialis:basedOnSource    <https://martial.is/entity/01KJJAWN29MA64W22606R3WDA2>;
        martialis:evidenceType     <https://w3id.org/martialis/vocab/evidence-type/direct>;
        martialis:informationType  infotype:primary;
        martialis:quotation        "Não, eu só comecei a praticar em 1971, mais precisamente a 30 de Dezembro de 1971, quinta-feira, às 18.30h (Risos), na Academia de Budo, com Misao Honda [...] Eu só conheci o Mestre Stobbaerts, em Agosto ou Setembro de 1972, pelo simples motivo que quando o Honda se foi embora, como eu era o aluno mais graduado, e também porque era estudante de Educação Física, o Dr. Pires Martins insistiu para que eu ficasse a dar as aulas de Aikido";
        martialis:supports         true .

