<https://martial.is/entity/01M0B5RHF3RHGWF3VZVRGFMJTP>
        rdf:type                        martialis:Source;
        schema:datePublished            "1904";
        schema:description              "March 1904 interview with jujutsu pioneer Sadakazu Uyenishi, published in Health and Strength Magazine. The\njournalist J. St. A. Jewell states that Uyenishi learned jujutsu from Yataro Handa of Osaka, and that Yukio Tani\n\"was also a pupil of Yataro Handa's\" and \"received the finishing touches of his jujitsu education at Mr. Handa's\nhands\". The interview also reportedly describes Uyenishi as the Champion of Osaka. Republished in The Bartitsu\nCompendium, vol. 2 (Wolf, ed.), and quoted in Wolf's 2016 Bartitsu Society article and the peer-reviewed Brough\net al. (2023) paper on the British Ju-jitsu Society (mas.166). The primary text is not directly accessible here;\nthis entry is sourced via Wolf 2016 (01M0AJNJHSV6RHCNNKNM0Y1EHT) and Brough et al. 2023\n(01M0A7YYEFNNVJ1W07NHA7XJHG).\n"@en;
        schema:inLanguage               "en";
        schema:keywords                 "united-kingdom";
        schema:keywords                 "jujutsu";
        schema:keywords                 "history";
        schema:name                     "Interview with Sadakazu Uyenishi (\"Uyenishi Learned the Art from Mr. Yataro Handa of Osaka, Japan\")";
        schema:publisher                <https://martial.is/entity/01M0B5RHF3RHGWF3VZVRGFMJTP/publisher>;
        martialis:earliestYear          1904;
        martialis:hasContributor        <https://martial.is/entity/01M0B5RHF3RHGWF3VZVRGFMJTP/hasContributor/0>;
        martialis:latestYear            1904;
        martialis:sourceClassification  srcclass:original;
        martialis:sourceGenre           <https://w3id.org/martialis/vocab/source-genre/interview>;
        martialis:sourceType            "interview" .

