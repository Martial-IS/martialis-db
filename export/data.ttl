<https://martial.is/entity/01M0BCX1XW7EF50ANP0G8F9JX1>
        rdf:type                        martialis:Source;
        schema:alternateName            "Bartitsu";
        schema:archivedAt               <https://en.wikipedia.org/w/index.php?title=Bartitsu&oldid=1350704612>;
        schema:description              "English Wikipedia article on Bartitsu, the eclectic self-defence system founded by E.W. Barton-Wright in London in\n1899. Records that Barton-Wright, via correspondence with Jigoro Kano, arranged for Japanese jujutsu practitioners\nKaneo Tani, Seizo Yamamoto and the nineteen-year-old Yukio Tani to travel to London and serve as instructors at the\nBartitsu Club at 67b Shaftesbury Avenue; that Kaneo Tani and Yamamoto soon returned to Japan while Yukio Tani stayed\nand was joined by Sadakazu Uyenishi; and that the Japanese instructors fought challenge matches against other combat\nstyles on the music hall circuit.\n"@en;
        schema:inLanguage               "en";
        schema:keywords                 "united-kingdom";
        schema:keywords                 "bartitsu";
