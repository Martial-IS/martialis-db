<https://martial.is/entity/01M3YH7N5FQAY6P05GT4RCTY82/hasEvidence/0>
        rdf:type                   martialis:SourceAssertionRelation;
        schema:citation            "Oswaldo Fadda, Um Pioneiro na Democratização do Jiu Jitsu (BJJ Fanatics)";
