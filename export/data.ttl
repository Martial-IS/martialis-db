<https://martial.is/entity/01M5JRHX024QXCGWZYKC82GA3W>
        rdf:type                martialis:Person;
        schema:alternateName    "Hans Lichtenauer"@en;
        schema:alternateName    "Hans Liechtenauer"@en;
        schema:alternateName    "Lichtnawer"@en;
        schema:description      "Fourteenth-century German fencing master, the grand master of the German school (Kunst des Fechtens). The Pol Hausbuch says he travelled through many lands to learn the art, which he did not invent; he settled to teach in the later 1300s and bound his students to secrecy. His teaching survives in rhyming verses (the Zettel), glossed by later masters; Paulus Kal listed him first in the Society of Liechtenauer. Almost nothing else is known of his life."@en;
        schema:keywords         "kunst-des-fechtens";
        schema:keywords         "founder";
