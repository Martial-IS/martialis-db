        rdf:type                   martialis:SourceAssertionRelation;
        schema:citation            "SILVA, Elton; CORRÊA, Eduardo. Muito antes do MMA: O legado dos precursores do Vale Tudo no Brasil e no mundo. 2020.";
        martialis:basedOnSource    <https://martial.is/entity/01KJJAWN29MA64W22606R3WDAH>;
        martialis:evidenceType     <https://w3id.org/martialis/vocab/evidence-type/direct>;
        martialis:informationType  infotype:secondary;
        martialis:quotation        "Mário Alexio teve o privilégio de se adestrar no Jiu Jitsu com dois dos mais experientes e famosos mestres japoneses dos ringues. Recebeu suas primeiras instruções de Sada Miyako por volta de 1909. Posteriormente teve a oportunidade de se aperfeiçoar com o grande Conde Koma, pouco depois deste chegar ao Brasil, em 1915.";
        martialis:sourceLocation   "vol. 1, p. 110";
        martialis:supports         true .

<https://martial.is/entity/01M5JSGG50F450X1DNSYHTR26M>
        rdf:type                martialis:Person;
        schema:alternateName    "Salvador Fabbri"@en;
