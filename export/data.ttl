<https://martial.is/entity/01M19SYYS3JXJSD3JGQ89RG6SM>
        rdf:type                martialis:Event;
        schema:about            <https://martial.is/entity/01KJJAWN29MA64W22606R3WD9B>;
        schema:alternateName    "Yamashita's American Mission (1903-1906)"@en;
        schema:description      "山下義韶の1903年から1906年にかけてのアメリカ派遣。シアトルの実業家サミュエル・ヒルの依頼で渡米した山下は、 北米で初めて非日本人観客に講道館柔道を披露したシアトル劇場の演武会（1903年10月）、ホワイトハウスでの セオドア・ルーズベルト大統領への柔道指導（1904年3月-4月）、ジョセフ・グラントとの非公開試合（1905年2月）、 米海軍兵学校での柔道課程（1905年-1906年）を行った。"@ja;
        schema:description      "Yoshiaki Yamashita's 1903-1906 mission to the United States, the first Kodokan judo instruction abroad: hired by the Seattle businessman Sam Hill to teach his son, Yamashita gave the first Kodokan judo exhibition shown to a non-Japanese audience in North America (Seattle Theatre, October 1903), taught President Theodore Roosevelt in the White House (March-April 1904), wrestled a private match against Joseph Grant (February 1905), and taught judo at the US Naval Academy (1905-1906)."@en;
        schema:keywords         "united-states";
        schema:keywords         "kodokan";
        schema:location         <https://martial.is/entity/01M19SYYS3JXJSD3JGQ89RG6SM/location>;
        schema:name             "山下義韶のアメリカ滞在"@ja;
        schema:name             "Professor Yamashita in America"@en;
        schema:startDate        "1903-09/1906-06";
        martialis:earliestYear  1903;
        martialis:eventType     <https://w3id.org/martialis/vocab/event-classification/exchange>;
        martialis:hasEvidence   <https://martial.is/entity/01M19SYYS3JXJSD3JGQ89RG6SM/hasEvidence/0>;
        martialis:hasEvidence   <https://martial.is/entity/01M19SYYS3JXJSD3JGQ89RG6SM/hasEvidence/1>;
        martialis:latestYear    1906 .

