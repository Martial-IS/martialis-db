<https://martial.is/entity/01KYT8RX5WJXBGW45FEVYWN7WC>
        rdf:type                       martialis:Person;
        schema:alternateName           "최영의"@ko;
        schema:alternateName           "大山倍達"@ja;
        schema:alternateName           "Masutatsu Ōyama"@en;
        schema:alternateName           "Masutatsu Oyama"@en;
        schema:birthDate               "1923-07-27";
        schema:birthPlace              <https://martial.is/entity/01KYT8RX5WJXBGW45FEVYWN7WC/birthEvent/birthPlace>;
        schema:deathDate               "1994-04-26";
        schema:deathPlace              <https://martial.is/entity/01KYT8RX5WJXBGW45FEVYWN7WC/deathEvent/deathPlace>;
        schema:description             "Founder of Kyokushin Karate, the first and most influential style of full contact karate. Born in Korea, Oyama trained in Shotokan under Gichin Funakoshi at Takushoku University, in Goju-ryu under Nei-chu So, and in Daito-ryu under Kotaro Yoshida. He won the first post-WWII All Japan Tournament in 1947, spent 18 months training in solitude on Mt. Kiyosumi, and opened his first dojo in 1953. He is legendary for fighting and defeating bulls bare-handed. Oyama established the International Karate Organization Kyokushinkaikan in 1964 and held the first All Japan Open Tournament in 1969 and the first World Open Tournament in 1975. He authored several books including What is Karate? (1958). He died of lung cancer in 1994.\n"@en;
        schema:keywords                "korean";
        schema:keywords                "full-contact";
