<https://martial.is/entity/01M06FKBQ1K6KP86BRFQR0JB7G>
        rdf:type                     martialis:Place;
        schema:alternateName         "Golden Square Dojo"@en;
        schema:description           "The first jujutsu dojo in the United Kingdom, established by Sadakazu Uyenishi in 1903 at 31 Golden Square,\nPiccadilly Circus, London. Uyenishi taught jujutsu, performed demonstrations and took on challengers here for\nfour years, including classes for the British Army and women's self-defence classes. He left the school in the\ncharge of his senior student William Garrud when he returned to Japan in late 1908; it continued through the\nGarruds and influenced the politicisation of jujutsu as women's self-defence. The building was demolished by 1930.\n"@en;
        schema:keywords              "historical";
        schema:keywords              "jujutsu";
        schema:name                  "日本式護身術学校"@ja;
