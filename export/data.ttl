<https://martial.is/entity/01M3YH7N5GMZBZB2H7SRK1SWRQ/hasInteraction/0/hasEvidence/0>
        rdf:type                      martialis:SourceAssertionRelation;
        martialis:basedOnSource       <https://martial.is/entity/01M55WK0XZ72RVHAYHKST7MJG1>;
        martialis:evidenceType        <https://w3id.org/martialis/vocab/evidence-type/direct>;
        martialis:informationType     infotype:secondary;
        martialis:quotation           "宮川太一郎嘉永元年（1848）生庄林又七郎の高弟・免許皆伝代々黒田家の臣である。一刀流剣術，自剛天真流組討を極め，明治10年(1877) 11月玄洋社附属の向浜塾で自剛天真流を教授したのが，後の明道館道場の起源とされている。大正9年(1920)6月20日77才にて病没。長男．宮川彦之助も目録まで進み，自剛天真流の普及に務めた。";
        martialis:sourceLocation      "113";
        martialis:sourceLocatorLabel  "page";
        martialis:supports            true .

