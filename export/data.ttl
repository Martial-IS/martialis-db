<https://martial.is/entity/01M0R7XFQ37N9VKSYF27WKCG1V>
        rdf:type                        martialis:Source;
        <http://purl.org/ontology/bibo/pages>  "67-76";
        <http://purl.org/ontology/bibo/volume>  "64";
        schema:datePublished            "2001-07-14";
        schema:description              "Undergraduate thesis on Mishima and kendo, reading his kendo fiction (\"Ken\", \"Honba\") through three viewpoints - watching, doing, dying - against the aesthetics of Sun and Steel. Biographically it dates his taking up kendo to around age thirty-three, about three years after he began physical training in 1955, records that he kept up practice unchanged until a few days before his death, and quotes Sun and Steel's \"kendo ni wa arayuru otoko-rashisa no bi ga gyoshu shite ita\" (\"all masculine beauty was condensed in kendo\"). It does not treat his teachers, dojos, dan grades or competition record."@en;
        schema:inLanguage               "ja";
        schema:keywords                 "kendo";
        schema:name                     "三島由紀夫と剣道";
        schema:publisher                <https://martial.is/entity/01M0R7XFQ37N9VKSYF27WKCG1V/publisher>;
        schema:url                      <https://doi.org/10.15002/00020174>;
