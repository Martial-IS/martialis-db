<https://martial.is/entity/01M3YH7N5FDR5TCXMT82E9AT6X/hasEvidence/0>
        rdf:type                   martialis:SourceAssertionRelation;
        schema:citation            "Joseph R. Svinth, \"Professor Yamashita Goes to Washington\", Journal of Combative Sport, Oct 2000";
        schema:url                 <https://ejmas.com/jcs/jcsart_svinth1_1000.htm>;
        martialis:evidenceType     <https://w3id.org/martialis/vocab/evidence-type/direct>;
        martialis:informationType  infotype:secondary;
        martialis:quotation        "Wanting to know the answer for himself, on Thursday, February 23, 1905 the President arranged a private match between Professor Yamashita and a middleweight catch-as-catch-can wrestler named Joseph Grant.";
        martialis:supports         true .

<https://martial.is/entity/01M3YH7N5G0QWDENX1HX2AWNCQ/hasInteraction/0/hasEvidence/1>
        rdf:type                   martialis:SourceAssertionRelation;
        martialis:basedOnSource    <https://martial.is/entity/01KZH5KBKXH1SZ0CCDVKPM2M31>;
        martialis:evidenceType     <https://w3id.org/martialis/vocab/evidence-type/direct>;
        martialis:informationType  infotype:secondary;
        martialis:quotation        "His father introduced him to Chojun Miyagi, who had been a neighbour of the family for many years [...] Miyazato's elder brother, Eiko, was a longtime student of Miyagi at his Garden Dojo [...] Following Miyagi's death, several of his senior students establish their own Goju-Ryu schools. At the age of 32 Miyazato took over the running of the Garden Dojo. This was at the request of Miyagi's family and his fellow students.";
        martialis:supports         true .

