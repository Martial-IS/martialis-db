<https://martial.is/entity/01KYFXCETRD92QSRTMDFPK7VTG>
        rdf:type                       martialis:Person;
        schema:alternateName           "Jae Chul Shin"@en;
        schema:alternateName           "Jae-chul Shin"@en;
        schema:birthDate               "1936-12-20";
        schema:birthPlace              <https://martial.is/entity/01KYFXCETRD92QSRTMDFPK7VTG/birthEvent/birthPlace>;
        schema:deathDate               "2012-07-09";
        schema:deathPlace              <https://martial.is/entity/01KYFXCETRD92QSRTMDFPK7VTG/deathEvent/deathPlace>;
        schema:description             "South Korean Tang Soo Do grandmaster and founder of the World Tang Soo Do Association (WTSDA). He began training under Hwang Kee at the Seoul Moo Duk Kwan Central Gym at age 12. He taught at Seoul Central YMCA and various police and military institutions. Recruited into the Korean Air Force in 1958, he taught martial arts to American soldiers at Osan Air Base, including Chuck Norris. He moved to the US in 1968, helped build the U.S. Tang Soo Do Federation, and later founded the WTSDA in 1982. He authored six volumes of the 'Traditional Tang Soo Do' series."@en;
