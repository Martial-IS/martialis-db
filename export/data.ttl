<https://martial.is/entity/01M0TQQ4D975QSE0N8QCTF2K9Z>
        rdf:type                martialis:Style;
        schema:alternateName    "Bokh"@en;
        schema:alternateName    "Mongolian wrestling"@en;
        schema:alternateName    "Buku"@en;
        schema:description      "Bökh is the folk wrestling tradition of the Mongols, practised across Mongolia, Inner\nMongolia, and Mongol-descended communities such as the Buryat and Kalmyk. It is one of the\n\"three manly games\" (naadam) alongside horse racing and archery, with regional variants\nincluding Khalkha bökh, Buryat wrestling, Oirat wrestling, and the Tuvan Khuresh. Depictions\nof grappling on Xiongnu-era bronzes suggest antiquity of over two millennia. Under the Qing\ndynasty, the Manchu adopted Mongol bökh, terming it buku (布庫), and formed the Shan Pu Ying\n(善撲營), an elite imperial wrestling battalion of Manchu and Mongol bannermen based in\nBeijing; that lineage is cited as a direct ancestor of the modern Chinese jacket-wrestling\ntradition, shuai jiao.\n"@en;
        schema:image            <https://martial.is/entity/01M0TQQ4D975QSE0N8QCTF2K9Z/photos/0>;
        schema:keywords         "mongolian-wrestling";
        schema:keywords         "naadam";
        schema:keywords         "folk-wrestling";
        schema:name             "Bökh"@en;
        schema:name             "Bökh"@mn-Latn;
        schema:sameAs           <http://www.wikidata.org/entity/Q1207182>;
        martialis:foundedEvent  <https://martial.is/entity/01M0TQQ4D975QSE0N8QCTF2K9Z/foundedEvent>;
        martialis:hasEvidence   <https://martial.is/entity/01M0TQQ4D975QSE0N8QCTF2K9Z/hasEvidence/0>;
        martialis:styleType     <https://w3id.org/martialis/vocab/style-classification/traditional> .

