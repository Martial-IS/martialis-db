<https://martial.is/entity/01M5JGQAC7V7W1GTRS53NMNXYY>
        rdf:type                martialis:Style;
        schema:alternateName    "Vigny stick fighting"@en;
        schema:alternateName    "Self-defence with a walking stick"@en;
        schema:description      "Self-defence method with the walking stick and umbrella, founded by Pierre Vigny around 1898 in Geneva from a heavily modified canne de combat. It used high, double-handed guards and strikes to the head, hands and joints. Vigny taught it at Barton-Wright's Bartitsu Club and at his own London academy; Barton-Wright described it in Pearson's Magazine (1901), and H. G. Lang's book The Walking Stick Method of Self Defence (1923) drew on it."@en;
        schema:keywords         "stick-fighting";
        schema:keywords         "weapons";
        schema:keywords         "bartitsu";
        schema:keywords         "self-defence";
        schema:name             "Vigny method"@en;
        martialis:foundedEvent  <https://martial.is/entity/01M5JGQAC7V7W1GTRS53NMNXYY/foundedEvent>;
