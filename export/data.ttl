<https://martial.is/entity/01KZKWYWG3THWY668CPXZAYG68>
        rdf:type                        martialis:Source;
        schema:archivedAt               <https://web.archive.org/web/20260607113409/https://milos.io/interview-with-hohan-soken-2/>;
        schema:datePublished            "1978";
        schema:description              "Second part of the 1978 interview with Hohan Soken, \"made by Ernest Estrada\", hosted on milos.io. Primary source for Soken's kata and weaponry: he teaches the Matsumura kata - pinan shodan and nidan, naihanchi shodan and nidan, patsai-sho and dai, chinto, gojushiho, kusanku, rohai ichi-ni- san, and hakutsuru - naming the Matsumura kusanku (the older version) the best kata of his youth; he also teaches bo, sai, tuifa, kama, nunchaku, kusarigama and suruchin, his favorite weapons form being tsukenbo (learned from Komesu Ushi). States he knew Taira Shinken well and taught him some of his older forms, formed the All Okinawa Kobujutsu Association in 1970, and is a member of the Ryukyu Historical Society. Discusses the old Okinawan grappling art \"ti\" (also \"te-kumi\" or \"gyaku-te\") and Soken's views on kata naming and village traditions."@en;
        schema:inLanguage               "en";
        schema:keywords                 "kobudo";
        schema:keywords                 "shorin-ryu";
        schema:keywords                 "karate";
        schema:name                     "Interview with Hohan Soken, Matsumura's Grandson - Part II (milos.io)";
        schema:publisher                <https://martial.is/entity/01KZKWYWG3THWY668CPXZAYG68/publisher>;
        schema:url                      <https://milos.io/interview-with-hohan-soken-2/>;
        martialis:accessed              "2026-10-18";
        martialis:archiveDate           "2026-06-07";
        martialis:earliestYear          1978;
        martialis:hasContributor        <https://martial.is/entity/01KZKWYWG3THWY668CPXZAYG68/hasContributor/0>;
        martialis:latestYear            1978;
        martialis:sourceClassification  srcclass:original;
        martialis:sourceGenre           <https://w3id.org/martialis/vocab/source-genre/interview>;
        martialis:sourceType            "interview" .

