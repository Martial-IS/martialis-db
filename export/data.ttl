<https://martial.is/entity/01M55JW66WQ4TFVS60NVJF6MPC>
        rdf:type                        martialis:Source;
        schema:archivedAt               <https://web.archive.org/web/20261017234613/https://www.guillaumeerard.com/daito-ryu-aiki-jujutsu/articles-daito-ryu-aiki-jujutsu/a-closer-look-into-the-connection-between-hisa-takuma-and-kobayashi-hirokazu>;
        schema:datePublished            "2019-02-05";
        schema:description              "Guillaume Erard's examination of the claimed link between Kobayashi Hirokazu and Hisa Takuma's Daito-ryu, drawing on interviews with Kobayashi Kiyohiro, Kimura Jiro and senior Takumakai students. Concludes that Kobayashi was not a Daito-ryu shihan; notes his 8th dan from the Aikikai in 1970 and that he remained an Aikikai shihan."@en;
