<https://martial.is/entity/01KJJAWN29MA64W22606R3WD93/hasEvidence/0>
        rdf:type                   martialis:SourceAssertionRelation;
        schema:archivedAt          <https://ru.wikipedia.org/w/index.php?title=%D0%A5%D0%B0%D1%80%D0%BB%D0%B0%D0%BC%D0%BF%D0%B8%D0%B5%D0%B2%2C_%D0%90%D0%BD%D0%B0%D1%82%D0%BE%D0%BB%D0%B8%D0%B9_%D0%90%D1%80%D0%BA%D0%B0%D0%B4%D1%8C%D0%B5%D0%B2%D0%B8%D1%87&oldid=155176641>;
        schema:citation            "Russian Wikipedia - Kharlampiyev biography";
        schema:url                 <https://ru.wikipedia.org/wiki/%D0%A5%D0%B0%D1%80%D0%BB%D0%B0%D0%BC%D0%BF%D0%B8%D0%B5%D0%B2,_%D0%90%D0%BD%D0%B0%D1%82%D0%BE%D0%BB%D0%B8%D0%B9_%D0%90%D1%80%D0%BA%D0%B0%D0%B4%D1%8C%D0%B5%D0%B2%D0%B8%D1%87>;
        martialis:evidenceType     <https://w3id.org/martialis/vocab/evidence-type/direct>;
        martialis:informationType  infotype:secondary;
        martialis:quotation        "В 1936 г. окончил Государственный центральный ордена Ленина институт физической культуры (отделение дзюдо Василия Сергеевича Ощепкова) [...] Создавая «систему самбо», Харлампиев тщательно изучал дзюдо и осваивал его на практике. В дзюдо он видел основание нового вида борьбы в одежде, обогащённого наиболее эффективными приёмами других видов борьбы. Дзюдо он осваивал под руководством Василия Сергеевича Ощепкова, который во время многолетнего пребывания в Японии тренировался в школе дзюдо Кодокан.";
        martialis:supports         true .

<https://martial.is/entity/01KJJAWN29MA64W22606R3WD8R/hasEvidence/0>
