<https://martial.is/entity/01M01BRGEBCYBZJWTPVFCWMEZ0>
        rdf:type                        martialis:Source;
        schema:alternateName            "Biografie";
        schema:archivedAt               <https://web.archive.org/web/20201204173501/https://jonbluming.nl/index.php?option=com_content&view=article&id=5&Itemid=7&lang=nl>;
        schema:description              "Official biography of Jon Bluming published on his own site. Records that he joined the Tung Jen judo club in Amsterdam in November 1953, that his sensei Dr G. Schutte gave him his 1st dan after only 12 months, that Opa Schutte was a 4th dan from Tokio Hirano at that time, that he received his 3rd dan from Tokio Hirano in 1957 after throwing 75 judoka in 26 minutes, and that in November 1959 the elderly man he had seen at the Kodokan in 1951 (Kyuzo Mifune) became his head teacher when he joined the famous Kenshusei class of the 25 best fighters in Japan. Also records training under Donn Draeger, Shimizu and Kuroda in bo-jitsu, kendo and iai-jitsu."@en;
        schema:inLanguage               "en";
        schema:name                     "Biography of Jon Bluming - jonbluming.nl";
