<https://martial.is/entity/01M19SYYS39J2PATCE5P8DWV7N>
        rdf:type                    martialis:Event;
        schema:about                <https://martial.is/entity/01KJJAWN29MA64W22606R3WD9B>;
        schema:alternateName        "Yamashita at Annapolis (1905-1906)"@en;
        schema:description          "Yamashita Yoshiaki's judo instruction at the United States Naval Academy, which he took up in January 1905 at President Roosevelt's insistence instead of a proposed Harvard appointment. The first semester ran Monday, Wednesday, and Friday afternoons with about 25 midshipmen. After the Academy declined to rehire him for the fall, Roosevelt intervened through Secretary of the Navy Charles J. Bonaparte, and on 4 December 1905 Admiral Sands signed a contract for fifty one-hour lessons taught during the first half of 1906."@en;
        schema:description          "山下義韶がルーズベルト大統領の強い勧めでハーバード大学案を断り、1905年1月から米海軍兵学校で行った柔道 指導。最初の学期は月・水・金の午後、士官候補生約25名を教えた。秋の再雇用を見送られたが、ルーズベルトが 海軍長官ボナパルトを通じて介入し、1905年12月4日にサンズ少将が50時間（1時間33.33ドル）の契約を締結、 1906年前半に授業が行われた。"@ja;
        schema:keywords             "annapolis";
        schema:keywords             "kodokan";
        schema:location             <https://martial.is/entity/01M19SYYS39J2PATCE5P8DWV7N/location>;
        schema:name                 "米海軍兵学校柔道課程"@ja;
        schema:name                 "US Naval Academy Judo Course"@en;
        schema:startDate            "1905-01/1906-06";
        schema:superEvent           <https://martial.is/entity/01M19SYYS3JXJSD3JGQ89RG6SM>;
        martialis:earliestYear      1905;
        martialis:eventType         <https://w3id.org/martialis/vocab/event-classification/course>;
        martialis:hasEvidence       <https://martial.is/entity/01M19SYYS39J2PATCE5P8DWV7N/hasEvidence/1>;
