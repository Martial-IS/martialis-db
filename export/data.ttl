<https://martial.is/entity/01KZC8S2GEGBJJT9RKV5M0HJ3N>
        rdf:type                martialis:Style;
        schema:alternateName    "Goju Ryu"@en;
        schema:alternateName    "hard-soft style"@en;
        schema:description      "Goju-ryu (剛柔流, \"hard-soft style\") is one of the main traditional Okinawan styles of\nkarate, founded by Chojun Miyagi in 1930 on the Naha-te tradition of his teacher\nHigaonna Kanryo. It combines hard, linear strikes with soft, circular open-hand\ntechniques, joint locks and throws, and emphasizes breathing in the core kata\nSanchin and Tensho.\n"@en;
