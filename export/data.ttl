<https://martial.is/entity/01M07HCGJG800WTN7180ZGA0BQ>
        rdf:type                        martialis:Source;
        schema:archivedAt               <https://en.wikipedia.org/w/index.php?title=Edith_Garrud&oldid=1377855648>;
        schema:datePublished            "2026";
        schema:description              "English Wikipedia article on Edith Garrud (1872-1971), née Edith Margaret Williams, the first British female\nteacher of jujutsu and one of the first female martial arts instructors in the Western world. Documents her\nintroduction to jujutsu in 1899 alongside her husband William Garrud, their study under Yukio Tani and Sadakazu\nUyenishi at the Bartitsu School of Arms and continued training under Uyenishi at the Golden Square Dojo, their\ntaking over the dojo at the end of 1908, her own School of Ju-jutsu at Argyll Place from about 1909, the\nSuffragettes' Self-Defence Club offered to WSPU members, and her 1913 training of the WSPU Bodyguard. Cites\nCrawford (2003), Kelly (2019), Royal Armouries (2018), Green & Svinth (2010), Godfrey (2010/2012), Looser (2011),\nRouse (2017) and Callan/Heffernan/Spenn (2018).\n"@en;
        schema:inLanguage               "en";
        schema:keywords                 "united-kingdom";
        schema:keywords                 "secondary-source";
