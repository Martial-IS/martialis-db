<https://martial.is/entity/01M2WGWA1YG2SSC4PASW0TXXQC>
        rdf:type                       martialis:Person;
        schema:alternateName           "Takano Sasaburo"@en;
        schema:alternateName           "靖斎"@ja;
        schema:alternateName           "豊正"@ja;
        schema:alternateName           "Takano Sasaburou"@en;
        schema:birthDate               "1862-07-09";
        schema:birthPlace              <https://martial.is/entity/01M2WGWA1YG2SSC4PASW0TXXQC/birthEvent/birthPlace>;
        schema:deathDate               "1950-12-30";
        schema:deathPlace              <https://martial.is/entity/01M2WGWA1YG2SSC4PASW0TXXQC/deathEvent/deathPlace>;
        schema:description             "One of the two leading authorities in early Shōwa kendo (alongside Nakayama Hakudo), known as \"昭和の剣聖\" (Shōwa's Sword Saint). Trained in Nakanishi-ha Ittō-ryū from his grandfather Takano Sakichirō, then studied under Yamaoka Tesshu. Served as a gekken instructor for the Tokyo Metropolitan Police from 1886, then transferred to the Saitama prefectural police as martial-arts instructor in 1888, rising to keibu. Founded the Meishinkan dojo in Urawa (1890) and later Shudogakuin (1918). Lecturer, then (from 1916) professor, at Tokyo Higher Normal School (1908–1936), where he implemented the dan and kyu ranking system for kendo. Served on the Dai-Nippon Teikoku Kenjutsu Kata Committee (1911–1912), producing the ten-form Dai-Nippon Teikoku Kenjutsu Kata ratified by the Butokukai on 16 October 1912. Awarded the title of hanshi by the Butokukai in 1913, and Junior Fourth Rank and the Order of the Sacred Treasure, 4th class, in 1936. Author of the influential kendo textbook 剣道 (1915). Posthumously inducted into the All Japan Kendo Federation's Kendo Hall of Fame (2003)."@en;
        schema:keywords                "police-kenjutsu";
        schema:keywords                "showa-no-kensei";
        schema:keywords                "itto-ryu";
        schema:keywords                "kendoka";
        schema:name                    "高野 佐三郎"@ja;
        schema:name                    "Takano Sasaburō"@en;
        schema:nationality             <https://martial.is/entity/01M2WGWA1YG2SSC4PASW0TXXQC/nationality/0>;
