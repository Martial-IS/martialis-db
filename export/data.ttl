<https://martial.is/entity/01M06K0RMZQGVPYVTGDGGGQX17>
        rdf:type                       martialis:Person;
        schema:alternateName           "William Herbert Garrud"@en;
        schema:birthDate               "1873";
        schema:deathDate               "1960";
        schema:description             "British physical culture instructor (specialised in boxing and wrestling) who became a pioneering jujutsu\ninstructor. Introduced to jujutsu in 1899 alongside his wife Edith, he studied under Yukio Tani and Sadakazu\nUyenishi, first at the Bartitsu School of Arms and then at the Golden Square dojo, and also trained with Taro\nMiyake, Mitsuyo Maeda, Gunji Koizumi and Akitaro Ohno there. When Uyenishi left for Japan in 1908, Garrud took over\nthe Golden Square dojo, running it with Edith until their retirement in 1925. Wrote \"The Complete Jujitsuan\" (1914),\ndedicated to \"Professor S.K. Uyenishi 'Raku'\", which became a standard jujitsu/judo text republished at least seven\ntimes. During the First World War he trained the Volunteer Civil Force in jujutsu.\n"@en;
        schema:keywords                "physical-culture";
        schema:keywords                "united-kingdom";
        schema:keywords                "jujutsu";
        schema:keywords                "pioneer";
        schema:name                    "William Garrud"@en;
        schema:nationality             <https://martial.is/entity/01M06K0RMZQGVPYVTGDGGGQX17/nationality/0>;
        schema:sameAs                  <http://dbpedia.org/resource/William_Garrud>;
        schema:sameAs                  <http://www.wikidata.org/entity/Q96745680>;
        martialis:birthEvent           <https://martial.is/entity/01M06K0RMZQGVPYVTGDGGGQX17/birthEvent>;
        martialis:deathEvent           <https://martial.is/entity/01M06K0RMZQGVPYVTGDGGGQX17/deathEvent>;
        martialis:hasEvidence          <https://martial.is/entity/01M06K0RMZQGVPYVTGDGGGQX17/hasEvidence/2>;
        martialis:hasEvidence          <https://martial.is/entity/01M06K0RMZQGVPYVTGDGGGQX17/hasEvidence/0>;
