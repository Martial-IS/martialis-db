<https://martial.is/entity/01KZXXSBA3FJP0S8FFBH3972MP>
        rdf:type                       martialis:Person;
        schema:birthDate               "1923-08-16";
        schema:birthPlace              <https://martial.is/entity/01KZXXSBA3FJP0S8FFBH3972MP/birthEvent/birthPlace>;
        schema:deathDate               "2012-08-02";
        schema:deathPlace              <https://martial.is/entity/01KZXXSBA3FJP0S8FFBH3972MP/deathEvent/deathPlace>;
        schema:description             "Belgian judo pioneer, credited with introducing the sport to Belgium. Studied judo formally for the first time in Berlin in January 1941 at the school of Erich Rahn, the first Belgian to do so, continuing until 1943. Founded the first Belgian judo club, the Judo and Jujutsu Academy Bushido-Kwai, at Schelle on 20 May 1946; a Mechelen branch followed on 14 March 1951 and in 1996 the club became the first in Belgium to be granted the Royal predicate. Promoted to shodan in September 1952 and from that year a first-generation, dedicated student of Tokio Hirano. Pioneer of judo instruction to the Belgian police from the early 1950s and of children's and women's judo programmes. His notable students include Carl De Crée and Jeannine Meulemans. The city of Mechelen named its new combat sports hall after him in October 2012, following his death in August of that year."@en;
        schema:name                    "Felix De Smedt"@nl;
        schema:nationality             <https://martial.is/entity/01KZXXSBA3FJP0S8FFBH3972MP/nationality/0>;
        schema:sameAs                  <http://www.wikidata.org/entity/Q5442183>;
