<https://martial.is/entity/01M1BVV4WY6PPJN89RGFSJNA23>
        rdf:type                       martialis:Person;
        schema:birthDate               "1844-01-15";
        schema:birthPlace              <https://martial.is/entity/01M1BVV4WY6PPJN89RGFSJNA23/birthEvent/birthPlace>;
        schema:deathDate               "1913-09-15";
        schema:deathPlace              <https://martial.is/entity/01M1BVV4WY6PPJN89RGFSJNA23/deathEvent/deathPlace>;
        schema:description             "Negishi Shingorō (1844-1913) was a samurai from Nagaoka Domain and the 6th and last Edo-period\nheadmaster of Shindō Munen-ryū kenjutsu. He opened the Yūshinkan dojo in Tokyo in 1885 and taught\nswordsmanship to the Tokyo Metropolitan Police Force. A participant in the Boshin War and survivor\nof the Battle of Hokuetsu, he was declared Hanshi of Shindō Munen-ryū by the Dai Nippon Butokukai\nin 1906 and served on the committee that created the Dai Nippon Teikoku Kendo Kata in 1912. His most\nfamous student was Nakayama Hakudō, whom he also adopted as his son.\n"@en;
        schema:keywords                "yushinkan";
        schema:keywords                "kenjutsu";
        schema:keywords                "kendo";
