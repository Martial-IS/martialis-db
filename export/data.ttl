<https://martial.is/entity/01KZXH2NSQMBZTRPPYAKKCFR84>
        rdf:type                       martialis:Person;
        schema:birthDate               "1922-11-12";
        schema:birthPlace              <https://martial.is/entity/01KZXH2NSQMBZTRPPYAKKCFR84/birthEvent/birthPlace>;
        schema:deathDate               "2022-02-27";
        schema:deathPlace              <https://martial.is/entity/01KZXH2NSQMBZTRPPYAKKCFR84/deathEvent/deathPlace>;
        schema:description             "Japanese judoka of the Kodokan, one of only fifteen judoka to attain 10th dan. Arriving in Toulouse in November 1951 as the first official envoy of the Kodokan in Europe, he served as technical advisor at the Shudokan club of the Lasserre brothers, where French professors such as Pierre Roussel, Jacques Belaud, Luc Levannier and Guy Pelletier studied under him; the resulting Kodokan-versus-Kawaishi dispute produced the Union Fédérale des Amateurs du Judo Kodokan (October 1954) and its 1956 union with the Fédération française de judo et jiu-jitsu. He left France for Brussels in 1953, was technical director of the Belgian Judo Association, technical advisor of the European Judo Union from 1955, and headed the Kodokan's international department from 1969 until his death in 2022."@en;
        schema:name                    "安部 一郎"@ja;
        schema:name                    "Abe Ichirō"@ja-Latn;
