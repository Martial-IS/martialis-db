<https://martial.is/entity/01KYF39J6HSNDTTW9532CVQX6T>
        rdf:type                       martialis:Person;
        schema:alternateName           "김신락"@ko;
        schema:alternateName           "百田 光浩"@ja;
        schema:alternateName           "Momota Mitsuhiro"@ja-Latn;
        schema:alternateName           "Kim Sin-rak"@ko-Latn;
        schema:birthDate               "1924-11-14";
        schema:birthPlace              <https://martial.is/entity/01KYF39J6HSNDTTW9532CVQX6T/birthEvent/birthPlace>;
        schema:deathDate               "1963-12-15";
        schema:deathPlace              <https://martial.is/entity/01KYF39J6HSNDTTW9532CVQX6T/deathEvent/deathPlace>;
        schema:description             "Rikidōzan (1924–1963), born Kim Sin-rak, was a Korean-born Japanese professional wrestler and the 'Father of Japanese Professional Wrestling'. Initially a sumo wrestler, he founded the Japan Pro Wrestling Alliance in 1953 and became Japan's first post-war hero by defeating American wrestlers. He trained Antonio Inoki, who later founded New Japan Pro-Wrestling. Rikidōzan was stabbed by a yakuza member and died in 1963 at age 39."@en;
        schema:description             "力道山（1924–1963）は、朝鮮出身で日本に帰化したプロレスラー。「日本プロレス界の父」と呼ばれる。元大相撲関脇からプロレスに転向し、1953年に日本プロレス協会を設立。空手チョップを武器にアメリカ人レスラーを次々と破り、戦後日本の英雄となった。アントニオ猪木を育成。1963年に刺殺された。"@ja;
        schema:keywords                "professional-wrestling";
        schema:keywords                "japan-pro-wrestling-alliance";
        schema:keywords                "fathers-of-puroresu";
        schema:keywords                "sumo";
        schema:name                    "Rikidōzan"@en;
        schema:name                    "Rikidōzan"@ja-Latn;
