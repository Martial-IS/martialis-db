<https://martial.is/entity/01M3YH7N5GTCJWB8YQKKRDQ3FY/hasEvidence/0>
        rdf:type                   martialis:SourceAssertionRelation;
        schema:citation            "11 лет занятий с Анатолием Соломоновичем (fondsambo.ru)";
        schema:url                 <https://fondsambo.ru/news/detail.php?ELEMENT_ID=26984>;
        martialis:evidenceType     <https://w3id.org/martialis/vocab/evidence-type/direct>;
        martialis:informationType  infotype:secondary;
        martialis:quotation        "11 лет занятий с Анатолием Соломоновичем помогли будущему политическому лидеру России стать мастером спорта сначала по самбо, а потом по дзюдо.  Владимир Путин приглашал Анатолия Рахлина на значимые события своей жизни – от дней рождений до президентских инаугураций. Такие отношения можно без преувеличения назвать дружескими.";
        martialis:supports         true .

