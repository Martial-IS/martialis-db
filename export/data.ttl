<https://martial.is/entity/01KZC8S2GE36BYCWA3TP1H63F3>
        rdf:type                martialis:Style;
        schema:alternateName    "Ki no Michi"@en;
        schema:description      "Kinomichi (氣之道) is a martial art in the budo tradition, developed from aikido by\nMasamichi Noro, one of Morihei Ueshiba's uchi-deshi and his designated delegate for\nEurope and Africa, and founded in Paris in 1979. In France it is affiliated with the\nFFAAA and maintains relations with the Aikikai Foundation. It is practiced mainly in\nFrance and other European countries.\n\nRank system note: Kinomichi does not use the aikido dan/kyu system; progression is by \"stages\" (niveaux) under Noro's teaching, with no belt grades."@en;
        schema:keywords         "aikido";
        schema:keywords         "budo";
        schema:keywords         "gendai";
        schema:name             "氣之道"@ja;
        schema:name             "Kinomichi"@en;
        schema:name             "Kinomichi"@ja-Latn;
        schema:sameAs           <http://www.wikidata.org/entity/Q748067>;
        martialis:foundedEvent  <https://martial.is/entity/01KZC8S2GE36BYCWA3TP1H63F3/foundedEvent>;
