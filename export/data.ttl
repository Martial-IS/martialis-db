<https://martial.is/entity/01M0GB2Q6QR46XPZP0Y8RCNFXS>
        rdf:type               martialis:Person;
        schema:alternateName   "Shinzo Murayama"@es;
        schema:alternateName   "Shinsho Siosaki Murayama"@es;
        schema:alternateName   "Shinzo Shiozaki"@es;
        schema:birthDate       "1905-03-27";
        schema:birthPlace      <https://martial.is/entity/01M0GB2Q6QR46XPZP0Y8RCNFXS/birthEvent/birthPlace>;
        schema:description     "Japanese-born pioneer of judo in Peru. Born Shinzo Shiozaki in Kumamoto Prefecture in 1905, he started judo at age 12 and arrived in Peru at age 25 (c. 1930) with the aim of spreading the art. He was Alfredo San Bartolomé Morello's first judo teacher in Lima (1931-1936) and is regarded as the pioneer of judo's diffusion and development in Peru. Arequipa's Club Shinzo Murayama (founded 1992) and its annual Copa Shinzo Murayama tournament are named in his honour."@en;
        schema:keywords        "peru";
        schema:keywords        "japan";
        schema:keywords        "pioneer";
