<https://martial.is/entity/01M19SYYS3VTD98FGQQXEEMMJW>
        rdf:type                    martialis:Event;
        schema:about                <https://martial.is/entity/01KJJAWN29MA64W22606R3WD9B>;
        schema:alternateName        "Yamashita Teaches Theodore Roosevelt (1904)"@en;
        schema:description          "The judo instruction Theodore Roosevelt received from Yamashita Yoshiaki in the White House. The naval attaché Isamu Takeshita arranged the meeting in March 1904; impressed by the demonstration, Roosevelt engaged Yamashita on the spot, and during March and April 1904 he practiced judo three afternoons a week in a ground floor White House office, then occasionally through the summer before the elections. His training partners included his sons, his private secretary, Takeshita, Secretary of War William Howard Taft, and Secretary of the Interior Gifford Pinchot."@en;
        schema:description          "1904年3月、海軍武官の竹下勇の仲介で山下義韶がホワイトハウスでセオドア・ルーズベルト大統領と会見し、 その場で柔道指導が決まった。3月から4月にかけて大統領は週3回の午後、ホワイトハウス一階の執務室で稽古し、 夏の間は時折続けた後、選挙のため中断した。稽古相手は息子たち、私設秘書、竹下、陸軍長官タフト、 内務長官ピンショーら。"@ja;
        schema:keywords             "white-house";
        schema:keywords             "theodore-roosevelt";
        schema:keywords             "kodokan";
        schema:location             <https://martial.is/entity/01M19SYYS3VTD98FGQQXEEMMJW/location>;
        schema:name                 "ホワイトハウス柔道稽古"@ja;
        schema:name                 "Roosevelt's White House Judo Course"@en;
        schema:startDate            "1904-03/1904-04";
        schema:superEvent           <https://martial.is/entity/01M19SYYS3JXJSD3JGQ89RG6SM>;
        martialis:earliestYear      1904;
        martialis:eventType         <https://w3id.org/martialis/vocab/event-classification/course>;
        martialis:hasEvidence       <https://martial.is/entity/01M19SYYS3VTD98FGQQXEEMMJW/hasEvidence/0>;
        martialis:hasEvidence       <https://martial.is/entity/01M19SYYS3VTD98FGQQXEEMMJW/hasEvidence/1>;
        martialis:hasParticipation  <https://martial.is/entity/01M3YH7N5FYCHGJ5PQHS7TTSKG>;
        martialis:latestYear        1904 .

