<https://martial.is/entity/01KZW2JNB8KPAZ0XJ7J66FYMYX>
        rdf:type                       martialis:Person;
        schema:alternateName           "Antonius Johannes Geesink"@en;
        schema:birthDate               "1934-04-06";
        schema:birthPlace              <https://martial.is/entity/01KZW2JNB8KPAZ0XJ7J66FYMYX/birthEvent/birthPlace>;
        schema:deathDate               "2010-08-27";
        schema:deathPlace              <https://martial.is/entity/01KZW2JNB8KPAZ0XJ7J66FYMYX/deathEvent/deathPlace>;
        schema:description             "Dutch judoka, the first non-Japanese to become World Champion (1961, again 1965) and Olympic Champion (1964, open class, beating Akio Kaminaga in Tokyo). Won a record 21 European Championship titles. Awarded 9th dan in 1986 (first European) and the 10th dan by the International Judo Federation in 1997 - one of only three 10th-dan judoka outside Japan. Quit competitive judo in 1967, spent 1973-1974 training for a professional wrestling career under the Funks in Amarillo, Texas, and later held top IJF and IOC positions."@en;
