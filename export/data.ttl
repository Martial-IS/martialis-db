<https://martial.is/entity/01KZGJHHWJDZE5RVTT212FW2FY>
        rdf:type                        martialis:Source;
        schema:archivedAt               <https://web.archive.org/web/20260616180525/https://budojapan.com/karate/dm11e/>;
        schema:datePublished            "2024";
        schema:description              "Budo Japan interview (HIDEN March 2024) with Higa Minoru, second Kancho of the Okinawa Kobayashi Shorin-ryu Karate Kyudokan. Confirms the Kyudokan hombu dojo in Tsuboya was founded in 1954 by Grand Master Higa Yuchoku (1910-1994), Hanshi 10th dan, after whom Minoru took over as second Kancho. Includes recollections of Yuchoku Sensei as a strict teacher (the \"Dojo of the demons\"), his development of the Gosun Tsuki technique, and that the Kyudokan Jion kata descends from Hanashiro Chomo."@en;
        schema:inLanguage               "en";
        schema:keywords                 "kyudokan";
        schema:keywords                 "interview";
        schema:keywords                 "shorin-ryu";
        schema:keywords                 "karate";
        schema:name                     "Exploring the Spirit of the Ryukyu: Higa Minoru Sensei";
        schema:publisher                <https://martial.is/entity/01KZGJHHWJDZE5RVTT212FW2FY/publisher>;
        schema:url                      <https://budojapan.com/karate/dm11e/>;
