<https://martial.is/entity/01M5JG4Y259ZBY4V9XPJQ111DJ/hasEvidence/1>
        rdf:type                   martialis:SourceAssertionRelation;
        martialis:basedOnSource    <https://martial.is/entity/01M5JG4Y25PWNDPQYVGE1CQJQC>;
        martialis:evidenceType     <https://w3id.org/martialis/vocab/evidence-type/direct>;
