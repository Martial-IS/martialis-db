<https://martial.is/entity/01M37J0JPX4F4E9V115VE71QVP>
        rdf:type                    martialis:Event;
        schema:about                <https://martial.is/entity/01KYHNJKQDTEJ1A5MQ5JYPHDTB>;
        schema:description          "First of the paid public fencing exhibitions organised by Sakakibara Kenkichi, held over twelve days at a makeshift arena by the riverbank in Asakusa. Eighty-eight fighters competed in three ranks, the first class being ten Jikishin Kage-ryū fencers, the second thirty-six students of Sakakibara, the third forty fighters including women. Matches followed Kōbusho rules, best of three points with neutral adjudicators, and members of the public could register to challenge the fencers. Scheduled for ten days and extended by demand, it ended abruptly when a fire at the imperial palace halted all entertainment in Tokyo."@en;
        schema:keywords             "kenjutsu";
        schema:keywords             "japan";
        schema:keywords             "gekiken";
        schema:location             <https://martial.is/entity/01M37J0JPX4F4E9V115VE71QVP/location>;
        schema:name                 "First gekiken-kōgyō, Asakusa (1873)"@en;
        schema:name                 "撃剣興行"@ja;
        schema:startDate            "1873-04-26/1873-05-05";
        martialis:earliestYear      1873;
        martialis:eventType         <https://w3id.org/martialis/vocab/event-classification/demonstration>;
