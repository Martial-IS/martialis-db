<https://martial.is/entity/01M00NPBTPK4B6WA568VV9RAP4>
        rdf:type                        martialis:Source;
        <http://purl.org/ontology/bibo/issue>  "1";
        <http://purl.org/ontology/bibo/pages>  "187-203";
        <http://purl.org/ontology/bibo/volume>  "64";
        schema:alternateName            "1940-1944 年の占領期パリにおける柔道の確立：フランス柔術クラブの活動を中心に";
        schema:archivedAt               <https://web.archive.org/web/20240727202732/https://www.jstage.jst.go.jp/article/jjpehss/64/1/64_18055/_article/-char/en>;
        schema:datePublished            "2019";
        schema:description              "Peer-reviewed article (pp. 187-203) by Utsuru Hoshino (Konan University) on how judo was practiced in German-occupied Paris and acquired the status of a sport in France, centred on the Jiu-Jitsu Club de France and its judoka, especially Paul Bonét-Maury, president of the club, and Mikinosuke Kawaishi, who provided technical guidance. Documents the club's low-key demonstrations, Kawaishi's teaching method (color belts, high membership fees), the club's entry into the French Wrestling Federation in 1942, and the First French Judo Championship in late May 1943."@en;
