<https://martial.is/entity/01M0NTD84XCD4EY76QXD0D2KTX>
        rdf:type                       martialis:Person;
        schema:birthDate               "1912";
        schema:deathDate               "1988";
        schema:description             "Spanish judo pioneer; first Spanish black belt (Kodokan 1st dan, 22 July 1954, Ichiro Abe); trained under Alfredo San Bartolomé (1948–1957) and Kawaishi Mikinosuke (green belt 1952, brown belt 1953); founded Gimnasio Samurái (1958); disseminated judo into state institutions and Real Madrid; published Cinturón Negro de Judo (1971); awarded 7th dan posthumously by RFEJYDA; traveled to France to study Kawaishi's method; connected to Haku Michigami via trips from Madrid to Bordeaux."@en;
        schema:keywords                "spain";
        schema:keywords                "pioneer";
