<https://martial.is/entity/01M0A2FCGS8SSMPCGQ4BBNYH4M>
        rdf:type                       martialis:Person;
        schema:alternateName           "Mrs Roger Watts"@en;
        schema:alternateName           "Diana Watts"@en;
        schema:birthDate               "1867";
        schema:birthPlace              <https://martial.is/entity/01M0A2FCGS8SSMPCGQ4BBNYH4M/birthEvent/birthPlace>;
        schema:deathDate               "1968";
        schema:deathPlace              <https://martial.is/entity/01M0A2FCGS8SSMPCGQ4BBNYH4M/deathEvent/deathPlace>;
        schema:description             "Among the first female instructors of jujitsu in the Western world, and an innovator in physical culture. By 1903\nshe joined the Golden Square dojo of Uyenishi and Akitaro Ono in London, and by 1906 was teaching her own class of\nboys at the Prince's Skating Club. Her 1906 book The Fine Art of Jujitsu was the first English-language work to\ndetail Kodokan judo kata (nage no kata). Her 1914 The Renaissance of the Greek Ideal presented an original system\nof calisthenics inspired by Greek statuary, and she spent four decades on the international lecture circuit.\n"@en;
        schema:keywords                "united-kingdom";
        schema:keywords                "women-jujutsu";
        schema:keywords                "jujutsu";
        schema:keywords                "pioneer";
        schema:name                    "Emily Diana Watts"@en;
