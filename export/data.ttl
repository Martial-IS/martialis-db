<https://martial.is/entity/01M19K1VNMRK7QWDQ7PQ5VN5XX>
        rdf:type                    martialis:Event;
        schema:about                <https://martial.is/entity/01KJJAWN29MA64W22606R3WD9V>;
        schema:about                <https://martial.is/entity/01KJJAWN29MA64W22606R3WD9B>;
        schema:alternateName        "Yayoi Shrine Police Gekken Tournament (jujutsu matches)"@en;
        schema:alternateName        "Kodokan–Totsuka Rivalry Matches"@en;
        schema:description          "The jujutsu matches of the 1886 Metropolitan Police (Keishichō) gekken tournament, held at the Yayoi Shrine in Shiba Park: Kodokan judoka - Yokoyama Sakujirō, Saigō Shirō, Yamashita Yoshitsugu and others - faced koryū jūjutsu men, mostly Totsuka-ha Yōshin-ryū disciples, in a series of challenge bouts. The most famous, Yokoyama against the police Ryōi Shintō-ryū instructor Nakamura Hansuke, ran 55 minutes before Superintendent-General Mishima Michitsune declared a draw. After the matches the Kodokan supplied police jūjutsu instructors (Yokoyama, Yamashita)."@en;
        schema:description          "明治19年（1886年）秋、芝公園内の弥生社で行われた警視庁撃剣大会の柔術試合。講道館側は横山作次郎・西郷四郎・ 山下義韶ら十数名、古流側は戸塚楊心流門弟が大半を占めた。良移心当流の中村半助（警視庁）対横山作次郎の一戦は 55分を過ぎて三島通庸総監が引分を宣言した。この試合の後、講道館は横山・山下らを警視庁柔術師範として送り出す ことができた。"@ja;
        schema:keywords             "taryu-jiai";
        schema:location             <https://martial.is/entity/01M19K1VNMRK7QWDQ7PQ5VN5XX/location>;
        schema:name                 "明治十九年警視庁柔術試合"@ja;
        schema:name                 "1886 Metropolitan Police Jujutsu Challenge"@en;
        schema:startDate            "1886";
        martialis:earliestYear      1886;
        martialis:eventType         <https://w3id.org/martialis/vocab/event-classification/challenge>;
        martialis:hasEvidence       <https://martial.is/entity/01M19K1VNMRK7QWDQ7PQ5VN5XX/hasEvidence/0>;
