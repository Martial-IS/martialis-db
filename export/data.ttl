<https://martial.is/entity/01M3YH7N5GZQY473FV82YVAAHB/hasInteraction/0/hasEvidence/0>
        rdf:type                   martialis:SourceAssertionRelation;
        schema:citation            "Martial arts fight for survival (Taipei Times)";
        schema:url                 <https://www.taipeitimes.com/News/feat/archives/2002/02/17/124274>;
        martialis:evidenceType     <https://w3id.org/martialis/vocab/evidence-type/direct>;
        martialis:informationType  infotype:secondary;
        martialis:quotation        " By chance one day, a senior student of the famous martial arts master Zhang Zhao-dong came to the business where Wang worked. [...]  Under Zhang's instruction, Wang learned the two arts for which he would later become famous; pa kua chang and hsing yi chuan. Pa kua chang means \"eight diagram palms\" and refers to the eight core diagrams which make up the I-Ching (易經, Book of Changes), one of the most important books of classical Chinese philosophy";
        martialis:supports         true .

