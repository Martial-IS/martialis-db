<https://martial.is/entity/01M0AJNJHSV6RHCNNKNM0Y1EHQ>
        rdf:type                        martialis:Source;
        schema:alternateName            "不遷流の歴史";
        schema:archivedAt               <http://web.archive.org/web/20230603135510/http://husenryu.web.fc2.com/list1.html>;
        schema:description              "Official history page of the Fusen-ryu Seibukan hombu dojo. Presents the lineage: founder Takeda Motsuge (Motsugai)\n\"Genkotsu Osho\"; 2nd Takeda Teiji; 3rd Tanabe Torajiro; 4th Tanabe Mataemon (and co-4th Tanabe Takejiro); 5th\nNakayama Eisaburo; 6th Nakayama Yamato; 7th Inoue Kazutoshi. Notes the school's curriculum as an integrated budo\n(jujitsu, kusarigama, bo-jutsu, naginata, yae-kama, jitte, etc.), records that Tanabe Mataemon's disciples later\nestablished dojo such as the Senbukan and Iyokan in Kobe (the school names itself the \"Bitchu Nagao-line Fusen-ryu\nSeibukan\" to avoid confusion), and remarks that the school preserves the Fusen-ryu sanshuki (30 forms), 2nd gen\nkumigae 42 hon, and the Butokukai-prescribed jujitsu kata of 4th gen Mataemon. Notably, the hombu's own history\ncontains no particular emphasis on newaza or ground-grappling as a defining feature of the school.\n"@en;
        schema:inLanguage               "ja";
        schema:keywords                 "koryu";
        schema:keywords                 "jujutsu";
        schema:keywords                 "japan";
        schema:name                     "不遷流の歴史 (Fusen-ryu Seibukan Hombu: History)";
        schema:publisher                <https://martial.is/entity/01M0AJNJHSV6RHCNNKNM0Y1EHQ/publisher>;
        schema:url                      <http://husenryu.web.fc2.com/list1.html>;
        martialis:accessed              "2026-09-23";
        martialis:hasContributor        <https://martial.is/entity/01M0AJNJHSV6RHCNNKNM0Y1EHQ/hasContributor/0>;
        martialis:sourceClassification  srcclass:authored;
        martialis:sourceType            "webpage" .

