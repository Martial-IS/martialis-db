<https://martial.is/entity/01KZGHWBBT0MWNJ2E9X3Z3JA3Z>
        rdf:type                        martialis:Source;
        <http://purl.org/ontology/bibo/issue>  "70";
        schema:alternateName            "Choki Motobu, a Forerunner of Combative Karate";
        schema:datePublished            "1978";
        schema:description              "Translation of Seijin Jahana's article \"Choki Motobu, a Forerunner of Combative Karate\" from Aoi Umi (Blue Sea) magazine No. 70 (February 1978), published on East Wind Budo. Jahana interviewed Chozo Nakama (then 80) in 1978; Nakama stated he learned karate directly from Choki Motobu, whose own dojo opened around 1940 in Nishishinmachi (Kumecho now), Naha after his return from Osaka. Covers the Motobu-Nakama relationship, the unpublished manuscript story, and states Nakama held Hanshi 9th dan."@en;
        schema:inLanguage               "en";
        schema:keywords                 "article";
        schema:keywords                 "translation";
        schema:keywords                 "motobu-ryu";
        schema:keywords                 "karate";
        schema:name                     "The Legend of Choki Motobu";
