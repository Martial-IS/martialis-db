<https://martial.is/entity/01KYFXCETR9R1BNFD5T82H1G8P>
        rdf:type                martialis:Style;
        schema:alternateName    "Moo Duk Kwan"@en;
        schema:alternateName    "Tangsudo"@en;
        schema:alternateName    "Soo Bahk Do"@en;
        schema:description      "Traditional Korean martial art first taught in the kwans of 1944-1945, Lee Won-kuk's Chung Do Kwan and Hwang Kee's Moo Duk Kwan. Emphasizes hard kicking and striking techniques, with forms (hyung), sparring, and self-defense. Tang Soo Do served as the foundation for American Tang Soo Do and heavily influenced the development of Taekwondo."@en;
