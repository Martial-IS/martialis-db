<https://martial.is/entity/01M0AAFQFZH1EVE7P1TVCPX4BE>
        rdf:type                       martialis:Person;
        schema:alternateName           "Edward William Wright"@en;
        schema:alternateName           "E.W. Barton-Wright"@en;
        schema:birthDate               "1860-11-08";
        schema:birthPlace              <https://martial.is/entity/01M0AAFQFZH1EVE7P1TVCPX4BE/birthEvent/birthPlace>;
        schema:deathDate               "1951-09-13";
        schema:deathPlace              <https://martial.is/entity/01M0AAFQFZH1EVE7P1TVCPX4BE/deathEvent/deathPlace>;
        schema:description             "English entrepreneur specialising in self-defence training and physical therapy, remembered as among the first Europeans to study Japanese martial arts and then teach them, and as an early advocate of combining martial arts. While working in Kobe, Japan (c. 1895-1898) he studied jujutsu in at least two styles, including Shinden Fudo-ryu in Kobe and Kodokan judo in Tokyo; the BJS paper also notes he had some training in judo and taught Shinden Fudo ryu (Immovable Heart school) jujutsu techniques. Returning to England in 1898 he combined these arts with British boxing, French savate and Vigny stick fighting to form Bartitsu, and in 1900 established the Bartitsu School of Arms and Physical Culture in London. He brought over talented young jujutsuka - notably Yukio Tani and Sadakazu Uyenishi - to teach at his club, giving jujutsu its start in the U.K. Died in 1951."@en;
        schema:keywords                "united-kingdom";
        schema:keywords                "bartitsu";
        schema:keywords                "jujutsu";
        schema:keywords                "pioneer";
        schema:keywords                "judo";
        schema:name                    "Edward William Barton-Wright"@en;
        schema:nationality             <https://martial.is/entity/01M0AAFQFZH1EVE7P1TVCPX4BE/nationality/0>;
        schema:sameAs                  <http://www.wikidata.org/entity/Q1749799>;
