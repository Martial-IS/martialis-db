<https://martial.is/entity/01KZ6239B5VBK0S11VCGQZ4C9B>
        rdf:type                       martialis:Person;
        schema:alternateName           "Misao Honda"@en;
        schema:alternateName           "Honda Doshu"@en;
        schema:birthDate               "1944";
        schema:birthPlace              <https://martial.is/entity/01KZ6239B5VBK0S11VCGQZ4C9B/birthEvent/birthPlace>;
        schema:deathDate               "2011-01-14";
        schema:description             "Japanese aikido teacher (7th dan Aikikai, shihan) and founder of Aikido Aikikai in Portugal. A student of Hirokazu Kobayashi, he went to Portugal as a young man and spread aikido there, teaching at the Academia de Budo in 1971-72 and returning in 1975, when his first demonstration at the Clube Naval Setubalense gave rise to the first Aikido Aikikai school in Portugal. In Portugal he is known as Misao Honda; his Japanese name was Honda Doshū."@en;
        schema:description             "Professor japonês de aikido (7º dan Aikikai, shihan) e fundador do Aikido Aikikai em Portugal. Aluno de Hirokazu Kobayashi, foi para Portugal em jovem e aí difundiu o Aikido, ensinando na Academia de Budo em 1971-72 e regressando em 1975, quando a sua primeira demonstração no Clube Naval Setubalense deu origem à primeira escola de Aikido Aikikai em Portugal. Em Portugal é conhecido como Misao Honda; o seu nome japonês era Honda Doshū."@pt;
        schema:keywords                "portugal";
        schema:keywords                "aikido";
        schema:keywords                "japan";
        schema:name                    "Honda Doshū"@ja-Latn;
        schema:name                    "本田土洲"@ja;
