<https://martial.is/entity/01M0AJNJHSV6RHCNNKNM0Y1EHR>
        rdf:type                        martialis:Source;
        schema:alternateName            "尾道古武道保存会";
        schema:archivedAt               <https://web.archive.org/web/20120120085410/http://moon.ap.teacup.com/fusenryu-ituwa/>;
        schema:datePublished            "2011";
        schema:description              "Blog of the Onomichi Kobudo Preservation Society (尾道古武道保存会), formerly the \"Seibukan Onomichi Dojo\", a\ngroup practicing Fusen-ryu jujitsu (founded by Motsuge Fusei, 9th abbot of saidoji-ji, Onomichi, Hiroshima\nPrefecture) and related martial arts. Describes the training curriculum as including jujitsu, kenjutsu, iaijutsu,\nbo-jutsu, jitte, naginata, kusarigama, and others; publishes articles on the arts and on anecdotes of the founder.\nLike the hombu site, the blog presents Fusen-ryu as an integrated koryu tradition with no special newaza emphasis.\n"@en;
        schema:inLanguage               "ja";
        schema:keywords                 "koryu";
