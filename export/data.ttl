<https://martial.is/entity/01M0AJNJHSV6RHCNNKNM0Y1EHP>
        rdf:type                        martialis:Source;
        schema:archivedAt               <https://web.archive.org/web/20240921124920/http://sydhoare.com/FUSEN.pdf>;
        schema:description              "English translation by judo historian Syd Hoare of the account \"Tanabe Mataemon Talks About His Fusen-Ryu Jujitsu\",\ntaken from the c.1170-page DaiNippon Judo-shi (Great Japan Judo History), published 1939. Gives Tanabe's genealogy\n(Motsuge Zenji/Genkotsu Osho founding the line; Takeda Sadaharu; Tanabe Torajiro; Tanabe Mataemon), dates (born\nOkayama 1869, died Osaka 1942, menkyo kaiden at 17, Keishicho appointment 1890, judo Kyoshi 1906, retirement 1922,\nJudo Hanshi by the Butokukai 1927), his own account of his ground-grappling development and nickname \"Newaza-Tanabe\",\nand his remark that he and his pupils mostly practised gyaku-waza or joint-locking. Also cites Oimatsu's remark that\nYukio Tani was a student of Tanabe Mataemon in Kobe, where he learned Fusen-ryu jujitsu. Cited by the English\nWikipedia article on Mataemon Tanabe.\n"@en;
        schema:inLanguage               "en";
        schema:keywords                 "translation";
        schema:keywords                 "primary-source-adjacent";
        schema:keywords                 "jujutsu";
        schema:name                     "Tanabe Mataemon Talks About His Fusen-Ryu Jujitsu (Syd Hoare translation)";
        schema:publisher                <https://martial.is/entity/01M0AJNJHSV6RHCNNKNM0Y1EHP/publisher>;
        schema:url                      <http://www.sydhoare.com/FUSEN.pdf>;
        martialis:accessed              "2026-10-18";
        martialis:archiveDate           "2024-09-21";
        martialis:hasContributor        <https://martial.is/entity/01M0AJNJHSV6RHCNNKNM0Y1EHP/hasContributor/0>;
        martialis:sourceClassification  srcclass:authored;
        martialis:sourceGenre           <https://w3id.org/martialis/vocab/source-genre/biography>;
        martialis:sourceType            "article" .

