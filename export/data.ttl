<https://martial.is/entity/01M07HCGJGDPR24S4J0JWFFH68>
        rdf:type                        martialis:Source;
        schema:datePublished            "2018";
        schema:description              "Peer-reviewed academic article (The International Journal of the History of Sport, vol. 35, no. 6, pp. 530-553)\non the first British women's pioneers of jujutsu/judo. Case study 1 covers Phoebe Roberts (1887-1937): born Phoebe\nParry in Monmouthshire, adopted by the London manufacturing chemist Roberts family; joined Uyenishi's Golden Square\nSchool in 1903 aged 16, promoted to instructor within a year; performed alongside her teachers Tani and Uyenishi\nfrom December 1904, including Caxton Hall, the Aldershot military demonstrations, the June 1905 Japan Society\ngarden party attended by Prince Arisugawa, and venues up to the Japanese School of Ju-jitsu in Oxford Street.\nMarried Juzo/Juso Hirano in March 1907, toured Spain in 1908, and followed Hirano to Barcelona and Portugal; as\nPhoebe Laughton-Parry she married Don Carlos de Castro Henriques in 1916 and died in Porto in October 1937. Case\nstudy 2 covers Edith Garrud (1872-1971), whose suffragette-era jujutsu is treated here alongside the Bodyguard\nshe trained for the WSPU. Case study 3 covers Sarah Mayer.\n"@en;
        schema:inLanguage               "en";
        schema:keywords                 "united-kingdom";
        schema:keywords                 "women-jujutsu";
        schema:keywords                 "academic";
        schema:name                     "Women's Jūjutsu and Judo in the Early Twentieth-Century: The Cases of Phoebe Roberts, Edith Garrud, and Sarah Mayer";
        schema:publisher                <https://martial.is/entity/01M07HCGJGDPR24S4J0JWFFH68/publisher>;
        schema:url                      <https://doi.org/10.1080/09523367.2018.1544553>;
        martialis:accessed              "../2026-08-19";
        martialis:doi                   "10.1080/09523367.2018.1544553";
        martialis:earliestYear          2018;
        martialis:hasContributor        <https://martial.is/entity/01M07HCGJGDPR24S4J0JWFFH68/hasContributor/0>;
        martialis:hasContributor        <https://martial.is/entity/01M07HCGJGDPR24S4J0JWFFH68/hasContributor/1>;
        martialis:hasContributor        <https://martial.is/entity/01M07HCGJGDPR24S4J0JWFFH68/hasContributor/2>;
        martialis:latestYear            2018;
        martialis:partOf                <https://martial.is/entity/01M64QW2FNHBHRZF1BP1X9TEPA>;
        martialis:peerReview            <https://w3id.org/martialis/vocab/peer-review/peer_reviewed>;
        martialis:sourceClassification  srcclass:authored;
