<https://martial.is/entity/01M19SYYS34TS7JRFEG6GW3VFW>
        rdf:type                    martialis:Event;
        schema:about                <https://martial.is/entity/01KJJAWN29MA64W22606R3WD9B>;
        schema:alternateName        "The Roosevelt-Arranged Private Match (1905)"@en;
        schema:description          "A private match arranged by President Theodore Roosevelt on 23 February 1905 between Yamashita Yoshiaki and Joseph Grant, a middleweight catch-as-catch-can wrestler. Roosevelt wanted a firsthand answer to the jujutsu-vs-wrestling question that journalists and Russo-Japanese War propaganda had made fashionable. In Roosevelt's account, Yamashita choked Grant inside a minute and applied an elbow hold two minutes later, though Grant's strength plainly wore Yamashita down."@en;
        schema:description          "1905年2月23日、セオドア・ルーズベルト大統領の手配で行われた山下義韶と中量級キャッチ・アズ・キャッチ・ キャンのレスラー、ジョセフ・グラントとの非公開試合。ルーズベルトは柔術対レスリングの実力を自ら確かめよう とした。大統領の記述によれば、山下は1分足らずでグラントを絞め落とし、さらに2分ほどで腕固めを極めたが、 グラントの力に山下は消耗したという。"@ja;
        schema:keywords             "catch-wrestling";
        schema:keywords             "kodokan";
        schema:location             <https://martial.is/entity/01M19SYYS34TS7JRFEG6GW3VFW/location>;
        schema:name                 "山下義韶対ジョセフ・グラント"@ja;
        schema:name                 "Yamashita vs Joseph Grant"@en;
        schema:startDate            "1905-02-23";
        schema:superEvent           <https://martial.is/entity/01M19SYYS3JXJSD3JGQ89RG6SM>;
        martialis:earliestYear      1905;
        martialis:eventType         <https://w3id.org/martialis/vocab/event-classification/challenge>;
        martialis:hasEvidence       <https://martial.is/entity/01M19SYYS34TS7JRFEG6GW3VFW/hasEvidence/0>;
        martialis:hasParticipation  <https://martial.is/entity/01M3YH7N5FDR5TCXMT82E9AT6X>;
        martialis:latestYear        1905 .

