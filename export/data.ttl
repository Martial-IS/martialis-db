<https://martial.is/entity/01KZ9TQS3VWBPTDPR59EH06R58>
        rdf:type                       martialis:Person;
        schema:alternateName           "Sampo Toku"@ja-Latn;
        schema:alternateName           "Sanbo Toku"@ja-Latn;
        schema:alternateName           "Sanpo Toku"@ja-Latn;
        schema:birthDate               "1887-12-12";
        schema:birthPlace              <https://martial.is/entity/01KZ9TQS3VWBPTDPR59EH06R58/birthEvent/birthPlace>;
        schema:deathDate               "1945-03-10";
        schema:deathPlace              <https://martial.is/entity/01KZ9TQS3VWBPTDPR59EH06R58/deathEvent/deathPlace>;
        schema:description             "Pre-war Kodokan judoka known as 'Oni no Toku' (Toku of the Devilness), the 'demon of the Kodokan' of Mochizuki's interview, 9th dan of Kodokan judo. Famous for defeating 165 opponents in a single league as a young man and for the public rivalry with Mifune ('Waza no Mifune / Oni no Toku'). Expelled from the Kodokan in 1912 after defeating fifteen Brazilian Navy sailors, pardoned and reinstated by Kano in 1917. Ran his own dojo in Komatsugawa, Tokyo, where the young Minoru Mochizuki trained from 1924."@en;
