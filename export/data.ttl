<https://martial.is/entity/01KZDXQH2MJE0W8S1H78XE493G>
        rdf:type                martialis:Style;
        schema:alternateName    "Motobu Ryu"@en;
        schema:description      "Motobu-ryu is the school of karate founded by Motobu Choki (1870-1944),\nwhich focuses on the kata Naihanchi and on practical kumite. Motobu\ndistanced himself from the modernization trend in karate, and the style\npreserves his emphasis on natural fighting application.\n"@en;
