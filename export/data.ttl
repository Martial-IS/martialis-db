<https://martial.is/entity/01M69YZDB9JKZJ0YG82EWDR60F/dissolvedEvent/hasEvidence/0>
        rdf:type                      martialis:SourceAssertionRelation;
        martialis:basedOnSource       <https://martial.is/entity/01M69VJBQCHMMFMBTHKD733P9H>;
