<https://martial.is/entity/01M3YH7N5GY28D8GNWGM424S8Q/hasEvidence/3>
        rdf:type                   martialis:SourceAssertionRelation;
        schema:citation            "Interview with Minoru Mochizuki: Part 1, Aikido Journal, November 2002";
        schema:url                 <https://aikidojournal.com/2002/11/18/interview-with-minoru-mochizuki-1/>;
        martialis:evidenceType     <https://w3id.org/martialis/vocab/evidence-type/direct>;
        martialis:informationType  infotype:secondary;
        martialis:quotation        "It was about that time that he gave me the scrolls for the menkyo kaiden (master teacher's license). One of them is about two meters long and the other about three meters in length. The longer one is entitled 'The Self-defense of Daito-ryu Aiki Jujutsu' while the other has 'The Innermost Teachings of Daito-ryu Aiki Jujutsu' written on it.";
        martialis:supports         true .

