<https://martial.is/entity/01KZC8S2GEN7P0VQFP7YGZCVKZ>
        rdf:type                martialis:Style;
        schema:description      "Matsubayashi-ryu (松林流) is a style of Okinawan karate founded in 1947 by Shoshin\nNagamine, named in honor of Matsumura Sokon (Matsu) and Kosaku Matsumora (Bayashi),\nthe masters whose teachings it is based upon. Its curriculum includes 18 kata, seven\ntwo-man yakusoku kumite routines, and kobudo practice. It is a school within the\nShorin-ryu family.\n"@en;
        schema:keywords         "gendai";
        schema:keywords         "karate";
        schema:keywords         "okinawan-martial-arts";
