<https://martial.is/entity/01M1AGGVAC364WKGC5XSD0D4AW>
        rdf:type                       martialis:Person;
        schema:alternateName           "竹下勇二郎"@ja;
        schema:birthDate               "1870-01-05";
        schema:birthPlace              <https://martial.is/entity/01M1AGGVAC364WKGC5XSD0D4AW/birthEvent/birthPlace>;
        schema:deathDate               "1949-07-01";
        schema:deathPlace              <https://martial.is/entity/01M1AGGVAC364WKGC5XSD0D4AW/deathEvent/deathPlace>;
        schema:description             "Takeshita Isamu (January 5, 1870 – July 1, 1949) was a Japanese naval admiral and diplomat. As Japan's naval attaché to the United States, he arranged for Yoshiaki Yamashita to teach judo to President Theodore Roosevelt at the White House in 1904. He later became a student of Morihei Ueshiba in aikido at the Kobukan dojo and demonstrated aikibudo in North America in 1935. He was the first president of the Kobukai Foundation and chairman of the Japan Sumo Association. Born Yamamoto, he was adopted into the Takeshita family as a boy."@en;
        schema:keywords                "aikido";
        schema:keywords                "naval";
        schema:keywords                "judo";
