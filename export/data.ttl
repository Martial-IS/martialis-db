<https://martial.is/entity/01M0A7YYEFMKPM42VNW79WTSWR>
        rdf:type                       martialis:Person;
        schema:alternateName           "Taro Miyake"@en;
        schema:alternateName           "Tarro Myaki"@ja-Latn;
        schema:alternateName           "Miyake Taruji"@ja-Latn;
        schema:alternateName           "Taruji Miyake"@ja-Latn;
        schema:birthDate               "1881-08-15";
        schema:birthPlace              <https://martial.is/entity/01M0A7YYEFMKPM42VNW79WTSWR/birthEvent/birthPlace>;
        schema:deathDate               "1935";
        schema:description             "Japanese jujutsu fighter, instructor, catch wrestler and author, a protégé of Fusen-ryu\nground-fighting master Mataemon Tanabe and, with Yukio Tani, one of the pioneers of jujutsu\nin Britain. Trained under Tanabe, then Uyemura in Kyoto and Yataro Handa in Osaka, he worked\nas an instructor in Nara and Kobe before a brawl led to his dismissal and departure for London\nin 1904. There he famously defeated Yukio Tani in a challenge match, then joined forces with him\nto open the Japanese School of Jujutsu at 305 Oxford Street and co-author \"The Game of Ju-Jitsu\"\n(1906). From 1914 he lived in the United States (Seattle, Chicago, New York), teaching alongside\nKodokan judoka Shozo Kuwashima, and continued competing into his 50s at Madison Square Garden.\n"@en;
        schema:keywords                "united-kingdom";
        schema:keywords                "professional-wrestling";
        schema:keywords                "united-states";
        schema:keywords                "jujutsu";
        schema:keywords                "pioneer";
        schema:keywords                "judo";
        schema:name                    "三宅 タロー"@ja;
