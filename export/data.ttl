<https://martial.is/entity/01M3YH7N5GRMNHAJ220879DFG3/hasInteraction/0/hasEvidence/0>
        rdf:type                   martialis:SourceAssertionRelation;
        schema:citation            "Tetsuji Murakami Sensei (Shotokai Encyclopedia)";
        schema:url                 <https://shotokai.com/tetsuji-murakami/>;
        martialis:evidenceType     <https://w3id.org/martialis/vocab/evidence-type/direct>;
        martialis:informationType  infotype:secondary;
        martialis:quotation        "In the autumn of 1968, accompanied by Tsutomu Ohshima, Murakami traveled to Japan. During this pilgrimage, he visited the Shotokan and met Master Shigeru Egami. [...] Right then and there, he committed himself to Master Egami as a humble disciple, determined to rebuild his art from absolute scratch.";
        martialis:supports         true .

<https://martial.is/entity/01M3YH7N5G3NMKEZ3HA3RY4RTB/hasInteraction/0/hasEvidence/0>
