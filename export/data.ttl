<https://martial.is/entity/01KJJAWN29MA64W22606R3WD6F>
        rdf:type                       martialis:Person;
        schema:birthDate               "1884-05-18";
        schema:birthPlace              <https://martial.is/entity/01KJJAWN29MA64W22606R3WD6F/birthEvent/birthPlace>;
        schema:deathDate               "1962-03-30";
        schema:deathPlace              <https://martial.is/entity/01KJJAWN29MA64W22606R3WD6F/deathEvent/deathPlace>;
        schema:description             "Ogawa Kinnosuke was born in 1884 in Aichi prefecture. He began kendo whilst in school, at around 13/15 years of age, under kendo hanshi Kato Kiichi and later under Kohori Yasutada. He was a student and later an instructor at the Budo Senmon Gakko, as well as in the Nagoya police. He was a Butokukai hanshi and was Busen's principal kendo instructor in the 1930's and up until 1945.  He authored \"Teikoku Kendo Kyohon\" (The Kendo Textbook of Imperial Japan) in 1932 (revised 1937) and was posthumously inducted into the Kendo Hall of Fame in 2003."@en;
