<https://martial.is/entity/01M015RCSFK72AEZPP3EQZ136Q>
        rdf:type                       martialis:Person;
        schema:alternateName           "Tarzan van de tatami"@nl;
        schema:alternateName           "Tarzan of the Tatami"@en;
        schema:birthDate               "1940-08-29";
        schema:birthPlace              <https://martial.is/entity/01M015RCSFK72AEZPP3EQZ136Q/birthEvent/birthPlace>;
        schema:deathDate               "2015-02-14";
        schema:deathPlace              <https://martial.is/entity/01M015RCSFK72AEZPP3EQZ136Q/deathEvent/deathPlace>;
        schema:description             "Dutch judoka and professional wrestler, the only judoka to win two gold medals at a single Olympic Games (Munich 1972, heavyweight and open class). Won two world titles (1967 Salt Lake City, 1971 Ludwigshafen), seven European titles and many Dutch national titles. Started judo at the Dutch Navy and trained under Jon Bluming in the 1960s-70s; reached 8th dan. After 1972 he became national coach of the Netherlands for about a year and later competed in professional wrestling for New Japan Pro-Wrestling and the WWF. Inducted into the IJF Hall of Fame in 2013."@en;
        schema:name                    "Wim Ruska"@en;
