        martialis:hasStyleRelationAssertion  <https://martial.is/entity/01M3YH7N5GE2CN83KNSAE774TA>;
        martialis:styleType     <https://w3id.org/martialis/vocab/style-classification/modern> .

<https://martial.is/entity/01M00NPBTPWM75HT58KZQPEYCC>
        rdf:type                        martialis:Source;
        schema:archivedAt               <https://web.archive.org/web/20231016003356/https://dcjudo.com/feldenkrais-and-judo/>;
        schema:datePublished            "2012";
        schema:description              "Article by Terence McPartland (September 2012) on the DC Judo club's website about Feldenkrais' judo career: his meeting with Jigoro Kano in 1933, his study of judo under Mikinosuke Kawaishi with shodan in 1936 and nidan in 1938, his work with Kawaishi on teaching judo to Westerners (documented in Kawaishi's My Method of Judo), the founding of the Jujitsu Club de France in 1936, and his students including Paul Bonét-Maury, first IJF Secretary-General."@en;
        schema:inLanguage               "en";
        schema:keywords                 "france";
        schema:keywords                 "website";
        schema:keywords                 "judo";
