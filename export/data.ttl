<https://martial.is/entity/01M0E9KP2BGMP4PAC4AYTHWFX7>
        rdf:type                       martialis:Person;
        schema:birthDate               "1912";
        schema:birthPlace              <https://martial.is/entity/01M0E9KP2BGMP4PAC4AYTHWFX7/birthEvent/birthPlace>;
        schema:deathDate               "1979-05-14";
        schema:deathPlace              <https://martial.is/entity/01M0E9KP2BGMP4PAC4AYTHWFX7/deathEvent/deathPlace>;
        schema:description             "Peruvian-born pioneer of judo in Spain. He discovered judo in Lima in 1931, trained under Japanese teachers (Shinsho Siosaki Murayama, Makishima) in Peru, and arrived in Spain in 1947, giving the first judo classes in Madrid at the Gimnasio Juventud on Calle Fuencarral. He co-founded the first Spanish judo club, the Asociación Española de Judo y Jiu-jitsu (May 1950), later the Club Bushidokwai, and served as unofficial technical adviser of the Spanish Judo Department until Yves Klein's arrival in 1954. He published the Método de Judo del Gimnasio Bushidokwai and was awarded the Medalla de Oro al Mérito Deportivo in 1972."@en;
        schema:keywords                "spain";
