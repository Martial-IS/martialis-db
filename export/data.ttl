<https://martial.is/entity/01M06K0RMZV3APZVDQBBYVCKEQ>
        rdf:type                        martialis:Source;
        schema:archivedAt               <https://en.wikipedia.org/w/index.php?title=Yukio_Tani&oldid=1286328311>;
        schema:datePublished            "2026";
        schema:description              "English Wikipedia article on Yukio Tani (1881-1950), pioneering Japanese jujutsu and judo instructor and\nprofessional challenge wrestler, one of the first jujutsu stylists to teach and compete outside Japan. Covers his\nearly training (Tenjin Shinyo-ryu under his father, rumoured study with Mataemon Tanabe, evidence of training at\nYataro Handa's Seibukan school in Osaka), arrival in London in 1900 with Barton-Wright's invitation, Bartitsu club\ndemonstrations with Uyenishi, the music hall challenge circuit under William Bankier, the 1906 book \"The Game of\nJu-Jitsu\", his first professional teaching post at the Budokwai from 1918, the 2nd dan judo certification awarded\nby Jigoro Kano in 1920 (later 4th dan), his leading student Masutaro Otani (founder of the MOSJ/British Judo\nCouncil), the 1937 stroke, and his death in London on 24 January 1950.\n"@en;
        schema:inLanguage               "en";
        schema:keywords                 "japan";
        schema:keywords                 "secondary-source";
        schema:name                     "Yukio Tani";
        schema:publisher                <https://martial.is/entity/01M06K0RMZV3APZVDQBBYVCKEQ/publisher>;
        schema:url                      <https://en.wikipedia.org/wiki/Yukio_Tani>;
