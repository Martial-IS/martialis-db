<https://martial.is/entity/01KZH55CZVPF2CADEWKWE5HJ8J>
        rdf:type                        martialis:Source;
        schema:datePublished            "2023";
        schema:description              "Motobu Naoki's article \"Forgotten Masters of Karate\" (translated from his Ameblo blog of February 19, 2016, based on a 1918 Ryukyu Shimpo article), introducing Okinawan karate masters of the Taisho era: Kiyuna Tanmei, Chinen Sanra, Yabu Kentsu and Motobu Choyu. States Chinen Sanra was a famous bojutsu master of commoner origin (yago Yamanmee, hence Yamane-ryu), and that after the war his grandson Chinen Masami served as head of the family; Higa Seitoku of the Bugeikan studied under Masami and was awarded the only shihan license Masami ever issued, making the Bugeikan the legitimate successor to the Yamane-ryu; Yabiku Moden and Oshiro Chojo also studied under Chinen Sanra."@en;
        schema:inLanguage               "en";
        schema:keywords                 "article";
        schema:keywords                 "yamanni-ryu";
        schema:keywords                 "bojutsu";
        schema:keywords                 "karate";
        schema:name                     "Forgotten Masters of Karate - Motobu Naoki (note.com)";
        schema:publisher                <https://martial.is/entity/01KZH55CZVPF2CADEWKWE5HJ8J/publisher>;
        schema:url                      <https://note.com/motoburyu/n/n45b9ee25b39c>;
        martialis:accessed              "../2026-08-19";
        martialis:earliestYear          2023;
        martialis:hasContributor        <https://martial.is/entity/01KZH55CZVPF2CADEWKWE5HJ8J/hasContributor/0>;
        martialis:latestYear            2023;
        martialis:sourceClassification  srcclass:authored;
        martialis:sourceType            "article" .

