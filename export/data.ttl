<https://martial.is/entity/01KZDXQH2M13NARPG06PK203W4>
        rdf:type                martialis:Style;
        schema:alternateName    "Kishaba Juku"@en;
        schema:description      "Shorin-ryu Kishaba Juku is the school of Okinawan karate founded by Chokei\nKishaba (1929-2000), who studied under Hohan Soken, Shoshin Nagamine and\nSeigi Nakamura. After Kishaba's death in 2000 his senior student Katsuhiko\nShinzato became the Juko Cho (head) of the Kishaba Juku. The school has\naffiliated dojos in Japan, the United States, France, Germany and Israel.\n"@en;
        schema:keywords         "gendai";
        schema:keywords         "shorin-ryu";
        schema:keywords         "karate";
        schema:name             "Shōrin-ryū Kishaba Juku"@ja-Latn;
