<https://martial.is/entity/01KZY0RGB7RGZFK05BHN7S322A>
        rdf:type                        martialis:Source;
        schema:alternateName            "Jean DE HERDT, le pionnier ....";
        schema:archivedAt               <http://web.archive.org/web/20200209021237/http://patrickdimayuga.over-blog.com:80/article-jean-de-herdt-le-pionnier-114647317.html>;
        schema:datePublished            "2013";
        schema:description              "Tribute article to Jean de Herdt by a former student, published 23 January 2013, shortly after de Herdt's death on 5 January 2013. Records his black belt in 1940, his status as the first Westerner to hold a drawn match against Toshiro Daigo at the Vel d'Hiv before more than 16,000 spectators, his role alongside Jean Beaujean in running the Club Franco-japonais after Mikinosuke Kawaishi's return to Japan, the first French national black-belt championship (Paris, 1943) and the College des Ceintures Noires (1942), his teaching of Anton Geesink, and his rank of 6th dan and Knighthood of the Legion of Honour."@en;
        schema:inLanguage               "fr";
        schema:keywords                 "judo";
        schema:name                     "Jean DE HERDT, le pionnier .... - patrickdimayuga.over-blog.com";
        schema:publisher                <https://martial.is/entity/01KZY0RGB7RGZFK05BHN7S322A/publisher>;
        schema:url                      <https://patrickdimayuga.over-blog.com/article-jean-de-herdt-le-pionnier-114647317.html>;
        martialis:accessed              "2026-09-23";
        martialis:earliestYear          2013;
        martialis:latestYear            2013;
        martialis:sourceClassification  srcclass:authored;
        martialis:sourceGenre           <https://w3id.org/martialis/vocab/source-genre/biography>;
        martialis:sourceType            "webpage" .

