<https://martial.is/entity/01M3YH7N5G40J54FJCBS1913EF/hasInteraction/0/hasEvidence/0>
        rdf:type                   martialis:SourceAssertionRelation;
        schema:archivedAt          <https://web.archive.org/web/20090218133219/http://rrjudo.com/history/zenjudo.htm>;
        schema:citation            "Kenshiro Abbe, The Kyu-Shin-Do And Zen Judo - Keo Cavalcanti, 6th Dan Zen Judo";
        schema:url                 <http://rrjudo.com/history/zenjudo.htm>;
        martialis:evidenceType     <https://w3id.org/martialis/vocab/evidence-type/direct>;
        martialis:informationType  infotype:secondary;
        martialis:quotation        "In 1937, at the age of 23, Abbe was awarded his Rokudan (6th Dan) rank and in June of that year he enlisted in the Japanese army, serving for four years in a garrison in the Toan-sho Province in Manchuria. It was during the time in Manchuria that Abbe began formulating his theory of Budo (the Way of the Warrior), Kyu-Shin-Do. And it was also at this time that Abbe was invited by O'Sensei, Morihei Ueshiba to study Aikido under his care.";
        martialis:supports         true .

