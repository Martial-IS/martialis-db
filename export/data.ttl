<https://martial.is/entity/006G01NTX6KVVJGZRYYMM8GAFV>
        rdf:type                        martialis:Source;
        schema:alternateName            "CARNET NOIR : ICHIRO ABE (1922-2022)";
        schema:archivedAt               <https://web.archive.org/web/20251114084835/https://www.ffjudo.com/actualite/carnet-noir-ichiro-abe>;
        schema:datePublished            "2022";
        schema:description              "Official France Judo obituary (carnet noir, published 28 February 2022) announcing the death of Ichiro Abe on 27 February 2022 at age 99. Records that he began judo in 1937 at the Maebashi lycée with Master Sato 5th dan, and that he settled in Toulouse in 1951 during the Kodokan judo promotion campaign in Europe, aged 29 and 6th dan, as technical advisor at the Shudokan of Robert Lasserre; it credits him as one of the fathers of a school of judo in France, around reputed French professors and judoka such as Pierre Roussel, Jacques Belaud, Luc Levannier and Guy Pelletier. It further lists his career in European and Japanese judo bodies: technical director of the Belgian Judo Association (1953), technical advisor of the European Judo Union (1955), head of the Kodokan international department (1969), president of the All Japan Judo Federation (1985), and his promotion to 10th dan on 8 January 2006."@en;
        schema:inLanguage               "fr";
        schema:keywords                 "judo";
        schema:name                     "Carnet noir : Ichiro Abe (1922-2022)";
        schema:publisher                <https://martial.is/entity/006G01NTX6KVVJGZRYYMM8GAFV/publisher>;
        schema:url                      <https://www.ffjudo.com/actualite/carnet-noir-ichiro-abe>;
        martialis:accessed              "../2026-08-19";
        martialis:archiveDate           "2025-11-14";
        martialis:earliestYear          2022;
        martialis:latestYear            2022;
        martialis:lineageTradition      false;
        martialis:partOf                <https://martial.is/entity/01M64QW2FNX2NVZ6FMRJ6CVN2Z>;
        martialis:peerReview            <https://w3id.org/martialis/vocab/peer-review/not_peer_reviewed>;
        martialis:sourceClassification  srcclass:authored;
        martialis:sourceGenre           <https://w3id.org/martialis/vocab/source-genre/obituary>;
        martialis:sourceType            "webpage" .

