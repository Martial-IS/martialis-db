<https://martial.is/entity/01M1MCG84SK49YRGTQDR3Q6YWD>
        rdf:type                    martialis:Event;
        schema:about                <https://martial.is/entity/01KJJAWN29MA64W22606R3WD9B>;
        schema:alternateName        "SAC-ARDC Combative Measures Instructor Course"@en;
        schema:alternateName        "SAC Combative Measures Instructor Training"@en;
        schema:description          "The Strategic Air Command Combative Measures instructor training program, initiated by General Curtis LeMay in 1951. Selected SAC airmen were sent to Tokyo's Kodokan Judo Institute for intensive multi-art training in judo, karate, aikido, and police tactics. The program ran for over a decade, with the SAC-ARDC Yudanshakai sanctioned by the Kodokan in 1955. By 1962 SAC had over 160 black-belt combative measures instructors and the program produced national AAU judo champions and an Olympian (George Harris). The course was eventually cut in 1966 during the Vietnam buildup due to budget pressures."@en;
        schema:keywords             "usaf";
        schema:keywords             "combative-measures";
