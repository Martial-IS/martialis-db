<https://martial.is/entity/01M08HGZGH128RP08VVXX43PAV>
        rdf:type                        martialis:Source;
        schema:archivedAt               <https://web.archive.org/web/20260616205510/https://bartitsusociety.com/miss-phoebe-roberts-champion-lady-ju-jitsu-wrestler-of-the-world/>;
        schema:datePublished            "2017";
        schema:description              "Bartitsu Society article on Phoebe Roberts, originally published on bartitsu.org on 15 April 2017. Accounts her\nas one of the first female jiujitsu instructors in the Western world, training from about age fifteen circa 1904\nand beginning to teach at Tani and Miyake's Japanese School of Ju-Jitsu in Oxford Street within a year or two.\nPublishes several period photographs (demonstrating a leg trip, a defensive finger lock, applications of a\nwrist-and-arm-lock on Yuzo Hirano, self-defence against a left-lead punch), discusses her costume, notes the\n\"Phoebe Roberts\" professional pseudonym underlying her birth name Phoebe Laughton Parry, her marriage to\nYuzo Hirano during 1907, their arrival in Lisbon in January 1910 in the company of Sadakazu Uyenishi, and\nHirano's disappearance during 1915.\n"@en;
        schema:inLanguage               "en";
        schema:keywords                 "biography";
        schema:keywords                 "united-kingdom";
        schema:keywords                 "women-jujutsu";
        schema:keywords                 "bartitsu";
        schema:keywords                 "history";
        schema:name                     "Miss Phoebe Roberts, \"Champion Lady Ju-Jitsu Wrestler of the World\"";
        schema:publisher                <https://martial.is/entity/01M08HGZGH128RP08VVXX43PAV/publisher>;
        schema:url                      <https://bartitsusociety.com/miss-phoebe-roberts-champion-lady-ju-jitsu-wrestler-of-the-world/>;
        martialis:accessed              "2026-10-18";
        martialis:archiveDate           "2026-06-16";
        martialis:earliestYear          2017;
