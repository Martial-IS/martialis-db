<https://martial.is/entity/01M06FKBQ1AB6FKXQBFBFKKDRH>
        rdf:type                       martialis:Person;
        schema:alternateName           "Raku"@en;
        schema:alternateName           "Sada Kazu Uyenishi"@ja-Latn;
        schema:alternateName           "S. K. Uyenishi"@ja-Latn;
        schema:birthDate               "1880-12-22";
        schema:birthPlace              <https://martial.is/entity/01M06FKBQ1AB6FKXQBFBFKKDRH/birthEvent/birthPlace>;
        schema:description             "Japanese jujutsuka, professional wrestler and a celebrated figure of Edwardian London from 1900 to 1908.\nOne of the first Japanese jujitsu practitioners to both teach jujitsu and compete using the art outside Japan.\nHis first martial art was kenjutsu; he then trained in jujitsu at the Osaka dojo of Yataro Handa, where Mataemon\nTanabe taught. In 1900 he travelled to London at the invitation of E.W. Barton-Wright and joined Yukio Tani on\nthe faculty of the Bartitsu Club. After the club closed (c. 1902) he taught at Pierre Vigny's self-defence academy\nand, by 1903, opened his own dojo, the School of Japanese Self Defence, at 31 Golden Square, Piccadilly Circus -\nthe first jujutsu dojo in the UK. In 1905, writing as \"Raku\" with the help of his student E.H. Nelson, he produced\nthe Text-Book of Ju-Jutsu. He later taught hand-to-hand combat at Aldershot Military School and Shorncliffe Army Camp,\nand in 1907-8 undertook a highly successful tour of Spain, Portugal and other European countries performing exhibitions\nand challenge matches. He returned to Japan in late 1908, leaving the Golden Square school to his senior student\nWilliam Garrud, and died some years before the Second World War. His students included William and Edith Garrud and\nEmily Diana Watts.\n"@en;
        schema:keywords                "jujutsu";
        schema:keywords                "pioneer";
        schema:name                    "上西 貞一"@ja;
        schema:name                    "Uyenishi Sadakazu"@ja-Latn;
        schema:nationality             <https://martial.is/entity/01M06FKBQ1AB6FKXQBFBFKKDRH/nationality/0>;
        schema:sameAs                  <http://www.wikidata.org/entity/Q7397519>;
