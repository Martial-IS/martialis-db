        rdf:type                       martialis:Person;
        schema:birthPlace              <https://martial.is/entity/01M1BVV4WYQ36TS68VAVM3AZ4V/birthEvent/birthPlace>;
        schema:deathPlace              <https://martial.is/entity/01M1BVV4WYQ36TS68VAVM3AZ4V/deathEvent/deathPlace>;
        schema:description             "Morimoto Tokumi was a former samurai of the Tosa/Yamauchi clan and a Shihan of the Goto-ha branch of\nMusō Jikiden Eishin-ryū. He received Menkyo Kaiden in Musō Jikiden Eishin-ryū from Gotō Magobei\nMasasuke, making him a contemporary of Ōe Masamichi. He was one of two teachers who accepted\nNakayama Hakudō as a student of Tosa Eishin-ryū in 1916, and Nakayama received Menkyo Kaiden in\nGoto-ha Muso Jikiden Eishin-ryū from Morimoto in 1922.\n"@en;
