<https://martial.is/entity/01M07J1EESSEPR2TSJWV1FWBG5>
        rdf:type                       martialis:Person;
        schema:alternateName           "Edith Margaret Williams"@en;
        schema:alternateName           "Edith Margaret Garrud"@en;
        schema:birthDate               "1872";
        schema:birthPlace              <https://martial.is/entity/01M07J1EESSEPR2TSJWV1FWBG5/birthEvent/birthPlace>;
        schema:deathDate               "1971";
        schema:description             "Britain's first woman jujutsu teacher, and among the earliest women to instruct martial arts in the West. Born Edith Margaret Williams in Bath, she trained as a physical culture instructor and met fellow instructor William Garrud in 1892, marrying him the following year. Introduced to jujutsu in 1899, she studied under Yukio Tani and Sadakazu Uyenishi at the Bartitsu School of Arms and continued under Uyenishi at his Golden Square Dojo; when Uyenishi returned to Japan in 1908 the Garruds took over the dojo, Edith teaching the women's and children's classes. Around 1909 she opened her own dojo, the School of Ju-jutsu, at Argyll Place. A member of the Women's Freedom League from 1906 and head of its Women's Athletic Society from 1908, she became celebrated for the Suffragettes' Self-Defence Club she ran for WSPU members and, from 1913, for training the WSPU 'Bodyguard' of around thirty women who protected Emmeline Pankhurst. She taught and demonstrated in a signature red jujutsu jacket, published widely on women's self-defence (including the 1910 essay \"The World We Live In\" in Votes for Women), choreographed suffragette theatre, and continued teaching with William until their retirement in 1925."@en;
        schema:keywords                "physical-culture";
        schema:keywords                "united-kingdom";
        schema:keywords                "jujutsu";
        schema:keywords                "pioneer";
        schema:keywords                "suffragette";
        schema:name                    "Edith Garrud"@en;
