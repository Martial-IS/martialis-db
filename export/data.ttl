<https://martial.is/entity/01M6BQSYG5G95JWRDX3V4BBGJ4>
        rdf:type                        martialis:Source;
        schema:datePublished            "2012-06";
        schema:description              "Udo Mönig's (later spelt Moenig) doctoral dissertation (Keimyung University, 2012). A critical history of taekwondo. Chapter V traces the founders of the five original kwan to their karate teachers in Japan (Funakoshi Gichin, Tōyama Kanken, possibly Mabuni Kenwa) and covers the naming of taekwondo in 1955 and the Korea Taekwondo Association. Chapter VII covers the move to full-contact sport, the Ji-Do Kwan's bōgu sparring and the WTF. Locators are the printed page numbers."@en;
        schema:inLanguage               "en";
        schema:keywords                 "thesis";
        schema:keywords                 "korea";
        schema:keywords                 "taekwondo";
        schema:keywords                 "karate";
        schema:name                     "The Incomplete Transformation of Taekwondo from a 'Martial Art' to a 'Martial Sport'";
        schema:publisher                <https://martial.is/entity/01M6BQSYG5G95JWRDX3V4BBGJ4/publisher>;
        schema:url                      <https://www.riss.kr/link?id=T12901672>;
        martialis:accessed              "2026-11-01";
        martialis:earliestYear          2012;
        martialis:hasContributor        <https://martial.is/entity/01M6BQSYG5G95JWRDX3V4BBGJ4/hasContributor/0>;
        martialis:latestYear            2012;
        martialis:sourceClassification  srcclass:authored;
        martialis:sourceGenre           <https://w3id.org/martialis/vocab/source-genre/history>;
        martialis:sourceType            "thesis" .

<https://martial.is/entity/01M3YH7N5GBAJW9BWD1F6WG0CM/hasConfidence>
        rdf:type                       martialis:Confidence;
        prov:wasAttributedTo           <https://martial.is/agent/FSM>;
        martialis:assessedBy           <https://martial.is/agent/FSM>;
        martialis:confidenceLevel      conflevel:confirmed;
        martialis:confidenceRationale  "The 2018 review by judo historian Michel Brousse, drawing on Jean Gailhat's period account, documents that de Herdt was awarded the 4th dan on 6 December 1951, the grade being remitted by Risei Kano, president of the Kodokan; Brousse explicitly debunks the book's claim that ambassador Yotaro Sugimura offered 4th, 5th and 6th dan in the name of the Kodokan" .

