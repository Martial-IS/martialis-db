<https://martial.is/entity/01KZDXQH2M626BV782P1NRPA1N>
        rdf:type                martialis:Style;
        schema:alternateName    "Yamanni-Chinen-ryu"@en;
        schema:alternateName    "Yamane-ryu"@en;
        schema:alternateName    "Yamani-ryu"@en;
        schema:description      "Yamanni-ryu (also Yamanni-Chinen-ryu or Yamane-ryu) is an Okinawan bojutsu\n(staff) style named after Chinen Masami's grandfather Sanra Chinen, known as\nYamani Usumei or Yamane Tanmei. It is a traditional, relatively\nunmodernized weapons style passed down privately; its most prominent\nmodern practitioners were Chogi Kishaba, the only active instructor of the\nstyle in Okinawa, and his student Toshihiro Oshiro, who brought it to the\nUnited States. It is the technical foundation of the Ryukyu Bujutsu Kenkyu\nDoyukai (RBKD).\n"@en;
        schema:keywords         "okinawan-kobudo";
        schema:keywords         "bojutsu";
        schema:keywords         "koryu";
