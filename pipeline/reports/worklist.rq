# Curation worklist: every quality finding, attributed to the record it
# belongs to, so the backlog can be worked record by record.
#
# Runs over export/quality-report.ttl (the SHACL report, regenerated by
# `make quality`) joined to export/data.ttl for names and classes.
#
# A finding on a nested node (a claim, a TeacherInteraction, an evidence
# record) is attributed to its owning record. Every IRI starts with a ULID that
# names a record or a claim (`entity/<ULID>`), and any node below it is
# `<that IRI>/<slot>[/<index>]` (pipeline/scripts/prepare.jq). When that root is
# a record it is the owner; when it is a claim, the owner is the record that
# links to the claim (claims are always direct children of a record), and
# ?node is the claim's ULID plus the path below it. ?node is empty for
# a finding on the record itself. `make review` filters these rows by the
# ULIDs of the changed records.
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX martialis: <https://w3id.org/martialis/ontology#>
PREFIX schema: <https://schema.org/>

# Grouped because a record commonly carries several language-tagged names;
# without it each finding is repeated once per name.
SELECT ?class ?entity (COALESCE(SAMPLE(?en), SAMPLE(?any), "(unnamed)") AS ?name)
       ?node ?severity ?message
WHERE {
  ?r a sh:ValidationResult ;
     sh:focusNode ?focus ;
     sh:resultMessage ?message ;
     sh:resultSeverity ?sev .
  FILTER(isIRI(?focus) && STRSTARTS(STR(?focus), "https://martial.is/entity/"))
  BIND(IRI(REPLACE(STR(?focus), "^(https://martial\\.is/entity/[^/]+).*$", "$1")) AS ?root)
  OPTIONAL {
    FILTER NOT EXISTS {
      VALUES ?recordClass { martialis:Person martialis:Organization martialis:Place martialis:Style
                            martialis:Source martialis:Event martialis:RankingSystem }
      ?root a ?recordClass
    }
    ?owner ?holds ?root .
    FILTER(REGEX(STR(?owner), "^https://martial\\.is/entity/[^/]+$"))
  }
  BIND(COALESCE(?owner, ?root) AS ?entity)
  BIND(IF(BOUND(?owner), STRAFTER(STR(?focus), "https://martial.is/entity/"),
          STRAFTER(STR(?focus), CONCAT(STR(?root), "/"))) AS ?node)
  ?entity a ?cls .
  FILTER(STRSTARTS(STR(?cls), "https://w3id.org/martialis/ontology#"))
  OPTIONAL { ?entity schema:name ?en . FILTER(LANGMATCHES(LANG(?en), "en")) }
  OPTIONAL { ?entity schema:name ?any }
  BIND(STRAFTER(STR(?cls), "ontology#") AS ?class)
  BIND(STRAFTER(STR(?sev), "shacl#") AS ?severity)
}
GROUP BY ?class ?entity ?node ?severity ?message
ORDER BY ?class ?entity ?node ?message
