    schema:domainIncludes martialis:Source .

martialis:droppingParticle a owl:DatatypeProperty ;
    rdfs:label "auslassbarer Namenszusatz"@de,
        "dropping particle"@en,
        "partícula omisible"@es,
        "particule omissible"@fr,
        "forskeyti sem má sleppa"@is,
        "前置詞要素"@ja,
        "partícula omitida"@pt,
        "可省略的姓氏前缀"@zh ;
    rdfs:comment "CSL name-variable dropping-particle: a name part dropped when the name is alphabetized (e.g. 'van' in 'van Beethoven, Ludwig')."@en ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
    rdfs:range xsd:string .

martialis:earliestYear a owl:DatatypeProperty ;
    rdfs:label "frühestes Jahr"@de,
        "earliest year"@en,
        "año más temprano"@es,
        "année au plus tôt"@fr,
        "fyrsta mögulega ár"@is,
        "最早年"@ja,
        "ano mais antigo"@pt,
        "最早年份"@zh ;
    rdfs:comment "Earliest year consistent with a Date value, materialized by pipeline/rules/07-edtf-bounds.ru. Paired with martialis:latestYear for integer date comparisons."@en ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
    rdfs:range xsd:integer ;
    schema:domainIncludes martialis:Event,
        martialis:HonorAssertion,
        martialis:LifeEvent,
        martialis:RankAssertion,
        martialis:Source .

