    rdfs:label "Mitglied von"@de,
        "member of"@en,
        "miembro de"@es,
        "membre de"@fr,
        "félagi í"@is,
        "会員として所属"@ja,
        "membro de"@pt,
        "属于组织"@zh ;
    rdfs:comment "Direct person-to-organization membership edge, materialized at export time from Memberships. Built from every claim not assessed doubtful or refuted: possible, probable or confirmed. Not time-bound: the person was a member at some time. The assertion carries the evidence, the period and the level."@en ;
    rdfs:domain martialis:Person ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
    rdfs:range martialis:Organization ;
    rdfs:subPropertyOf org:memberOf .

martialis:hasMember a owl:ObjectProperty ;
    rdfs:label "hat Mitglied"@de,
        "has member"@en,
        "tiene miembro"@es,
        "a pour membre"@fr,
        "hefur félaga"@is,
        "会員を有する"@ja,
        "tem membro"@pt,
        "拥有成员"@zh ;
    rdfs:comment "Direct organization-to-person membership edge, materialized at export time from Memberships. Built from every claim not assessed doubtful or refuted: possible, probable or confirmed. Not time-bound: the person was a member at some time. The assertion carries the evidence, the period and the level."@en ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
    rdfs:subPropertyOf org:hasMember ;
    owl:inverseOf martialis:memberOf .

martialis:teaches a owl:ObjectProperty ;
    rdfs:label "lehrt"@de,
        "teaches"@en,
        "enseña"@es,
        "enseigne"@fr,
        "kennir"@is,
        "教えた"@ja,
        "ensina"@pt,
        "教授"@zh ;
    rdfs:comment "Direct teacher-to-student edge, materialized at export time from TeacherAssertions. Built from every claim not assessed doubtful or refuted: possible, probable or confirmed. The assertion carries the evidence and the level."@en ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
    owl:inverseOf martialis:wasTaughtBy .

martialis:trainedAt a owl:ObjectProperty ;
    rdfs:label "trainierte an"@de,
        "trained at"@en,
        "entrenó en"@es,
        "s’est entraîné à"@fr,
        "æfði hjá"@is,
        "稽古場所"@ja,
        "treinou em"@pt,
        "习武地点"@zh ;
    rdfs:comment "Materialized from TeacherAssertion interactions, with or without an identified teacher: this person trained at this place at least once. Descriptive only. Built from every claim not assessed doubtful or refuted: possible, probable or confirmed. The assertion carries the evidence and the level."@en ;
    rdfs:domain martialis:Person ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
    rdfs:range martialis:Place .

martialis:transmissionDocument rdfs:label "Überlieferungsdokument"@de,
        "transmission document"@en,
        "documento de transmisión"@es,
        "document de transmission"@fr,
        "miðlunarrit"@is,
        "伝承文書"@ja,
        "documento de transmissão"@pt,
        "传承文献"@zh ;
    rdfs:domain martialis:DocumentTransmissionAssertion ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> .

martialis:validDuring rdfs:label "gültig während"@de,
        "valid during"@en,
        "válido durante"@es,
        "valide pendant"@fr,
        "gildir á tímabilinu"@is,
        "有効期間"@ja,
        "válido durante"@pt,
        "有效期间"@zh ;
    rdfs:domain martialis:Assertion ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> .

martialis:IdentityAssertion rdfs:label "Identitätsaussage"@de,
        "identity assertion"@en,
        "aserción de identidad"@es,
        "assertion d’identité"@fr,
        "fullyrðing um samsemd"@is,
        "同一性アサーション"@ja,
        "asserção de identidade"@pt,
        "身份断言"@zh ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> .

martialis:variantOf a owl:ObjectProperty ;
    rdfs:label "Variante von"@de,
        "variant of"@en,
        "variante de"@es,
        "variante de"@fr,
        "afbrigði af"@is,
        "亜流である"@ja,
        "variante de"@pt,
        "分支自"@zh ;
    vann:example "ex:Shotokan martialis:variantOf ex:Karate . Distinct from derived_from (StyleRelationAssertion), which crosses into a different art rather than naming a school within one."@en ;
    rdfs:comment "This style is a named variant/school within a broader style (e.g. Shotokan variantOf Karate). Materialized from StyleRelationAssertions. Built from every claim not assessed doubtful or refuted: possible, probable or confirmed. The assertion carries the evidence and the level."@en ;
    rdfs:domain martialis:Style ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
    rdfs:range martialis:Style ;
    skos:broadMatch skos:broader .

martialis:wasTaughtBy a owl:ObjectProperty ;
    rdfs:label "wurde unterrichtet von"@de,
        "was taught by"@en,
        "fue alumno de"@es,
        "a été l’élève de"@fr,
        "lærði hjá"@is,
        "師事した"@ja,
        "foi aluno de"@pt,
        "师从"@zh ;
    rdfs:comment "Direct student-to-teacher edge, materialized at export time from TeacherAssertions. Built from every claim not assessed doubtful or refuted: possible, probable or confirmed. The assertion carries the evidence and the level."@en ;
    rdfs:domain martialis:Person ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
    rdfs:range martialis:Person .

martialis:StyleRelationAssertion rdfs:label "Aussage zur Stilbeziehung"@de,
        "style relation assertion"@en,
        "aserción de relación entre estilos"@es,
        "assertion de relation entre styles"@fr,
        "fullyrðing um tengsl stíla"@is,
        "流派関係アサーション"@ja,
        "asserção de relação entre estilos"@pt,
        "流派关系断言"@zh ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> .

martialis:AffiliationAssertion rdfs:label "Zugehörigkeitsaussage"@de,
        "affiliation assertion"@en,
        "aserción de afiliación"@es,
        "assertion d’affiliation"@fr,
        "fullyrðing um aðild"@is,
        "所属関係アサーション"@ja,
        "asserção de afiliação"@pt,
        "隶属关系断言"@zh ;
    vann:example "TIES: <dojo> martialis:hasAffiliationAssertion [ martialis:relatedOrganization <aikikai> ; martialis:affiliationRelation \"recognised_by\" ; martialis:validDuring [ martialis:startYear 1970 ; martialis:endYear 1979 ] ] . GENEALOGY: <newBody> martialis:hasAffiliationAssertion [ martialis:relatedOrganization <oldBody> ; martialis:affiliationRelation \"split_from\" ] ."@en ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> .

martialis:TimeInterval rdfs:label "Zeitintervall"@de,
        "time interval"@en,
        "intervalo temporal"@es,
        "intervalle de temps"@fr,
        "tímabil"@is,
        "期間"@ja,
        "intervalo temporal"@pt,
        "时间区间"@zh ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> .

martialis:Confidence rdfs:label "Vertrauensbewertung"@de,
        "confidence"@en,
        "confianza"@es,
        "confiance"@fr,
        "vissa"@is,
        "信頼度評価"@ja,
        "confiança"@pt,
        "可信度评估"@zh ;
    vann:example "martialis:conf01 a martialis:Confidence ; martialis:confidenceLevel <https://w3id.org/martialis/vocab/confidence-level/probable> ; martialis:confidenceRationale \"Two independent secondary sources agree; no primary document located.\" ; martialis:assessedBy <https://martial.is/agent/JDP> ."@en ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> .

martialis:DocumentTransmissionAssertion rdfs:label "Aussage zur Dokumentüberlieferung"@de,
        "document transmission assertion"@en,
        "aserción de transmisión documental"@es,
        "assertion de transmission documentaire"@fr,
        "fullyrðing um miðlun með riti"@is,
        "文書伝承アサーション"@ja,
        "asserção de transmissão documental"@pt,
        "文献传承断言"@zh ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> .

martialis:TeacherAssertion rdfs:label "Lehreraussage"@de,
        "teacher assertion"@en,
        "aserción de maestro"@es,
        "assertion de professeur"@fr,
        "fullyrðing um kennara"@is,
        "師弟関係アサーション"@ja,
        "asserção de professor"@pt,
        "师徒关系断言"@zh ;
    vann:example "ex:Student martialis:hasTeacherAssertion martialis:assertion01 . martialis:assertion01 a martialis:TeacherAssertion ; martialis:teacher ex:Teacher ; martialis:assertedStyle ex:Shotokan ; martialis:hasInteraction [ a martialis:TeacherInteraction ; martialis:interactionPlace ex:HombuDojo ; martialis:interactionPeriod [ martialis:startYear 1962 ] ; martialis:hasEvidence [ martialis:basedOnSource ex:Interview1989 ; martialis:supports true ] ] ."@en,
        "UNIDENTIFIED TEACHER: ex:Student martialis:hasTeacherAssertion martialis:assertion02 . martialis:assertion02 a martialis:TeacherAssertion ; martialis:assertedStyle ex:Judo ; martialis:hasInteraction [ a martialis:TeacherInteraction ; martialis:interactionPlace ex:Kodokan ; martialis:interactionPeriod [ martialis:startYear 1958 ; martialis:endYear 1959 ] ; martialis:hasEvidence [ martialis:basedOnSource ex:CourseRecord ; martialis:supports true ] ] ."@en ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty martialis:teacher ;
            owl:someValuesFrom martialis:Person ] .

martialis:OfficerRole rdfs:label "Amt"@de,
