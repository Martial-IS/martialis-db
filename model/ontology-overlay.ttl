martialis:changeKind a owl:ObjectProperty ;
    rdfs:label "Art der Änderung"@de,
        "change kind"@en,
        "tipo de cambio"@es,
        "type de changement"@fr,
        "tegund breytingar"@is,
        "変更種別"@ja,
        "tipo de mudança"@pt,
        "变更类型"@zh ;
    rdfs:comment "Which genealogy affiliationRelation produced this event: derived_from, split_from, merged_from, replaces, or renamed_from."@en ;
    rdfs:domain org:ChangeEvent ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
    rdfs:range skos:Concept .

martialis:changeYear a owl:DatatypeProperty ;
    rdfs:label "Jahr der Änderung"@de,
        "change year"@en,
        "año del cambio"@es,
        "année du changement"@fr,
        "ár breytingar"@is,
        "変更年"@ja,
        "ano da mudança"@pt,
        "变更年份"@zh ;
    rdfs:comment "The startYear of the underlying AffiliationAssertion's validDuring period, copied onto the event node."@en ;
    rdfs:domain org:ChangeEvent ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
    rdfs:range xsd:integer .

