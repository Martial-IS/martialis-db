        "doi"@en,
        "doi"@es,
        "doi"@fr,
        "doi"@is,
        "DOI"@ja,
        "doi"@pt,
        "DOI"@zh ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
