martialis:Source rdfs:label "Quelle"@de,
        "source"@en,
        "fuente"@es,
        "source"@fr,
        "heimild"@is,
        "資料"@ja,
        "fonte"@pt,
        "来源"@zh ;
    vann:example "An article in a journal: <article> a martialis:Source ; martialis:sourceType \"article\" ; martialis:partOf <journal> ; bibo:volume \"12\" ; bibo:pages \"42-60\" . An edition: <edition2001> martialis:editionOf [ martialis:editionOfSource <work1908> ; martialis:editionRelationType editrel:translation ] ."@en ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> .

<https://w3id.org/martialis/ontology> a owl:Ontology ;
    dcterms:bibliographicCitation "Muñoz, F. (2026). Martialis Investigative Ontology (Version 1.0.0). Zenodo. https://doi.org/10.5281/zenodo.23951128" ;
    dcterms:conformsTo <http://www.w3.org/ns/owl-profile/DL> ;
    dcterms:created "2026-02-28"^^xsd:date ;
    dcterms:creator <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:description "Ontology for historically sourced martial arts lineages, ranks, and claims. SHACL (martialis.shacl.ttl, martialis-quality.shacl.ttl) is the constraint layer; this file describes the vocabulary."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:identifier "https://doi.org/10.5281/zenodo.23951128" ;
    dcterms:issued "2026-11-05"^^xsd:date ;
    dcterms:modified "2026-11-05"^^xsd:date ;
    dcterms:publisher <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:rightsHolder <https://orcid.org/0009-0000-9488-3542> ;
    dcterms:title "Martialis Investigative Ontology"@en ;
    mod:status <http://purl.org/ontology/bibo/status/published> ;
    vann:preferredNamespacePrefix "martialis" ;
    vann:preferredNamespaceUri martialis: ;
    rdfs:seeAlso <https://martial.is/model>,
        <https://w3id.org/martialis/ontology/shapes/quality>,
        <https://w3id.org/martialis/ontology/shapes/structural>,
        <https://w3id.org/martialis/vocab> ;
    owl:imports <https://w3id.org/martialis/ontology/alignments/evidence>,
        <https://w3id.org/martialis/ontology/alignments/maon>,
        <https://w3id.org/martialis/ontology/imports/bibo>,
        <https://w3id.org/martialis/ontology/imports/org>,
        <https://w3id.org/martialis/ontology/imports/prov> ;
    owl:versionIRI <https://w3id.org/martialis/ontology/1.0.0> ;
    owl:versionInfo "1.0.0" ;
    foaf:logo <https://martial.is/static/images/circle_inv.png> ;
    schema:codeRepository <https://github.com/Martial-IS/martialis-db> .

[] a owl:AllDisjointClasses ;
    owl:members ( martialis:TeacherAssertion martialis:RankAssertion martialis:HonorAssertion martialis:StyleRelationAssertion martialis:DocumentTransmissionAssertion martialis:IdentityAssertion martialis:HistoricityAssertion martialis:AffiliationAssertion martialis:Participation martialis:InstructorRole martialis:OfficerRole martialis:Membership ) .

[] a owl:AllDisjointClasses ;
    owl:members ( martialis:Person martialis:Organization martialis:Style martialis:RankingSystem martialis:Place martialis:Source martialis:Event martialis:LifeEvent martialis:TimeInterval martialis:Assertion martialis:Confidence martialis:SourceAssertionRelation martialis:TeacherInteraction martialis:Site ) .

<https://orcid.org/0009-0000-9488-3542> a schema:Person ;
    schema:name "Frederico Muñoz" ;
    schema:email <mailto:fsm@martial.is> .

# Reused external terms
#################################################################
#
# The ontology targets OWL 2 DL, which needs every term it uses declared with
# exactly one role. The published file declares every term it mentions, so it
# parses the same with or without its imports; axioms about a reused term come
# only from its import. PROV-O, ORG and BIBO declarations are copied by `make
# model` from their import modules (ontology/imports/*-module.ttl); every other
# reused term is declared here (the MIREOT practice) instead of importing its
# whole vocabulary, because no upstream DCTERMS, SKOS or schema.org file is
# itself OWL 2 DL. The role is the one this ontology uses the term in. `make
# reasoner` fails on a missing or conflicting declaration.

dcterms:bibliographicCitation a owl:AnnotationProperty .
dcterms:conformsTo a owl:AnnotationProperty .
dcterms:created a owl:AnnotationProperty .
dcterms:creator a owl:AnnotationProperty .
dcterms:description a owl:AnnotationProperty .
dcterms:identifier a owl:AnnotationProperty .
dcterms:license a owl:AnnotationProperty .
dcterms:issued a owl:AnnotationProperty .
dcterms:modified a owl:AnnotationProperty .
dcterms:publisher a owl:AnnotationProperty .
dcterms:rightsHolder a owl:AnnotationProperty .
dcterms:title a owl:AnnotationProperty .
foaf:logo a owl:AnnotationProperty .
mod:status a owl:AnnotationProperty .
schema:codeRepository a owl:AnnotationProperty .
schema:domainIncludes a owl:AnnotationProperty .
schema:rangeIncludes a owl:AnnotationProperty .
skos:broadMatch a owl:AnnotationProperty .
