martialis:TraditionOnlyAssertion a owl:Class ;
    rdfs:label "nur überlieferte Aussage"@de,
        "tradition-only assertion"@en,
        "aserción solo por tradición"@es,
        "assertion fondée sur la seule tradition"@fr,
        "fullyrðing byggð á hefð einni"@is,
        "伝承のみのアサーション"@ja,
        "asserção apenas por tradição"@pt,
        "仅凭传承的断言"@zh ;
    rdfs:comment "Materialized at export time: an Assertion whose every supporting evidence record cites a Source marked martialis:lineageTradition true. The claim rests only on the lineage's own recount of its past: its sources share one origin and cannot corroborate each other, so it is not confirmed unless the granting body records its own grant."@en ;
    rdfs:subClassOf martialis:Assertion ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> .

martialis:sourceType rdfs:label "Quellentyp"@de,
        "source type"@en,
        "tipo de fuente"@es,
        "type de source"@fr,
        "tegund heimildar"@is,
        "資料種別"@ja,
        "tipo de fonte"@pt,
        "来源类型"@zh ;
    dcterms:conformsTo <https://docs.citationstyles.org/en/stable/specification.html#appendix-iii-types> ;
    rdfs:domain martialis:Source ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> .

martialis:specializationOf rdfs:label "Spezialisierung von"@de,
        "specialization of"@en,
        "especialización de"@es,
        "spécialisation de"@fr,
        "sérhæfing á"@is,
        "特定時点の版"@ja,
        "especialização de"@pt,
        "特定版本所属"@zh ;
    rdfs:domain martialis:Source ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> ;
    rdfs:range martialis:Source ;
    rdfs:seeAlso <https://www.rfc-editor.org/rfc/rfc7089> ;
    skos:closeMatch prov:specializationOf ;
    skos:scopeNote "Not containment (martialis:partOf) and not an edition (martialis:editionOf). In Memento terms (RFC 7089) the resource is the URI-R and each state records its URI-M as schema:archivedAt, with martialis:archiveDate as the Memento-Datetime."@en .

