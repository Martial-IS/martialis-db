martialis:gradeOrdinal a owl:DatatypeProperty ;
    rdfs:label "Ordnungszahl des Grades"@de,
        "grade ordinal"@en,
        "ordinal del grado"@es,
        "rang du grade"@fr,
        "raðtala gráðu"@is,
        "級位順序"@ja,
        "ordem do grau"@pt,
        "级位序数"@zh ;
    rdfs:comment "A sort key on a skos:Concept within an ordered scheme (a grade ladder, ascending = more senior; the confidence scale, ascending = more certain); SKOS has no native ordinal-successor relation."@en ;
