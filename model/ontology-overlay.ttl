    vann:example "A birth recorded in a lunisolar source: schema:startDate \"1868-10-15\" ; martialis:dateOriginal \"Meiji 1, 9th month\" ; martialis:dateCalendar \"japanese-lunisolar\" ; martialis:earliestYear \"1868\" ; martialis:latestYear \"1868\" ."@en ;
