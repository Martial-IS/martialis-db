        "aserción de historicidad"@es,
        "assertion d’historicité"@fr,
        "fullyrðing um tilvist"@is,
        "実在性アサーション"@ja,
        "asserção de historicidade"@pt,
        "历史真实性断言"@zh ;
    rdfs:isDefinedBy <https://w3id.org/martialis/ontology> .

martialis:RankAssertion rdfs:label "Graduierungsaussage"@de,
